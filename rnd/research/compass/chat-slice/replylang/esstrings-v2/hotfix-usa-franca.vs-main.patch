@@ -0,0 +1,11 @@
+import { describe, expect, it } from "vitest";
+import { emergencyNumbersLine } from "./emergencyNumbers";
+
+// Hotfix 2026-10-03 (Compass, from the Opus reviewer of esstrings-v2): the shipped aliases matched PT/ES verbs and adjectives.
+// Dev item ed-pt-105 (live flood in Petrópolis, "minha mae q usa andador") got "Estados Unidos: 911".
+describe("emergency-number aliases: 'usa' and 'franca' are words, not countries", () => {
+  it.each(["minha mae q usa andador", "mi papá usa marcapasos y se desmayó", "qué se usa para una quemadura", "Usa insulina y está confundido", "hemorragia franca", "moro em Franca"])(
+    "no country line: %s", (t) => expect(emergencyNumbersLine(t, true)).toBeNull());
+  it.each(["estamos en Estados Unidos", "we're in the USA", "nos EUA", "in the U.S. now", "united states"])("US: %s", (t) => expect(emergencyNumbersLine(t, false)).toMatch(/United States: 911/));
+  it.each(["estou na França", "in France", "FRANCE"])("France: %s", (t) => expect(emergencyNumbersLine(t, false)).toMatch(/France: 112/));
+});
