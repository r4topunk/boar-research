+++ b/src/routing/classifyEs.test.ts
@@ -0,0 +1,43 @@
+import { describe, expect, it } from "vitest";
+import { classifyTask, hasSpanishEvidence } from "./classify";
+
+// Compass, chat-v3 follow-up: ES questions were all "chat" (no ES patterns; a leading ¿ defeated the anchored ones), so an
+// uncited ES knowledge answer got no "not from an offline source" line and the 1.5B searched ES meta questions.
+describe("classifyTask: Spanish", () => {
+  it("knowledge questions get the same task types as their PT/EN twins", () => {
+    expect(classifyTask("¿Por qué se eligió Canberra como capital de Australia?")).toBe("research");
+    expect(classifyTask("¿Cómo funciona un torniquete?")).toBe("research");
+    expect(classifyTask("¿Qué es el Camino de Santiago?")).toBe("lookup");
+    expect(classifyTask("¿Cuál es la capital de Bolivia?")).toBe("lookup");
+    expect(classifyTask("diferencia entre infarto y paro cardiaco")).toBe("compare");
+    expect(classifyTask("¿Es seguro nadar en Tulum en julio?")).toBe("lookup");
+    expect(classifyTask("¿Hay que dar propina en Madrid?")).toBe("lookup");
+  });
+  it("questions to the assistant and ES small talk are conversation", () => {
+    for (const q of ["¿quién eres?", "¿Quién te programó?", "qué onda boar", "¿qué tal?", "¿eres una IA?", "¿cómo te llamas?"]) expect(classifyTask(q), q).toBe("conversation");
+  });
+  it("ES how-are-you small talk (tú/vos/usted) is conversation, not a knowledge question; real questions are not", () => {
+    for (const q of ["¿Cómo estás?", "como estas", "¿Cómo está usted?", "¿cómo andás?", "¿cómo te va?", "¿qué haces?", "que tal todo", "¿qué cuentas?", "¿todo bien?", "¿qué más?", "¿qué hubo?", "¿cómo amaneciste?"])
+      expect(classifyTask(q), q).toBe("conversation");
+    expect(classifyTask("¿Cómo está el clima en Lima en julio?")).toBe("research");
+    expect(classifyTask("¿Qué hay para hacer en Cusco?")).toBe("lookup");
+    expect(classifyTask("¿Qué haces cuando te pica una medusa?")).toBe("lookup");
+    expect(classifyTask("como vai?")).toBe("research");
+  });
+  it("PT and EN are unchanged", () => {
+    expect(classifyTask("Por que existem as estações do ano?")).toBe("research");
+    expect(classifyTask("Who won the 2014 World Cup?")).toBe("lookup");
+    expect(classifyTask("o que é a fotossíntese?")).toBe("lookup");
+    expect(classifyTask("tudo bem?")).not.toBe("conversation");
+  });
+});
+
+describe("estask3: hasSpanishEvidence (the classifier's ES rules, reused for the ES fixed strings)", () => {
+  it("ES without ¿ or accents still counts", () => {
+    for (const q of ["qué es la fotosíntesis", "que es el camino de santiago", "cual es la capital de bolivia", "¿Es seguro nadar en Tulum?", "diferencia entre infarto y paro cardiaco", "¿quién eres?"])
+      expect(hasSpanishEvidence(q), q).toBe(true);
+  });
+  it("EN never; PT may match (callers keep PT precedence)", () => {
+    for (const q of ["What is photosynthesis?", "Who won the 2014 World Cup?", "how does a monsoon work?"]) expect(hasSpanishEvidence(q), q).toBe(false);
+  });
+});
