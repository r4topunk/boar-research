+
+/**
+ * estask3 (Compass, after the estask2 L1 KILL: "qué es la fotosíntesis", no ¿, took the ES lookup path but got the EN
+ * preface/decline because isSpanishQuestion needs ¿/¡ or 3 ES-only words). True when the classifier's own ES rules match.
+ * Callers combine it with !isPortugueseQuery (PT keeps precedence): "como"/"por que" also match Portuguese.
+ */
+export function hasSpanishEvidence(query: string): boolean {
+  const t = query.trim();
+  return CONVERSATION_ES_RE.test(t) || ES_COMPARE_RE.test(t) || ES_RESEARCH_RE.test(t) || ES_LOOKUP_RE.test(t) || YES_NO_ES.test(t);
+}
