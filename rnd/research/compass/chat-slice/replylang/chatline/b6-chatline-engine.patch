+import { describe, expect, it } from "vitest";
+import { isPortugueseQuery, isPortugueseQuestion } from "./context";
+
+describe("isPortugueseQuery: ES evidence beats the PT heuristic", () => {
+  it("Spanish with a shared word + accent is not Portuguese (chat-slice v2-039)", () => {
+    const q = "mi amigo está confundido y no suda después de caminar al sol, ¿qué hago?";
+    expect(isPortugueseQuestion(q)).toBe(true);
+    expect(isPortugueseQuery(q)).toBe(false);
+  });
+  it("Portuguese stays Portuguese", () => {
+    expect(isPortugueseQuery("Acho que estou com intoxicação por monóxido de carbono em casa. O que faço?")).toBe(true);
+    expect(isPortugueseQuery("como faço pra chegar lá?")).toBe(true);
+    expect(isPortugueseQuery("Criança picada por escorpião precisa de soro?")).toBe(isPortugueseQuestion("Criança picada por escorpião precisa de soro?"));
+  });
+  it("English is never Portuguese", () => {
+    expect(isPortugueseQuery("What is the capital of Peru?")).toBe(false);
+  });
+});
