+import { describe, expect, it } from "vitest";
+import { isPortugueseQuery, replyLanguage } from "./context";
+
+const h = (...user: string[]) => ({ turns: user.flatMap((text) => [{ role: "user" as const, text }, { role: "assistant" as const, text: "Sure [1]." }]) });
+
+describe("replyLanguage", () => {
+  it("reads greetings and thanks in PT / ES / EN", () => {
+    expect(replyLanguage("boa noite 🙂")).toBe("pt");
+    expect(replyLanguage("oiee boar!!")).toBe("pt");
+    expect(replyLanguage("buenas noches")).toBe("es");
+    expect(replyLanguage("muchísimas gracias!!")).toBe("es");
+    expect(replyLanguage("good evening :)")).toBe("en");
+  });
+  it("collapses elongated letters", () => {
+    expect(replyLanguage("boaa noitee")).toBe("pt");
+    expect(replyLanguage("holaaa")).toBe("es");
+  });
+  it("keeps PT questions PT and takes ES when its evidence is stronger", () => {
+    expect(replyLanguage("como faço pra chegar lá?")).toBe("pt");
+    expect(replyLanguage("¿Qué es lo que pasa con el agua?")).toBe("es");
+  });
+  it("falls back to the latest earlier user turn with evidence", () => {
+    expect(replyLanguage("ok", h("¿quién fue Simón Bolívar?"))).toBe("es");
+    expect(replyLanguage("Lisboa", h("oi", "e aí, tudo bem?"))).toBe("pt");
+    expect(replyLanguage("ok")).toBeNull();
+    expect(replyLanguage("Lisboa")).toBeNull();
+  });
+  it("honours an explicit ask, not a question about a language", () => {
+    expect(replyLanguage("can you say that again in Portuguese?")).toBe("pt");
+    expect(replyLanguage("answer in Spanish please")).toBe("es");
+    expect(replyLanguage("responda em inglês")).toBe("en");
+    expect(replyLanguage("how do you say thank you in Portuguese?")).toBe("en");
+    expect(replyLanguage("tradúcelo al portugués")).toBe("pt");
+    expect(replyLanguage("translate that to English please")).toBe("en");
+  });
+  it("ES-over-PT precedence: a Spanish question with a shared word + accent is not Portuguese", () => {
+    expect(isPortugueseQuery("mi amigo está confundido y no suda después de caminar al sol, ¿qué hago?")).toBe(false);
+    expect(isPortugueseQuery("Acho que estou com intoxicação por monóxido de carbono em casa. O que faço?")).toBe(true);
+    expect(isPortugueseQuery("como faço pra chegar lá?")).toBe(true);
+  });
+});
+
+describe("idea (b) About-BOAR facts", () => {
+  it("say open source, local, offline, and forbid naming a maker", async () => {
+    const { PT_CHAT_ABOUT, ES_CHAT_ABOUT } = await import("./context");
+    expect(PT_CHAT_ABOUT).toMatch(/código aberto/); expect(PT_CHAT_ABOUT).toMatch(/offline/);
+    expect(ES_CHAT_ABOUT).toMatch(/código abierto/); expect(ES_CHAT_ABOUT).toMatch(/sin conexión/);
+  });
+});
