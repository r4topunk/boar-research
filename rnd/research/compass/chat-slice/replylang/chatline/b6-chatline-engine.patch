+++ b/src/routing/context.ts
@@ -830,6 +830,78 @@ export const PT_ANSWER_LANGUAGE_NO_SOURCES = "Responda em português do Brasil."
 
 export const PT_QUESTION = /\b(como|o que|quando|onde|qual|quais|por que|porque|devo|fazer|posso|existe|quem|quanto)\b/i;
 
+/** Reply language for the language line (Compass, chat-slice lang_match: 14/64 replies came back in English to PT/ES
+ * users, mostly greetings, and there was no ES line at all). Distinct function words + greetings + spelling per
+ * language; a PT question by isPortugueseQuestion stays PT unless the ES evidence is stronger. A message with no
+ * evidence ("ok", "Lisboa") takes the latest earlier user turn that has some. Chat slang (eae, brigado, vlw, kkk; saludos,
+ * jaja) added from dev items v2-001, v2-005, v2-057, v2-020 (fast-loop rule 3). null = no evidence: no line (as before);
+ * "en" also gets no line, so English prompts are unchanged. */
+export type ReplyLanguage = "pt" | "es" | "en";
+const RL_WORDS: Record<ReplyLanguage, RegExp> = {
+  pt: /(?<![\p{L}])(não|você|vc|é|são|um|uma|os|dos|das|em|na|nas|nos|com|mas|também|isso|essa|esse|eu|ele|ela|seu|sua|ao|pela|pelo|nem|já|há|foi|ou|tem|quer|posso|pode|obrigad[oa]|obrigadão|valeu|olá|oi+e*|tudo|bem|td|sim|muito|beleza|tchau|fala|salve|noite|dia|tarde|bom|boa|aí|eai|eae|brigad[oa]|vlw|blz|tmj|falou|kk+|até|onde|quando|qual|quais|quem|quanto|como)(?![\p{L}])/giu,
+  es: /(?<![\p{L}])(el|los|las|del|al|en|con|una|unos|unas|es|y|pero|más|también|eso|esa|ese|yo|él|ella|su|sus|lo|le|les|hay|fue|son|tiene|puedo|puedes|gracias|muchas|muchísimas|hola+|sí|muy|nada|qué|cómo|cuál|cuáles|dónde|cuándo|quién|cuánto|hasta|desde|usted|tú|buenas|buenos|buen|noches|días|necesitas|adiós|chau|oye|onda|andas|nos|vemos|luego|saludos|jaja+)(?![\p{L}])/giu,
+  en: /(?<![\p{L}])(the|and|is|are|was|of|to|in|on|for|with|it|this|that|you|your|i|i'm|can|how|what|which|who|hi|hello|hey|hiya|yo|sup|thanks|thank|thx|morning|evening|bye|good|yes|please|sure|great|cool|cheers|lol|there|going)(?![\p{L}])/giu,
+};
+const RL_SPELLING: Record<"pt" | "es", RegExp> = { pt: /ção|ções|[ãõç]/giu, es: /ción|ciones|[ñ¿¡]/giu };
+
+function replyLanguageOf(text: string): ReplyLanguage | null {
+  const t = text.toLowerCase();
+  const n = (l: ReplyLanguage) => (t.match(RL_WORDS[l])?.length ?? 0) + (l === "en" ? 0 : t.match(RL_SPELLING[l])?.length ?? 0);
+  const score = { pt: n("pt"), es: n("es"), en: n("en") };
+  if (isPortugueseQuestion(text) && score.es <= score.pt) return "pt";
+  const ranked = (Object.keys(score) as ReplyLanguage[]).sort((a, b) => score[b] - score[a]);
+  return score[ranked[0]] > score[ranked[1]] ? ranked[0] : null;
+}
+
+/** An explicit ask wins: "say that again in Portuguese", "em inglês", "en español". */
+// A reply-language verb ("answer in", "responda em", "habla en"), or a redo verb on the previous answer ("say that
+// again in", "dilo en"); "how do you say thank you in Portuguese?" is a question about Portuguese, not an ask.
+const RL_REPLY = String.raw`(?:answer|reply|respond|responda|responde|fala|fale|habla|hable)\b[^.?!]{0,30}`;
+const RL_REDO = String.raw`(?:say|write|repeat|put|tell|explain|translate|diga|escrev\w*|escrib\w*|repet\w*|repit\w*|traduz\w*|traduc\w*|expli\w*)\b[^.?!]{0,15}\b(?:that|it|this|again|isso|isto|de\s+novo|eso|esto|otra\s+vez)\b[^.?!]{0,15}|dilo\b[^.?!]{0,15}`;
+// A translate verb on its own also asks for the language ("tradúcelo al portugués", "translate to English"; dev v2-040).
+const RL_TRANSLATE = String.raw`(?:translate|trad[uú][cz])[\p{L}]*\b[^.?!]{0,15}`;
+const rlAsk = (names: string) => new RegExp(String.raw`\b(?:${RL_REPLY}|${RL_REDO}|${RL_TRANSLATE})\b(?:in|into|to|em|en|al|ao|para\s+(?:o|el))\s+(?:${names})(?![\p{L}])`, "iu");
+const RL_ASKED: [ReplyLanguage, RegExp][] = [
+  ["pt", rlAsk("portuguese|portugu[êeé]s")],
+  ["es", rlAsk("spanish|espanhol|español|espanol|castellano")],
+  ["en", rlAsk("english|ingl[êeé]s")],
+];
+
+export function replyLanguage(query: string, history?: { turns?: { role: string; text: string }[] | null } | null): ReplyLanguage | null {
+  const asked = RL_ASKED.find(([, re]) => re.test(query));
+  if (asked) return asked[0];
+  // Elongated chat ("boaa noitee", "holaaa"): retried with repeated letters collapsed.
+  const own = replyLanguageOf(query) ?? replyLanguageOf(query.replace(/(\p{L})\1+/gu, "$1"));
+  if (own) return own;
+  const users = (history?.turns ?? []).filter((t) => t.role === "user");
+  for (let i = users.length - 1; i >= 0; i--) {
+    const l = replyLanguageOf(users[i].text);
+    if (l) return l;
+  }
+  return null;
+}
+
+/** ES-over-PT precedence (Compass, chat-slice v2-039): isPortugueseQuestion() alone says true for Spanish with a shared
+ * word plus an accent ("mi amigo está confundido y no suda…"), which made the engine answer Spanish users in
+ * Portuguese. A question counts as Portuguese only if the Spanish evidence isn't stronger. */
+export function isPortugueseQuery(query: string): boolean {
+  return isPortugueseQuestion(query) && replyLanguageOf(query) !== "es";
+}
+
+/** Idea (b), chat-only language line: on answers the engine did NOT search for (greetings, meta, small talk), a PT/ES
+ * user gets the language line together with the About-BOAR facts (About screen: open source, local model, offline,
+ * no cloud), because the first stacked run produced false self-claims ("creado por Anthropic", chat-slice v2-028).
+ * Wording needs r4to's sign-off. */
+export const PT_CHAT_ABOUT =
+  "Sobre você: o BOAR é um app de código aberto que roda um modelo de IA local neste celular, offline e sem nuvem. Não diga que foi criado por uma empresa específica.";
+export const ES_CHAT_ABOUT =
+  "Sobre ti: BOAR es una app de código abierto que ejecuta un modelo de IA local en este teléfono, sin conexión y sin nube. No digas que te creó una empresa concreta.";
+
+/** The ES twins of the PT lines (same wording and the same citation example). */
+export const ES_ANSWER_LANGUAGE =
+  "Responde en español, aunque las fuentes estén en inglés, y cita cada afirmación con el número de la fuente, como [1].";
+export const ES_ANSWER_LANGUAGE_NO_SOURCES = "Responde en español.";
+
 /** Longest health excerpt shown as the answer (about 120 words). */
 export const HEALTH_EXTRACT_MAX_CHARS = 700;
 
