+            const chatNoSearch = !health && !plan.retrieve && sources.length === 0;
+            if (!chatNoSearch) return [];
+            const lang = replyLanguage(req.query, ctx.history) ?? (pt ? "pt" : null);
+            if (lang === "pt") return [pt ? undefined : PT_ANSWER_LANGUAGE_NO_SOURCES, PT_CHAT_ABOUT];
+            if (lang === "es") return [ES_ANSWER_LANGUAGE_NO_SOURCES, ES_CHAT_ABOUT];
+            return [];
+          })(),
         ]
           .filter(Boolean)
           .join("\n") || undefined;
