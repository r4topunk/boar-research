+import { describe, expect, it } from "vitest";
+import { premiseGuard } from "./premiseGuard";
+
+describe("premiseGuard (EN)", () => {
+  const grima = "Why does Gríma kill Saruman in The Lord of the Rings?";
+  it("withholds an answer whose thesis denies the premise (V-exact vit-hum-004)", () => {
+    expect(premiseGuard(grima, "Gríma Wormtongue does not kill Saruman in *The Lord of the Rings*. Saruman is killed by a group of Rohan soldiers.")).toEqual({ action: "decline" });
+  });
+  it("drops a denied clause and keeps the rest (vit-hum-002)", () => {
+    const r = premiseGuard(
+      "How did Mozi's idea of universal love differ from the Confucian view, and how did Mencius attack it?",
+      "Mozi's universal love advocated equal care for all. Mencius did not directly attack Mozi's idea, but criticized its feasibility. There is no historical evidence that Mencius specifically attacked Mozi's philosophy."
+    );
+    expect(r).toEqual({ action: "edit", text: "Mozi's universal love advocated equal care for all. Mencius criticized its feasibility." });
+  });
+  it("leaves affirming answers, myth corrections, hypotheticals and how-to questions alone", () => {
+    expect(premiseGuard(grima, "Gríma kills Saruman after Saruman mocks and kicks him on the doorstep of Bag End.")).toBeNull();
+    expect(premiseGuard("Why did Einstein fail math in school?", "Einstein did not fail math; this is a common myth. He excelled at it.")).toBeNull();
+    expect(premiseGuard("How would Mozi answer the critique that universal love is self-defeating?", "Mozi would argue that universal love is not self-defeating.")).toBeNull();
+    expect(premiseGuard("How do I stop my generator from stalling?", "It does not stall if the choke is set.")).toBeNull();
+  });
+});
