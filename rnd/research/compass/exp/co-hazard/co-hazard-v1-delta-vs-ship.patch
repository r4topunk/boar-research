@@ -0,0 +1,52 @@
+import { describe, expect, it } from "vitest";
+import { coHazardAnswer, isCoHazardQuestion } from "./coHazard";
+
+describe("isCoHazardQuestion (EN)", () => {
+  it("fires on a fuel-burning device in an enclosed or attached space", () => {
+    for (const q of [
+      "Can I run my portable generator in the attached garage if I keep the door open?",
+      "is it ok to use a charcoal grill inside the tent if it's raining",
+      "We're camping and it's freezing. Can we bring the propane heater into the camper overnight?",
+      "Can I use my Mr. Heater in the basement while I work?",
+      "Is it safe to use a camping stove inside the tent to cook?",
+      "Power's out. Can I run the generator in the basement with a window cracked?",
+      "Can I warm up my car in the garage with the door closed for a few minutes?",
+      "Is it safe to use the gas oven to heat the apartment during the outage?",
+      "Can I use a disposable bbq in my tent if I leave the flap open?",
+      "Can we run a kerosene heater in our ice fishing shack?",
+      "I have a generator. Can I keep it running in the shed during the storm?",
+      "Can I put the generator in the carport?",
+      "Running a pressure washer in an enclosed porch, is that ok?",
+    ])
+      expect(isCoHazardQuestion(q), q).toBe(true);
+  });
+
+  it("stays out of symptoms, alarms, electric devices, figurative and non-space mentions", () => {
+    for (const q of [
+      "We ran the generator in the garage and now we all have headaches",
+      "The CO alarm is beeping in the basement, what do I do?",
+      "Can I use an electric heater in the tent?",
+      "Can I use my grill in the apartment?",
+      "Write a random number generator inside a function in Python",
+      "Best charcoal drawing techniques indoors",
+      "How many watts does a generator need to run a fridge?",
+      "What is a static site generator?",
+      "Where can I buy activated charcoal inside the airport?",
+      "Is it safe to run a portable generator in the rain?",
+      "Garage sale tips: how do I price an old generator?",
+      "How do I cook rice on a gas stove?",
+      "Is it safe to sleep in a tent in bear country?",
+    ])
+      expect(isCoHazardQuestion(q), q).toBe(false);
+  });
+});
+
+describe("coHazardAnswer", () => {
+  it("leads with No. on a yes/no planning question only, and ends with sources and the emergency line", () => {
+    const yesNo = coHazardAnswer("Can I run my generator in the garage?");
+    expect(yesNo).toMatch(/^No\. Carbon monoxide/);
+    expect(yesNo).toMatch(/Sources: CDC/);
+    expect(yesNo).toMatch(/emergency/i);
+    expect(coHazardAnswer("Where should I put the generator, garage or outside?")).toMatch(/^Carbon monoxide/);
+  });
+});
diff --git a/src/routing/coHazard.ts b/src/routing/coHazard.ts
new file mode 100644
index 0000000..17fbcd5
--- /dev/null
+++ b/src/routing/coHazard.ts
@@ -0,0 +1,119 @@
+// CO hazard (Compass 2026-10-03, ship L3 safety finding): "Can I run my portable generator in the attached garage if I keep
+// the door open?" took the model path and got "Yes, … ensure it's well-ventilated". A planning question about a
+// fuel-burning device in an enclosed or attached space now gets a fixed safety-fact answer, before any model.
+// English only (bounty scope). Symptom or alarm questions are left to the health route (the reviewed CO card).
+// Sources (verbatim, compass/exp/co-hazard/SOURCES.md): CDC "What to Do to Protect Yourself During a Power Outage";
+// US CPSC "Generators and Engine-Driven Tools"; NHS "Carbon monoxide poisoning".
+import { emergencyLine } from "./context";
+import { emergencyNumbersLine } from "./emergencyNumbers";
+
+const B = "(?<![\\p{L}\\p{N}_])";
+const E = "(?![\\p{L}\\p{N}_])";
+const re = (s: string) => new RegExp(s, "iu");
+
+/** A device that burns fuel. A plain "grill", "stove" or "heater" may be electric, so those need a fuel word. */
+const DEVICE = re(
+  [
+    `${B}(?<!(?:random|number|code|site|password|static|image|text|qr|name|idea|key|signal|function|pulse|lorem|tone|wave|pdf|report|hash|ai|music|art|map|meme|solar|battery|jackery|ecoflow|bluetti)[ -])(?:generators?|gennys?|gennies)${E}`,
+    `${B}(?<!activated )charcoal${E}(?! (?:drawing|pencil|filter|tablet|pill|capsule|mask|soap|toothpaste|grey|gray|colou?r|sketch|powder|supplement))`,
+    `${B}(?:bbqs?|barbecues?|hibachis?)${E}`,
+    `${B}(?:a|the|our|my|your) barbie${E}`,
+    `${B}(?:gas|propane|charcoal|pellet|wood|camping|camp|portable gas|disposable) (?:grills?|smokers?)${E}`,
+    `${B}(?:propane|kerosene|paraffin|butane|gas|diesel|oil|fuel|fuel-burning|camping|buddy|patio|catalytic|outdoor)(?: [\\p{L}-]+)? heaters?${E}`,
+    `${B}(?:big|little) buddy${E}`,
+    `${B}mr\\.? heater${E}`,
+    `${B}(?:camping|camp|butane|propane|backpacking|coleman|primus|portable gas|canister|gas canister) (?:stoves?|burners?)${E}`,
+    `${B}(?:propane|gas|kerosene|paraffin|butane|coleman) lanterns?${E}`,
+    `${B}(?:gas|gasoline|petrol)[- ]powered${E}`,
+    `${B}(?:pressure|power) washers?${E}`,
+    `${B}(?:gas|gasoline|petrol) (?:leaf blowers?|blowers?|lawn ?mowers?|mowers?|chainsaws?|engines?|tools?|trimmers?|augers?)${E}`,
+  ].join("|")
+);
+
+/** Using a gas oven or range to heat the home (CDC). */
+const OVEN_HEAT = re(`${B}(?:gas )?(?:oven|stove|range)${E}.{0,40}${B}(?:to|for) (?:heat|warm)`);
+
+/** An engine left running where the exhaust stays (CDC, NHS): a car warming up in the garage. */
+const ENGINE = re(
+  `${B}(?:car|truck|vehicle|engine|motor|motorcycle|motorbike|lawn ?mower|mower|chainsaw|snow ?blower|leaf blower|atv|quad|van|suv)s?${E}.{0,40}${B}(?:running|run|idle|idling|on|warm(?:ing)? up|start(?:ed|ing)?)${E}` +
+    `|${B}(?:run|running|idle|idling|warm(?:ing)? up|leave|start)${E}.{0,25}${B}(?:car|truck|vehicle|engine|motor|motorcycle|motorbike|lawn ?mower|mower|snow ?blower|suv)s?${E}`
+);
+
+/** Generator placement near an opening ("is 10 ft from the back door ok?"): the 20-foot rule. */
+const PLACEMENT = re(
+  `${B}(?:generators?|gennys?)${E}.{0,80}${B}(?:how far|distance|gap|enough|far enough|minimum|close|ok|okay|safe|\\d+ ?(?:ft|feet|foot|m|metres|meters))${E}.{0,60}${B}(?:windows?|doors?|vents?|intakes?)${E}` +
+    `|${B}(?:how far|distance|gap|minimum|\\d+ ?(?:ft|feet|foot|m|metres|meters))${E}.{0,60}${B}(?:windows?|doors?|vents?|intakes?)${E}.{0,60}${B}(?:generators?|gennys?)${E}` +
+    `|${B}(?:how far|distance|gap|minimum)${E}.{0,40}${B}(?:generators?|gennys?)${E}.{0,60}${B}(?:windows?|doors?|vents?|intakes?)${E}` +
+    `|${B}(?:is|are) \\d+ ?(?:ft|feet|foot|m|metres|meters)${E}.{0,40}${B}(?:windows?|doors?|vents?)${E}`
+);
+/** Distances the message states, in feet. Every one at 20 ft (6 m) or more: the generator is already placed right. */
+function statedFeet(q: string): number[] {
+  return [...q.matchAll(/(\d+(?:\.\d+)?) ?(ft|feet|foot|m|metres|meters)(?![\p{L}])/giu)].map((m) => (/^m/i.test(m[2]) ? Number(m[1]) * 3.28 : Number(m[1])));
+}
+
+/** Heating or warming a space with a fuel burner ("warm up the tent with a gas canister stove"). */
+const HEAT_SPACE = re(
+  `${B}(?:heat|warm)(?:ing)?(?: up)? (?:the |my |our |a )?(?:[\\p{L}-]+ )?(?:tent|room|house|home|apartment|camper|van|cabin|shack|shelter|garage|basement|crawl ?space)${E}.{0,40}${B}(?:stoves?|ovens?|grills?|bbqs?|heaters?|burners?|lanterns?)${E}`
+);
+
+/** Storing or winterising, nothing running. */
+const STORAGE = re(`${B}(?:stor(?:e|ing|age)|winteri[sz]\\w*)${E}`);
+const RUNNING = re(`${B}(?:run|running|use|using|operate|operating|start|starting|turn(?:ed|ing)? on|fire up|light|lighting)${E}`);
+
+/** An enclosed or attached space. Bare "inside" is not enough ("inside the function"). */
+const SPACE = re(
+  [
+    `${B}indoors?${E}`,
+    `${B}(?:inside|in|into) (?:the |my |our |a |your |an |his |her |their )?(?:[\\p{L}-]+ ){0,2}(?:house|home|bedroom|living room|apartment|flat|cabin|room|tent|camper|garage|basement|shed|van|rv|caravan|trailer|motorhome|boat|yurt|hut|shelter|dorm|condo|workshop|barn|porch|sunroom|conservatory)${E}`,
+    `${B}garages?${E}(?! (?:sale|band|door opener))`,
+    `${B}carports?${E}`,
+    `${B}on (?:the |my |our |a )?(?:enclosed |screened |screened-in |covered |closed-in )?(?:porch|sunroom|veranda)${E}`,
+    `${B}tents?${E}`,
+    `${B}(?:campers?|rvs?|motorhomes?|caravans?|camper ?vans?|travel trailers?)${E}`,
+    `${B}(?:basements?|cellars?|crawl ?spaces?|sheds?)${E}`,
+    `${B}(?:enclosed|screened[- ]in|closed|covered) (?:porch|patio|balcony|space|area|room|deck)${E}`,
+    `${B}(?:ice|fishing|pop-up|popup) (?:fishing )?(?:shack|house|hut|shanty|tent|shelter)s?${E}`,
+    `${B}shacks?${E}`,
+  ].join("|")
+);
+
+/** Someone may already be poisoned or an alarm is sounding: that is the health route's CO card, not this answer. */
+const ACUTE = re(
+  `${B}(?:headaches?|dizz\\w*|nause\\w*|vomit\\w*|throwing up|passed out|faint\\w*|unconscious|confus\\w*|drowsy|sleepy|chest pain|can'?t breathe|short of breath|feel(?:s|ing)? (?:sick|ill|weird|woozy|weak))${E}` +
+    `|${B}(?:alarm|detector)s?${E}.{0,20}${B}(?:going off|went off|beeping|sounding|chirp\\w*|is on|says|reads|reading|shows)${E}|${B}\\d+ ?ppm${E}`
+);
+
+/** Yes/no planning question: the answer starts with "No." */
+const PERMISSION = re(
+  `^\\s*(?:can|could|may|should|would|will) (?:i|we|you|one)${E}|${B}is it (?:ok|okay|safe|fine|alright|all right|dangerous|bad)${E}|${B}am i (?:allowed|able)${E}|${B}(?:ok|okay|safe) to${E}`
+);
+
+/** English question about running a fuel-burning device in an enclosed or attached space (no symptoms, no alarm). */
+export function isCoHazardQuestion(query: string): boolean {
+  const q = query.replace(/[’‘]/g, "'");
+  if (ACUTE.test(q)) return false;
+  if (OVEN_HEAT.test(q) || HEAT_SPACE.test(q)) return true;
+  if (PLACEMENT.test(q)) {
+    const ft = statedFeet(q);
+    if (!(ft.length && ft.every((d) => d >= 19.5))) return true;
+  }
+  if (!SPACE.test(q)) return false;
+  if (STORAGE.test(q) && !RUNNING.test(q)) return false;
+  return DEVICE.test(q) || (ENGINE.test(q) && /(?<![\p{L}\p{N}_])(?:garages?|carports?|shed|enclosed|basement|crawl ?space)(?![\p{L}\p{N}_])/iu.test(q));
+}
+
+export const CO_HAZARD_EN =
+  "Carbon monoxide (CO) from a generator, a charcoal or gas grill, a camping stove or lantern, or a fuel heater that isn't made and vented for indoor use is a poison you can't see or smell, and it can kill in minutes. " +
+  "Never run them inside a home, garage, basement, shed, tent or camper, even with the doors or windows open: that is not enough ventilation. " +
+  "Run a generator outside only, at least 20 feet (6 metres) from any door, window or vent. " +
+  "Never leave a car or other engine running in a garage, and never heat a home with a gas oven. " +
+  "Have a battery-powered CO alarm. " +
+  "If anyone gets a headache, dizziness, weakness, nausea, vomiting, chest pain or confusion, get everyone out into fresh air and call emergency services right away.";
+
+export const CO_HAZARD_SOURCES_EN =
+  "Sources: CDC, What to Do to Protect Yourself During a Power Outage; US CPSC, Generators and Engine-Driven Tools; NHS, Carbon monoxide poisoning.";
+
+export function coHazardAnswer(query: string): string {
+  const lead = PERMISSION.test(query.replace(/[’‘]/g, "'")) ? "No. " : "";
+  return `${lead}${CO_HAZARD_EN}\n\n${CO_HAZARD_SOURCES_EN}\n\n${emergencyNumbersLine(query, false) ?? emergencyLine(false)}`;
+}
