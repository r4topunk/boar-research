 /** A format-2 pack hit in the shape the chat's retrieval uses. */
+/** ORACLE-REAL (eval only): pack `packId`'s chunk `chunkId` in the shape of a retrieved pack passage (null when absent). */
+export async function packOracleChunkById(packId: string, chunkId: number): Promise<RetrievedChunk | null> {
+  // A pack file outside the catalog is listed as "local-<file name>" (knowledgePacks).
+  const pack = (await knowledgePacks()).find((p) => p.id === packId || p.id === `local-${packId}`);
+  if (!pack || !(await openPack(pack))) return null;
+  const wp = wikiPacks.get(pack.id);
+  if (!wp) return null;
+  const h = await wp.oracleChunkById(chunkId);
+  return h ? packHitToChunk(pack.id, h) : null;
+}
