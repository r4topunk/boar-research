diff -ruN a/src/routing/citationSemantic.ts b/src/routing/citationSemantic.ts
--- a/src/routing/citationSemantic.ts	1969-12-31 21:00:00
+++ b/src/routing/citationSemantic.ts	2026-10-21 01:20:27
@@ -0,0 +1,120 @@
+/**
+ * CITESUP arm (coordinator arms/citesup): a paraphrase-tolerant second test for CT-1. A [n] that the key-word rule
+ * (citations.ts, half the sentence's key words in the source) would remove stays when the bge-small-en-v1.5 cosine
+ * between its sentence and source n reaches tau. Same embedder and normalisation as retrieval: embeddingEngine.embed
+ * (no query instruction: the engine embeds questions as plain text, see retrieve.ts), passages as `${title}\n${body}`
+ * (seedCorpus.ts / documentImporter.ts), cosineSimilarity (rag/pure.ts). A long passage is cut into windows that
+ * fit the embedder's 512-token context; the best window counts.
+ *
+ * Env (eval only; unset = off, zero cost): BOAR_CITESUP = "log" (compute and log, never keep) | "on" (keep when
+ * cos >= BOAR_CITESUP_TAU); BOAR_CITESUP_LOG = JSONL file for one record per answer with a citation check.
+ * Any embedder failure keeps the key-word decision (fail safe: never a kept citation without a cosine).
+ */
+import type { RetrievedChunk } from "../rag/retrieve.types";
+import { cosineSimilarity } from "../rag/pure";
+import { unsupportedCitations } from "./citations";
+
+/** Window size and step (characters) for a passage longer than WINDOW_CHARS + 200 (bge-small context 512 tokens). */
+export const WINDOW_CHARS = 1000;
+const WINDOW_STEP = 800;
+
+export function passageWindows(source: RetrievedChunk): string[] {
+  const body = source.body ?? "";
+  if (body.length <= WINDOW_CHARS + 200) return [`${source.title}\n${body}`];
+  const out: string[] = [];
+  for (let start = 0; start < body.length; start += WINDOW_STEP) {
+    let s = start;
+    if (s > 0) {
+      const sp = body.indexOf(" ", s);
+      if (sp > 0 && sp - s < 40) s = sp + 1;
+    }
+    out.push(`${source.title}\n${body.slice(s, start + WINDOW_CHARS)}`);
+    if (start + WINDOW_CHARS >= body.length) break;
+  }
+  return out;
+}
+
+const env = (k: string): string | undefined => (typeof process !== "undefined" ? process.env?.[k] || undefined : undefined);
+
+export function citesupMode(): "log" | "on" | null {
+  const m = env("BOAR_CITESUP");
+  return m === "log" || m === "on" ? m : null;
+}
+
+export interface CitesupDecision {
+  k: number;
+  n: number;
+  sentence: string;
+  cos: number | null;
+  rescued: boolean;
+  window?: string;
+  error?: string;
+}
+
+async function log(rec: Record<string, unknown>): Promise<void> {
+  const file = env("BOAR_CITESUP_LOG");
+  if (!file) return;
+  const fs = await import("node:fs");
+  fs.appendFileSync(file, JSON.stringify({ item: (globalThis as any).__boarCurrentItem ?? null, ...rec }) + "\n");
+}
+
+/** Logs what the model wrote (CITESUP replay input), when BOAR_CITESUP is set. */
+export async function citesupLogRaw(text: string, sources: RetrievedChunk[]): Promise<void> {
+  if (!citesupMode()) return;
+  await log({ kind: "raw", text, sources: sources.map((s) => s.title) });
+}
+
+/**
+ * The [n] indexes (checkCitations' `rescued`) to keep. Undefined when CITESUP is off. In "log" mode the set is
+ * always empty: the cosines are computed and logged only.
+ */
+export async function citesupRescue(answer: string, sources: RetrievedChunk[]): Promise<Set<number> | undefined> {
+  const mode = citesupMode();
+  if (!mode) return undefined;
+  const tau = Number(env("BOAR_CITESUP_TAU") ?? "NaN");
+  const rescued = new Set<number>();
+  const pending = unsupportedCitations(answer, sources);
+  if (!pending.length) return rescued;
+  const decisions: CitesupDecision[] = [];
+  let embed: ((t: string) => Promise<Float32Array>) | null = null;
+  let loadError: string | undefined;
+  try {
+    const { embeddingEngine } = await import("../rag/embed");
+    embed = (t) => embeddingEngine.embed(t);
+  } catch (e: any) {
+    loadError = String(e?.message ?? e);
+  }
+  const windowVecs = new Map<number, { text: string; vec: Float32Array }[]>();
+  for (const p of pending) {
+    const d: CitesupDecision = { k: p.k, n: p.n, sentence: p.sentence, cos: null, rescued: false };
+    try {
+      if (!embed) throw new Error(loadError ?? "no embedder");
+      if (!p.sentence.trim()) throw new Error("empty sentence");
+      if (!windowVecs.has(p.n)) {
+        const ws = passageWindows(sources[p.n - 1]);
+        const vecs: { text: string; vec: Float32Array }[] = [];
+        for (const w of ws) vecs.push({ text: w, vec: await embed(w) });
+        windowVecs.set(p.n, vecs);
+      }
+      const sv = await embed(p.sentence);
+      let best = -2;
+      let bestText = "";
+      for (const w of windowVecs.get(p.n)!) {
+        const c = cosineSimilarity(sv, w.vec);
+        if (c > best) {
+          best = c;
+          bestText = w.text;
+        }
+      }
+      d.cos = Math.round(best * 1e6) / 1e6;
+      d.window = bestText.slice(0, 1200);
+      d.rescued = mode === "on" && Number.isFinite(tau) && best >= tau;
+      if (d.rescued) rescued.add(p.k);
+    } catch (e: any) {
+      d.error = String(e?.message ?? e);
+    }
+    decisions.push(d);
+  }
+  await log({ kind: "check", mode, tau: Number.isFinite(tau) ? tau : null, answer, decisions });
+  return rescued;
+}
