diff --git a/src/routing/packGround.test.ts b/src/routing/packGround.test.ts
new file mode 100644
index 00000000..1f635f4f
--- /dev/null
+++ b/src/routing/packGround.test.ts
@@ -0,0 +1,60 @@
+import { describe, it, expect } from "vitest";
+import * as pure from "../rag/pure";
+import { createAnswerer } from "./answer";
+
+// PACKCOND P4: settings.packGround (default off). With nothing on topic, the pack's best passages are kept
+// (packground:kept-N); off, grounding empties the context (grounding:no-good-source) as before.
+const POFF = {
+  chunkId: "pack:boar-wikivoyage-en:9", docId: "pack:boar-wikivoyage-en:a9", title: "Wikivoyage: Street food",
+  body: "Eat: Street food is sold from carts in many cities. Prices are low and hygiene varies.",
+  source: "Wikivoyage — https://en.wikivoyage.org/wiki/Street_food", score: 1, matchType: "lexical",
+} as any;
+const CORE = { ...POFF, chunkId: "c9", docId: "c9", title: "Street food", source: "Wikipedia" } as any;
+const GB = 1024 ** 3;
+const fast = { id: "fast4b", label: "F", filename: "models/fast.gguf", sizeBytes: 2.5 * GB, roles: ["general", "fast"], isDefault: true };
+const deep = { id: "deep35", label: "D", filename: "models/deep.gguf", sizeBytes: 12 * GB, roles: ["reasoning"] };
+
+async function run(chunks: any[], packGround?: boolean) {
+  let loaded: string | null = null;
+  let clock = 0;
+  const events: any[] = [];
+  const deps: any = {
+    now: () => (clock += 5),
+    engine: {
+      async load(f: string) { loaded = f; return { fit: null, warning: null }; },
+      async generate(o: any) { o.onToken?.("Answer [1]."); return "Answer [1]."; },
+      async stop() {},
+      getModelInfo: () => (loaded ? { filename: loaded } : null),
+      hasEmbeddedChatTemplate: () => true,
+      async estimateFit() { return null; },
+    },
+    retrieve: async () => chunks,
+    getSettings: async () => ({ quickFirst: true, alwaysComplete: true, deepModelId: deep.id, ...(packGround === undefined ? {} : { packGround }) }),
+    listInstalledLlms: async () => [fast, deep],
+    getActiveModelId: async () => fast.id,
+    runMultipass: async () => { throw new Error("no multipass"); },
+    assemblePrompt: pure.assemblePrompt, assembleChatMessages: pure.assembleChatMessages,
+  };
+  const q = "Why was Canberra chosen as the capital of Australia?";
+  const result = await createAnswerer(deps).answer({ query: q }, (e: any) => events.push(e), { systemPrompt: "S", styleReminder: "B", maxTokens: 512 }).done;
+  return { codes: result.receipt.reasonCodes as string[], sources: result.sources.map((c: any) => c.chunkId) };
+}
+
+describe("packGround", () => {
+  it("off: an off-topic pack passage is dropped (no-good-source)", async () => {
+    const r = await run([POFF]);
+    expect(r.sources).toEqual([]);
+    expect(r.codes).toContain("grounding:no-good-source");
+    expect(r.codes.some((c) => c.startsWith("packground:"))).toBe(false);
+  });
+  it("on: the pack's best passage is kept when nothing is on topic", async () => {
+    const r = await run([POFF], true);
+    expect(r.sources).toEqual([POFF.chunkId]);
+    expect(r.codes).toContain("packground:kept-1");
+  });
+  it("on: a built-in (non-pack) passage is never kept this way", async () => {
+    const r = await run([CORE], true);
+    expect(r.sources).toEqual([]);
+    expect(r.codes).toContain("packground:none");
+  });
+});
