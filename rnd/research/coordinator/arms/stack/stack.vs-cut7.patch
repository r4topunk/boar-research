diff -ruN -x .cache -x node_modules -x ARM -x STACK_PATCH_SHA256 be-0cfd4a77-cut7/src/rag/packRoute.ts be-0cfd4a77-cut7-stack/src/rag/packRoute.ts
--- be-0cfd4a77-cut7/src/rag/packRoute.ts	1969-12-31 21:00:00
+++ be-0cfd4a77-cut7-stack/src/rag/packRoute.ts	2026-10-13 15:47:40
@@ -0,0 +1,37 @@
+/**
+ * PACKROUTE "quota" (default off; STACK = cut 7 + this + packGround "perpack"): with several Knowledge Packs installed,
+ * every pack is searched as without the setting, but each non-kit pack holds at most PACK_QUOTA of the retrieved slots;
+ * the slots it would have taken go to the next candidates. (The PACKROUTE "router" mode is not part of this build.)
+ *
+ * Pure: no database or native imports.
+ */
+export type PackRouteMode = "off" | "quota";
+
+/** Packs shipped with the claim build: always searched, never capped. */
+export const KIT_PACK_IDS = new Set(["boar-crypto", "boar-wikivoyage-en"]);
+export const PACK_QUOTA = 2;
+
+/** A pack id without the "local-" prefix of a pack file found in corpus/ outside the catalog. */
+export const basePackId = (id: string) => id.replace(/^local-/, "");
+export const isKitPack = (id: string) => KIT_PACK_IDS.has(basePackId(id));
+
+/** The pack id of a retrieved chunk ("pack:<id>:<chunk>"), or null for the bundled corpus. */
+export function chunkPackId(chunkId: string): string | null {
+  const m = /^pack:([^:]+):/.exec(chunkId);
+  return m ? m[1] : null;
+}
+
+/**
+ * "quota": keeps the list order and drops every chunk of a non-kit pack past its `cap`-th. `held` carries the counts
+ * across calls (a list built in two parts).
+ */
+export function capPerPack<T extends { chunkId: string }>(list: T[], cap = PACK_QUOTA, held: Map<string, number> = new Map()): T[] {
+  return list.filter((c) => {
+    const p = chunkPackId(c.chunkId);
+    if (!p || isKitPack(p)) return true;
+    const n = held.get(p) ?? 0;
+    if (n >= cap) return false;
+    held.set(p, n + 1);
+    return true;
+  });
+}
