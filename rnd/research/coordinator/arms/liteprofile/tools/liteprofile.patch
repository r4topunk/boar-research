+      const s = norms[i] ? dot / (qn * norms[i]) : 0;
+      if (top.length < m || s > top[top.length - 1].s) {
+        let j = top.length < m ? top.length : top.length - 1;
+        if (top.length < m) top.push({ id: ids[i], s });
+        while (j > 0 && top[j - 1].s < s) (top[j] = top[j - 1]), j--;
+        top[j] = { id: ids[i], s };
+      }
+    }
+    const t2 = Date.now();
+    const art = top.map((t) => t.id);
+    const rows = art.length
+      ? await this.db.getAllAsync<{ id: number; article_id: number; start: number; end: number; vec: Uint8Array }>(
+          `SELECT c.id, c.article_id, c.start, c.end, v.vec FROM chunks c JOIN chunk_vecs v ON v.chunk_id = c.id
+           WHERE c.article_id IN (${art.map(() => "?").join(",")})`,
+          art
+        )
+      : [];
+    const scored = rows
+      .map((r) => ({ r, s: cosineSimilarityInt8(queryVec, new Uint8Array(r.vec)) }))
+      .filter((x) => x.s >= floor)
+      .sort((a, b) => b.s - a.s || a.r.id - b.r.id)
+      .slice(0, k);
+    const t3 = Date.now();
+    const hits: PackHit[] = [];
+    for (const { r, s } of scored) hits.push({ ...(await this.hit(r.article_id, r.id, r.start, r.end, s, "semantic")), score: s });
+    denseScans.push({ leadMs: t2 - t1, chunkMs: t3 - t2, ms: Date.now() - t0, leads: ids.length, candidates: rows.length, kept: hits.length, loadMs });
+    if (denseScans.length > 32) denseScans.shift();
+    return hits;
+  }
+
   private async titleHits(ids: number[], stems: Stem[], ranks = 5, action = false, explain = false): Promise<PackHit[]> {
