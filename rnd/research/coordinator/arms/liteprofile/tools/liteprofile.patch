+import { describe, it, expect } from "vitest";
+import type { RetrievedChunk } from "../rag/retrieve.types";
+import { groupSources, pageKey } from "./sourceGroups";
+
+const src = (chunkId: string, title: string, url?: string, extra: Partial<RetrievedChunk & { relevance?: number }> = {}) => ({
+  chunkId,
+  docId: chunkId,
+  title,
+  body: `${title} passage ${chunkId}.`,
+  score: 1,
+  matchType: "hybrid" as const,
+  ...(url !== undefined ? { source: url ? `Wikivoyage — ${url}` : "Offline library" } : {}),
+  ...extra,
+});
+
+describe("groupSources (SOURCEGROUP)", () => {
+  it("merges passages of one URL into one group and keeps every passage with its place in the source list", () => {
+    const s = [
+      src("a1", "Wikivoyage: Rail travel in Japan", "https://en.wikivoyage.org/wiki/Rail_travel_in_Japan", { similarity: 0.6, relevance: 0.4 }),
+      src("b1", "Japan Rail Pass", "https://en.wikivoyage.org/wiki/Japan_Rail_Pass"),
+      src("a2", "Wikivoyage: Rail travel in Japan", "https://en.wikivoyage.org/wiki/Rail_travel_in_Japan", { similarity: 0.7, relevance: 0.2 }),
+    ];
+    const g = groupSources("A [1]. B [2]. C [3].", s);
+    expect(g.groups.map((x) => [x.n, x.title, x.passages.map((p) => [p.chunkId, p.sourceIndex])])).toEqual([
+      [1, "Wikivoyage: Rail travel in Japan", [["a1", 0], ["a2", 2]]],
+      [2, "Japan Rail Pass", [["b1", 1]]],
+    ]);
+    expect(g.groups[0].similarity).toBe(0.7);
+    expect(g.groups[0].relevance).toBe(0.4);
+    expect(g.text).toBe("A [1]. B [2]. C [1].");
+    expect(g.cited).toEqual([1, 2]);
+    expect([g.before, g.after]).toEqual([3, 2]);
+  });
+
+  it("same URL wins over different titles; different URLs with one title stay apart", () => {
+    const u = "https://travel.stackexchange.com/questions/66836";
+    expect(pageKey(src("x", "Q one", u))).toBe(pageKey(src("y", "Q one (answer 2)", u)));
+    expect(pageKey(src("x", "Paris", "https://en.wikipedia.org/wiki/Paris"))).not.toBe(pageKey(src("y", "Paris", "https://en.wikivoyage.org/wiki/Paris")));
+  });
+
+  it("falls back to the title (case and spaces ignored) when the source has no URL", () => {
+    const s = [src("c1", "Choking"), src("c2", "choking "), src("h1", "Heimlich manoeuvre", ""), src("c3", "Choking", "")];
+    const g = groupSources("Back blows [2]. Thrusts [3]. Call [4].", s);
+    expect(g.groups.map((x) => x.passages.length)).toEqual([3, 1]);
+    expect(g.groups[0].key).toBe("title:choking");
+    expect(g.text).toBe("Back blows [1]. Thrusts [2]. Call [1].");
+  });
+
+  it("renumbers markers to the groups: [1][3] -> [1][2], and [1][2] of one page -> [1]", () => {
+    const s = [src("a", "A", "https://x.org/A"), src("a2", "A", "https://x.org/A"), src("b", "B", "https://x.org/B")];
+    expect(groupSources("Both say so [1][3].", s).text).toBe("Both say so [1][2].");
+    expect(groupSources("One page [1][2].", s).text).toBe("One page [1].");
+    expect(groupSources("One page [1] [2]. Next [3].", s).text).toBe("One page [1]. Next [2].");
+    // Out-of-range markers are not the engine's to renumber.
+    expect(groupSources("Odd [7]. Fine [2].", s).text).toBe("Odd [7]. Fine [1].");
+  });
+
+  it("leaves an answer without citations untouched and keeps the text identical when no page repeats", () => {
+    const dup = [src("a", "A", "https://x.org/A"), src("a2", "A", "https://x.org/A")];
+    const none = groupSources("No marker here.", dup);
+    expect(none.text).toBe("No marker here.");
+    expect(none.cited).toEqual([]);
+    expect(none.groups).toHaveLength(1);
+    const distinct = [src("a", "A", "https://x.org/A"), src("b", "B", "https://x.org/B"), src("c", "C")];
+    const text = "C first [3]. A [1]. A again [1] [1].";
+    const same = groupSources(text, distinct);
+    expect(same.text).toBe(text);
+    expect(same.map).toEqual([0, 1, 2, 3]);
+    expect(same.groups.map((x) => x.passages.length)).toEqual([1, 1, 1]);
+    expect(groupSources("", [])).toMatchObject({ text: "", groups: [], cited: [], before: 0, after: 0 });
+  });
+
+  it("maps a citation that is not written in the text (the instant excerpt) to its group", () => {
+    const s = [src("a", "A", "https://x.org/A"), src("b", "B", "https://x.org/B"), src("a2", "A", "https://x.org/A")];
+    expect(groupSources("An excerpt.", s, [3]).cited).toEqual([1]);
+    expect(groupSources("An excerpt.", s, [2]).cited).toEqual([2]);
+  });
+});
diff --git a/src/routing/sourceGroups.ts b/src/routing/sourceGroups.ts
new file mode 100644
index 0000000..7743a9d
--- /dev/null
+++ b/src/routing/sourceGroups.ts
@@ -0,0 +1,110 @@
+/**
+ * SOURCEGROUP: one entry per page in the final answer's source list.
+ *
+ * Retrieval numbers sources per passage, so a page that gave two or three passages shows up two or
+ * three times ("Choking" ×3, PHONEFAIL failure 4: 8/27 desktop traces, 15/37 phone rows). After the
+ * answer is final, groupSources() merges the passages of one page into a group, numbers the groups by
+ * the page's first appearance in the source list (rank order kept), and rewrites every [n] in the text
+ * to its group's number ([1][3] with 2 a passage of page 1 -> [1][2]; [1][2] of one page -> [1]).
+ * Nothing else in the text changes. Pure: no I/O, no model.
+ */
+import type { RetrievedChunk } from "../rag/retrieve.types";
+import { dedupeCitations } from "./citations";
+
+/** A passage of a grouped page: the source as the sources event sent it, plus its place there. */
+export type GroupedPassage = RetrievedChunk & {
+  relevance?: number;
+  /** 0-based index into the sources event list ("[sourceIndex + 1]" before grouping). */
+  sourceIndex: number;
+};
+
+export interface SourceGroup {
+  /** The number "[n]" in the final text uses for this page (1-based, = index + 1 in sourceGroups). */
+  n: number;
+  /** "url:<url>" when the source label carries one, else "title:<lowercased title>". */
+  key: string;
+  title: string;
+  source?: string;
+  docId: string;
+  /** Best of the passages' values (absent when none has one). */
+  similarity?: number;
+  relevance?: number;
+  /** The page's passages in source-list order (length ≥ 1): for renderers that keep a chip per passage. */
+  passages: GroupedPassage[];
+}
+
+export interface GroupedSources {
+  groups: SourceGroup[];
+  /** The text with every [n] (1 ≤ n ≤ sources.length) rewritten to its group's number; others left as they are. */
+  text: string;
+  /** Group numbers the text cites, ascending. */
+  cited: number[];
+  /** Passage number (1-based) -> group number. */
+  map: number[];
+  before: number;
+  after: number;
+}
+
+const URL_RE = /https?:\/\/[^\s)\]]+/;
+
+/** The page a source belongs to: its URL when the label has one, else its title (case- and space-insensitive). */
+export function pageKey(c: { title: string; source?: string }): string {
+  const url = c.source?.match(URL_RE)?.[0];
+  if (url) return `url:${url.replace(/[.,;]+$/, "")}`;
+  return `title:${(c.title ?? "").trim().replace(/\s+/g, " ").toLowerCase()}`;
+}
+
+const best = (xs: (number | undefined)[]): number | undefined => {
+  const v = xs.filter((x): x is number => typeof x === "number");
+  return v.length ? Math.max(...v) : undefined;
+};
+
+/**
+ * Groups `sources` by page and renumbers the [n] in `text`. citedPassages (1-based passage numbers) is
+ * for an answer whose citation is not written in the text (the instant excerpt): mapped to groups.
+ * No two sources of one page -> groups mirror sources one to one and the text is returned unchanged.
+ */
+export function groupSources(
+  text: string,
+  sources: (RetrievedChunk & { relevance?: number })[],
+  citedPassages?: number[]
+): GroupedSources {
+  const byKey = new Map<string, SourceGroup>();
+  const groups: SourceGroup[] = [];
+  const map: number[] = [0];
+  sources.forEach((c, i) => {
+    const key = pageKey(c);
+    let g = byKey.get(key);
+    if (!g) {
+      g = { n: groups.length + 1, key, title: c.title, ...(c.source !== undefined ? { source: c.source } : {}), docId: c.docId, passages: [] };
+      byKey.set(key, g);
+      groups.push(g);
+    }
+    g.passages.push({ ...c, sourceIndex: i });
+    map.push(g.n);
+  });
+  for (const g of groups) {
+    const s = best(g.passages.map((p) => p.similarity));
+    const r = best(g.passages.map((p) => p.relevance));
+    if (s !== undefined) g.similarity = s;
+    if (r !== undefined) g.relevance = r;
+  }
+  const merged = groups.length < sources.length;
+  let out = text;
+  if (merged) {
+    out = text.replace(/\[(\d+)\]/g, (whole, num: string) => {
+      const k = Number(num);
+      return k >= 1 && k <= sources.length ? `[${map[k]}]` : whole;
+    });
+    // Two passages of one page cited side by side now read "[1][1]": keep one.
+    let prev: string;
+    do {
+      prev = out;
+      out = dedupeCitations(out).replace(/\[(\d+)\](?:[ \t]*\[\1\])+/g, "[$1]");
+    } while (out !== prev);
+  }
+  const fromText = [...out.matchAll(/\[(\d+)\]/g)].map((m) => Number(m[1])).filter((n) => n >= 1 && n <= groups.length);
+  const fromOverride = (citedPassages ?? []).filter((k) => k >= 1 && k <= sources.length).map((k) => map[k]);
+  const cited = [...new Set(citedPassages ? fromOverride : fromText)].sort((a, b) => a - b);
+  return { groups, text: out, cited, map, before: sources.length, after: groups.length };
+}
