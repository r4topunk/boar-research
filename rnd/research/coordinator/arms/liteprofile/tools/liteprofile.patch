+import { describe, it, expect } from "vitest";
+import { attachDenseCandidates, denseCandidatesOf, pickDenseAppend, rankDenseCandidates, HEADPASS_DENSE_D, HEADPASS_MAX_APPEND } from "./denseCandidates";
+import { applyAppendBudget, HEADPASS_BUDGET_TOKENS } from "./denseCandidates";
+
+const c = (chunkId: string, similarity?: number) => ({ chunkId, docId: chunkId, title: chunkId, body: "", score: 1, matchType: "semantic" as const, ...(similarity !== undefined ? { similarity } : {}) });
+const ids = (xs: { chunkId: string }[]) => xs.map((x) => x.chunkId);
+
+describe("HEADPASS-X2 dense candidates", () => {
+  it("rank: best cosine first, ties in order, deduplicated, minus the list", () => {
+    const list = [c("a"), c("b")];
+    expect(ids(rankDenseCandidates(list, [c("b", 0.9), c("x", 0.6), c("y", 0.8), c("z", 0.6), c("y", 0.7)]))).toEqual(["y", "x", "z"]);
+  });
+
+  it("attach returns the same array, unchanged; denseCandidatesOf reads it back; other arrays have none", () => {
+    const list = [c("a")];
+    const copy = JSON.stringify(list);
+    expect(attachDenseCandidates(list, { candidates: [c("x", 0.7)], sidecar: true })).toBe(list);
+    expect(JSON.stringify(list)).toBe(copy);
+    expect(ids(denseCandidatesOf(list)!.candidates)).toEqual(["x"]);
+    expect(denseCandidatesOf([c("a")])).toBeUndefined();
+    expect(denseCandidatesOf([...list])).toBeUndefined();
+  });
+
+  it("pick: D = 2, skips chunks already present (kept or appended), cap 4 in all", () => {
+    expect(HEADPASS_DENSE_D).toBe(2);
+    expect(HEADPASS_MAX_APPEND).toBe(4);
+    const cand = [c("p", 0.9), c("q", 0.8), c("r", 0.7), c("s", 0.6)];
+    expect(ids(pickDenseAppend(cand, [], 0))).toEqual(["p", "q"]);
+    expect(ids(pickDenseAppend(cand, [c("p"), c("k")], 2))).toEqual(["q", "r"]);
+    // Cap: 3 already appended -> room for 1; 4 -> none.
+    expect(ids(pickDenseAppend(cand, [], 3))).toEqual(["p"]);
+    expect(pickDenseAppend(cand, [], 4)).toEqual([]);
+    expect(ids(pickDenseAppend(cand, [], 0, 3, 4))).toEqual(["p", "q", "r"]);
+    expect(ids(pickDenseAppend(cand, [], 2, 3, 4))).toEqual(["p", "q"]);
+    expect(pickDenseAppend([], [], 0)).toEqual([]);
+  });
+});
+
+describe("HEADPASS-X2b append budget", () => {
+  const len = (xs: string[]) => 100 + xs.join("").length;
+  it("keeps in order while within the budget; the first over it is dropped and the loop stops", () => {
+    expect(applyAppendBudget(["aaa", "bb", "c"], len, 10)).toEqual({ kept: ["aaa", "bb", "c"], dropped: [] });
+    expect(applyAppendBudget(["aaa", "bbbbbbbb", "c"], len, 10)).toEqual({ kept: ["aaa"], dropped: ["bbbbbbbb", "c"] });
+    expect(applyAppendBudget(["aaaaaaaaaaaa", "b"], len, 10)).toEqual({ kept: [], dropped: ["aaaaaaaaaaaa", "b"] });
+  });
+  it("a chunk exactly at the budget is kept; nothing to add -> nothing", () => {
+    expect(applyAppendBudget(["aaaaa", "bbbbb", "c"], len, 10)).toEqual({ kept: ["aaaaa", "bbbbb"], dropped: ["c"] });
+    expect(applyAppendBudget([], len, 10)).toEqual({ kept: [], dropped: [] });
+  });
+  it("budget is 600 tokens", () => expect(HEADPASS_BUDGET_TOKENS).toBe(600));
+});
diff --git a/src/rag/denseCandidates.ts b/src/rag/denseCandidates.ts
new file mode 100644
index 0000000..914a4a9
--- /dev/null
+++ b/src/rag/denseCandidates.ts
@@ -0,0 +1,79 @@
+import type { RetrievedChunk } from "./retrieve.types";
+
+/**
+ * HEADPASS-X2 (settings.packDense2 "append", experimental, default off): the two-stage dense chunk candidates of a
+ * retrieve() call travel BESIDE the returned list, never in it, so the list (and everything the keep step does with it)
+ * stays byte-identical to the setting-absent path. retrieve() attaches them to the array it returns; the answerer reads
+ * them back from the same array object and hands them to the post-grounding head-pass append path.
+ */
+export interface DenseCandidates {
+  /** Dense chunk hits not already in the returned list, best cosine first (ties in retrieval order), deduplicated. */
+  candidates: RetrievedChunk[];
+  /** At least one searched format-2 pack carries a chunk_vecs sidecar (false: the dense path could not run). */
+  sidecar: boolean;
+}
+
+const attached = new WeakMap<RetrievedChunk[], DenseCandidates>();
+
+/** Attaches `dense` to `list` (the array retrieve() returns); returns `list` itself, unchanged. */
+export function attachDenseCandidates(list: RetrievedChunk[], dense: DenseCandidates): RetrievedChunk[] {
+  attached.set(list, dense);
+  return list;
+}
+
+/** The dense candidates attached to `list` by retrieve() in "append" mode; undefined when none were attached. */
+export function denseCandidatesOf(list: RetrievedChunk[]): DenseCandidates | undefined {
+  return attached.get(list);
+}
+
+/** `dense` sorted by similarity (desc, ties in the given order), deduplicated, minus the chunkIds already in `list`. */
+export function rankDenseCandidates(list: RetrievedChunk[], dense: RetrievedChunk[]): RetrievedChunk[] {
+  const seen = new Set(list.map((c) => c.chunkId));
+  return dense
+    .map((c, i) => ({ c, i }))
+    .sort((a, b) => (b.c.similarity ?? 0) - (a.c.similarity ?? 0) || a.i - b.i)
+    .map((x) => x.c)
+    .filter((c) => !seen.has(c.chunkId) && (seen.add(c.chunkId), true));
+}
+
+/** HEADPASS-X2: dense chunks appended per answer (D). */
+export const HEADPASS_DENSE_D = 2;
+/** HEADPASS-X2: cap on all head-pass appended chunks of one answer (X1 neighbours + dense). */
+export const HEADPASS_MAX_APPEND = 4;
+
+/**
+ * HEADPASS-X2: the dense chunks to append after grounding: the first `d` of `candidates` (already best-first, none in the
+ * raw list) whose chunkId is not in `present` (kept + already appended), within the room left by `cap` once
+ * `appendedSoFar` chunks were appended. No backfill after the health filter (that runs on the result, as X1's).
+ */
+export function pickDenseAppend(
+  candidates: RetrievedChunk[],
+  present: { chunkId: string }[],
+  appendedSoFar: number,
+  d = HEADPASS_DENSE_D,
+  cap = HEADPASS_MAX_APPEND
+): RetrievedChunk[] {
+  const n = Math.max(0, Math.min(d, cap - appendedSoFar));
+  if (!n) return [];
+  const have = new Set(present.map((c) => c.chunkId));
+  return candidates.filter((c) => !have.has(c.chunkId)).slice(0, n);
+}
+
+/** HEADPASS-X2b (settings.packDense2 "append-budget"): prompt tokens (engine approxTokens) the head-pass append may add. */
+export const HEADPASS_BUDGET_TOKENS = 600;
+
+/**
+ * HEADPASS-X2b: keeps `adds` in order while `measure(prefix)` (the prompt's length in characters with that prefix of
+ * `adds` appended) stays within `maxChars` of `measure([])`; the first chunk that would exceed it is dropped and the loop
+ * stops (it and every later chunk are returned in `dropped`). Characters, not tokens: approxTokens = ceil(chars / 4), so a
+ * delta of at most 4 x budget characters keeps the token delta within the budget whatever the rounding.
+ */
+export function applyAppendBudget<T>(adds: T[], measure: (prefix: T[]) => number, maxChars: number): { kept: T[]; dropped: T[] } {
+  const base = measure([]);
+  const kept: T[] = [];
+  for (let i = 0; i < adds.length; i++) {
+    if (measure([...kept, adds[i]]) - base > maxChars) return { kept, dropped: adds.slice(i) };
+    kept.push(adds[i]);
+  }
+  return { kept, dropped: [] };
+}
