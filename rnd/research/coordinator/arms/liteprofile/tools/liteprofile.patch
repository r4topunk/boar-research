+/// <reference types="node" />
+import { describe, it, expect, beforeAll, vi } from "vitest";
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { decompress } from "fzstd";
+
+vi.mock("expo-file-system/legacy", () => ({ documentDirectory: "file:///docs/" }));
+vi.mock("expo-sqlite", () => ({}));
+vi.mock("./embed", () => ({ embeddingEngine: {} }));
+
+import { nodeSqliteDatabase } from "./testing/nodeSqlite";
+import { WikiPack, denseScans } from "./wikiPack";
+
+// DENSECHUNK-ST packDense2: the two-stage chunk-vector path. Synthetic 384-d vectors: article i's lead points
+// along axis i, chunk j of article i along axis 10 * (i + 1) + j. Made-up, test-only documents.
+const filler = (t: string) => Array.from({ length: 30 }, (_, i) => `${t} filler sentence number ${i} about unrelated matters.`).join(" ");
+const docs = ["Alpha", "Beta", "Gamma", "Delta"].map((t, i) => ({
+  page_id: 1000 + i, title: t, source: "enwiki",
+  text: `# ${t}\n\n${t} is a test article. ${filler(t)}\n\n## Details\n\n${filler(t + " detail")}\n\n## More\n\n${filler(t + " more")}`,
+}));
+const axis = (k: number, w = 1) => { const v = new Int8Array(384); v[k] = 127 * w; return v; };
+
+let dense: WikiPack, plain: WikiPack, chunkOf: (title: string, j: number) => number;
+beforeAll(async () => {
+  const dir = mkdtempSync(join(tmpdir(), "boar-pack-dense2-"));
+  const shard = join(dir, "d.jsonl");
+  writeFileSync(shard, docs.map((r) => JSON.stringify(r)).join("\n") + "\n");
+  const build = (name: string) => {
+    const out = join(dir, `${name}.sqlite`);
+    execFileSync(process.execPath, ["scripts/build-wiki-pack.mjs", "--out", out, "--shards", shard, "--no-embed"], { stdio: "pipe" });
+    return out;
+  };
+  const pDense = build("dense"), pPlain = build("plain");
+  for (const [p, withChunks] of [[pDense, true], [pPlain, false]] as const) {
+    const db = new DatabaseSync(p);
+    db.exec("CREATE TABLE IF NOT EXISTS lead_vecs (article_id INTEGER PRIMARY KEY, scale REAL NOT NULL, vec BLOB NOT NULL)");
+    const arts = db.prepare("SELECT id, title FROM articles ORDER BY id").all() as Array<{ id: number; title: string }>;
+    for (const a of arts) {
+      const i = docs.findIndex((d) => d.title === a.title);
+      db.prepare("INSERT OR REPLACE INTO lead_vecs VALUES (?, 1, ?)").run(a.id, new Uint8Array(axis(i).buffer));
+    }
+    if (withChunks) {
+      db.exec("CREATE TABLE chunk_vecs (chunk_id INTEGER PRIMARY KEY, scale REAL NOT NULL, vec BLOB NOT NULL)");
+      for (const a of arts) {
+        const i = docs.findIndex((d) => d.title === a.title);
+        const ch = db.prepare("SELECT id FROM chunks WHERE article_id = ? ORDER BY start").all(a.id) as Array<{ id: number }>;
+        ch.forEach((c, j) => db.prepare("INSERT INTO chunk_vecs VALUES (?, 1, ?)").run(c.id, new Uint8Array(axis(10 * (i + 1) + j).buffer)));
+      }
+    }
+    db.close();
+  }
+  const ro = new DatabaseSync(pDense, { readOnly: true });
+  chunkOf = (title, j) =>
+    (ro.prepare("SELECT c.id FROM chunks c JOIN articles a ON a.id = c.article_id WHERE a.title = ? ORDER BY c.start").all(title) as any[])[j].id;
+  dense = await WikiPack.open(nodeSqliteDatabase(pDense), decompress);
+  plain = await WikiPack.open(nodeSqliteDatabase(pPlain), decompress);
+}, 60000);
+
+/** A query vector: mostly toward Gamma's lead (axis 2) and its chunk 1 (axis 31), a little toward Beta's chunk 1. */
+const q = () => { const v = new Float32Array(384); v[2] = 0.6; v[31] = 0.75; v[21] = 0.2; return v; };
+
+describe("packDense2 two-stage chunk vectors", () => {
+  it("detects the sidecar at open", () => {
+    expect(dense.hasChunkVecs).toBe(true);
+    expect(plain.hasChunkVecs).toBe(false);
+  });
+
+  it("stage 2 only scores the stage-1 articles and applies the cosine floor", async () => {
+    const top1 = await dense.denseChunks(q(), 1, 12, 0.5);
+    expect(top1.map((h) => h.chunkId)).toEqual([chunkOf("Gamma", 1)]);
+    expect(top1[0].via).toBe("semantic");
+    expect(top1[0].title).toBe("Gamma");
+    expect(top1[0].score).toBeCloseTo(0.75 / Math.hypot(0.6, 0.75, 0.2), 4);
+    // With the floor at 0, every Gamma chunk comes back (cos 0 for the others), still Gamma only.
+    const all = await dense.denseChunks(q(), 1, 12, 0);
+    expect(new Set(all.map((h) => h.title))).toEqual(new Set(["Gamma"]));
+    // Two articles in stage 1 (Gamma, then Alpha/Beta/Delta tie at 0 -> scan order): Beta's chunk 1 is not reachable
+    // unless Beta is among them; with m = 4 it is, below Gamma's.
+    const m4 = await dense.denseChunks(q(), 4, 12, 0.1);
+    expect(m4.map((h) => h.chunkId)).toEqual([chunkOf("Gamma", 1), chunkOf("Beta", 1)]);
+    expect(denseScans.at(-1)!.leads).toBe(4);
+  });
+
+  it("searchDetailed: off, or no sidecar, returns no semantic list (identical hits)", async () => {
+    const off = await dense.searchDetailed("Gamma test article", { queryVec: q() });
+    const plainOn = await plain.searchDetailed("Gamma test article", { queryVec: q(), dense2: true });
+    const on = await dense.searchDetailed("Gamma test article", { queryVec: q(), dense2: true });
+    expect("semantic" in off).toBe(false);
+    expect("semantic" in plainOn).toBe(false);
+    expect(on.hits).toEqual(off.hits);
+    expect(on.semantic!.map((h) => h.chunkId)).toEqual([chunkOf("Gamma", 1)]);
+  });
+});
