+++ b/src/routing/defaultModel.test.ts
@@ -1,5 +1,6 @@
 import { describe, it, expect } from "vitest";
 import { AUTO_PICK_MAX_MODEL_BYTES, isCompactModel, LOW_RAM_MAX_MODEL_BYTES, pickDefaultAnswerModel, rankAnswerModels, tooBigForAutoPick, tooBigForLowRam } from "./defaultModel";
+import { MODEL_CATALOG } from "../models/manifest";
 import { contextSizeForRam, estimateMemoryFit, parseGgufShape, toGb } from "../inference/memoryFit";
 
 const GiB = 1024 ** 3;
@@ -176,3 +177,18 @@ describe("CR-1: nothing above the compact model on a low-RAM phone", () => {
     expect(isCompactModel({ sizeBytes: 2.4 * GB })).toBe(false);
   });
 });
+
+describe("the lite 1.7B catalog entry (qwen3-1.7b-q4km)", () => {
+  const entry = MODEL_CATALOG.find((m) => m.id === "qwen3-1.7b-q4km")!;
+  it("a 1.11 GB model with that entry is not a compact model (no compact declines)", () => {
+    expect(entry.sizeBytes).toBe(1107409472);
+    expect(entry.sizeBytes).toBeLessThanOrEqual(LOW_RAM_MAX_MODEL_BYTES);
+    expect(isCompactModel({ answerTier: entry.answerTier, sizeBytes: entry.sizeBytes })).toBe(false);
+    // The same bytes without the tier would be compact: the entry is what changes the behaviour.
+    expect(isCompactModel({ sizeBytes: entry.sizeBytes })).toBe(true);
+  });
+  it("on a 4 GB phone it is held back like the 4B (default tier); open: a separate lite tier", () => {
+    expect(tooBigForAutoPick({ answerTier: entry.answerTier, sizeBytes: entry.sizeBytes }, 3.7 * 1024 ** 3)).toBe(true);
+    expect(tooBigForAutoPick({ answerTier: entry.answerTier, sizeBytes: entry.sizeBytes }, 8 * 1024 ** 3)).toBe(false);
+  });
+});
