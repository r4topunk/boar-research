+
+export function onHealthTopicWhy(topic: Set<string>, chunk: RetrievedChunk): string {
+  if (NON_HEALTH_SOURCE.test(chunk.title)) return "FAIL:non-health-source";
+  const action = (chunk as { action?: boolean }).action;
+  const act = action === true ? "T" : action === false ? "F" : "U";
+  const waterSafety = [...topic].some((t) => /^(contaminat|purif|disinfect|boil)/.test(t));
+  if (!waterSafety && [...topic].some((t) => DISASTER_TOPIC.test(t))) {
+    if (genericDisasterTitle(chunk.title, topic)) return "OK:disaster-generic-title";
+    return (action === true && titleNames(`${sectionHeading(chunk)} ${chunk.body}`, topic)) ? "OK:disaster-action-text" : `FAIL:disaster-not-generic(act=${act})`;
+  }
+  if (topic.size === 0) return `FAIL:topic-empty(act=${act})`;
+  if (titleNames(chunk.title, topic)) return "OK:title";
+  if (Object.keys(COMPOUNDS).some((c) => !topic.has(c) && new RegExp(`\\b${c}s?\\b`, "i").test(chunk.title))) return "FAIL:other-compound-title";
+  if ((action !== false || LAY_SOURCE.test(chunk.title)) && titleNames(sectionHeading(chunk), topic)) return "OK:section-heading";
+  const layHealth = FIRST_AID_SOURCE.test(chunk.title) || HEALTH_SECTION.test(sectionHeading(chunk)) || imperativeSteps(chunk.body) >= 1;
+  const textNames = titleNames(chunk.body.replace(/\p{L}+(?:-\p{L}+)+/gu, " "), topic);
+  if ((action === true || layHealth) && textNames) return `OK:text(act=${act},lay=${layHealth ? 1 : 0})`;
+  return `FAIL:no-title-no-section(act=${act},lay=${layHealth ? 1 : 0},textNames=${textNames ? 1 : 0},sec=${sectionHeading(chunk).slice(0, 30)})`;
+}
+
+
+export function r3Probe(query: string, chunk: RetrievedChunk): string {
+  const terms = new Set(tokenizeTerms(query).filter((t) => !GENERIC_TOPIC.has(t)));
+  const fam = /^pack:local-(boar-firstaid-en|boar-medlineplus-en|qa-health-se):/.test(chunk.chunkId) ? 1 : 0;
+  const ti = titleNames(chunk.title.replace(/^[^:]{1,30}:\s*/, ""), terms) ? 1 : 0;
+  const se = titleNames(sectionHeading(chunk), terms) ? 1 : 0;
+  return `fam=${fam},title=${ti},sec=${se},terms=${[...terms].slice(0, 8).join("/")}`;
+}
