+const T = { cos_min: 0.99, l2_rel_max: 0.02, p_abs_max: 0.05 };
+const l2 = (v: number[]) => Math.sqrt(v.reduce((s, x) => s + x * x, 0));
+const canaryItem = (text: string, lead: number) => {
