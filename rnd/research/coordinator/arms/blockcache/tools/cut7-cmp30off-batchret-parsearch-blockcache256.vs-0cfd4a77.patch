+    case "population":
+      // r3 gate 5: a figure dated before 2023 says so ("(dated 2021)").
+      return e.pop
+        ? { v: e.pop[0], text: `${millions(e.pop[0])}${e.pop[1] ? (e.pop[1] < 2023 ? ` (dated ${e.pop[1]})` : ` (${e.pop[1]})`) : ""}`, asOf: e.pop[1] }
