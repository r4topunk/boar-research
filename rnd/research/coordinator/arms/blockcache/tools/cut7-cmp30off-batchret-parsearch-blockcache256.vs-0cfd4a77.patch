+  it("passes the reference itself", () => {
+    expect(canaryCheck(ref, T, ref.vec, ref.p).ok).toBe(true);
+  });
+  it("fails a scaled vector with the same direction and p (the last-token pooling case: p passes, L2 doesn't)", () => {
