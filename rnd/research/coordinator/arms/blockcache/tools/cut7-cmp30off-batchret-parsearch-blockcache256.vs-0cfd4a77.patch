+    [1, 0, "Georgia", 10],
+    [2, 0, "georgia", 10],
+    [3, 1, "Paris", 5],
+    [4, 1, "PARIS", 9],
+    [5, 0, "New York City", 7],
+    [6, 1, "New York City", 3],
+    [7, 0, "Éire", 4],
+    [8, 0, "éire", 2],
