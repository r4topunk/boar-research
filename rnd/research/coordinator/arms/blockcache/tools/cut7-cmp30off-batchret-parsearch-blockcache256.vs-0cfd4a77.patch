+export async function nearestPlaceIn(db: PackSql, p: { lat: number; lon: number }): Promise<{ name: string; country?: string } | null> {
+  const dLat = 0.25;
+  const dLon = 0.25 / Math.max(0.2, Math.cos((p.lat * Math.PI) / 180));
