+function renderWhitelisted(rawName, parts) {
+  const name = rawName.replace(/_/g, " ");
+  const pos = parts.slice(1).filter((p) => !wvNamed(p)).map((p) => cleanInline(p.trim()));
+  const first = pos[0] ?? "";
