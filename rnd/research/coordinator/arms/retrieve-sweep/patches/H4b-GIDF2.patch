+/** FTS5 varints (1-9 bytes, big-endian 7-bit groups, high bit = more; a 9th byte carries 8 bits). Values here stay below 2^53. */
+export function rsVarints(b: Uint8Array): number[] {
+  const out: number[] = [];
+  for (let i = 0; i < b.length; ) {
+    let v = 0;
+    for (let k = 0; k < 9 && i < b.length; k++) {
+      const c = b[i++];
+      if (k === 8) { v = v * 256 + c; break; }
+      v = v * 128 + (c & 0x7f);
+      if (!(c & 0x80)) break;
+    }
+    out.push(v);
+  }
+  return out;
+}
