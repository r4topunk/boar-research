+/**
+ * RETRIEVE-SWEEP arm H4 (RS_MERGE=rrf): reciprocal rank fusion (k = 60, RS_RRF_K) of the per-pack keyword lists. Each pack keeps its
+ * top `topK` hits by its own rank; a hit scores 1/(k + rank). The pack lists share no chunk, so the fusion is a rank interleave
+ * (ties: the hit with the higher original score first). Scores are then put back on the scale the concatenated list had (the best
+ * original score is given to a rank-1 hit) so they stay comparable with the bundled corpus and format-1 pack lists in the fusion.
+ */
+export function rsRrfMerge(lists: RetrievedChunk[][], topK: number): RetrievedChunk[] {
+  const k = Number((globalThis as any).process?.env?.RS_RRF_K ?? 60);
+  const maxOrig = Math.max(...lists.flat().map((c) => c.score), 1e-9);
+  const merged = lists.flatMap((l) => l.slice(0, topK).map((c, i) => ({ c, rrf: 1 / (k + i + 1) })));
+  merged.sort((a, b) => b.rrf - a.rrf || b.c.score - a.c.score);
+  return merged.map(({ c, rrf }) => ({ ...c, score: (rrf * (k + 1)) * maxOrig }));
+}
