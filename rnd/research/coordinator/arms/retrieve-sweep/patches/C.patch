+  /** RETRIEVE-SWEEP arm C: the chunks of the article holding `chunkId` (start order, at most `max`), each with its int8 chunk
+   *  vector when the pack carries a chunk_vecs sidecar (null otherwise). */
+  async articleChunksOf(chunkId: number, max = 60): Promise<{ hit: PackHit; vec: Uint8Array | null }[]> {
+    const row = await this.db.getFirstAsync<{ article_id: number }>("SELECT article_id FROM chunks WHERE id = ?", [chunkId]);
+    if (!row) return [];
+    const rows = (
+      await this.db.getAllAsync<{ id: number; start: number; end: number }>("SELECT id, start, end FROM chunks WHERE article_id = ? ORDER BY start", [row.article_id])
+    ).slice(0, max);
+    const vecs = new Map<number, Uint8Array>();
+    if (this.hasChunkVecs && rows.length) {
+      const vr = await this.db.getAllAsync<{ chunk_id: number; vec: Uint8Array }>(
+        `SELECT chunk_id, vec FROM chunk_vecs WHERE chunk_id IN (${rows.map(() => "?").join(",")})`,
+        rows.map((r) => r.id)
+      );
+      for (const v of vr) vecs.set(v.chunk_id, new Uint8Array(v.vec));
+    }
+    return Promise.all(rows.map(async (r) => ({ hit: await this.hit(row.article_id, r.id, r.start, r.end, 0, "semantic"), vec: vecs.get(r.id) ?? null })));
+  }
