+/** RETRIEVE-SWEEP arm C: the other chunks of a format-2 pack passage's article, as retrieved passages, with their int8 chunk
+ *  vectors when the pack has them; [] for a non-pack chunk or a pack that is not open. */
+export async function rsArticleChunks(chunkId: string): Promise<{ chunk: RetrievedChunk; vec: Uint8Array | null }[]> {
+  const m = /^pack:([^:]+):(\d+)$/.exec(chunkId);
+  if (!m) return [];
+  const wp = wikiPacks.get(m[1]);
+  if (!wp) return [];
+  return (await wp.articleChunksOf(Number(m[2]))).map(({ hit, vec }) => ({ chunk: packHitToChunk(m[1], hit), vec }));
+}
