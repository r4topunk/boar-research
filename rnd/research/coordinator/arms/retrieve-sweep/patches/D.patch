+/** RETRIEVE-SWEEP arm D: `list` in order, keeping at most 2 chunks per docId and 4 per source family. */
+const RS_LIBRARY = /^(Wikipedia|Wikibooks|Wikivoyage|US government|Appropedia|ethereum\.org|Ethereum EIPs\/ERCs|Ethereum specs|Bitcoin BIPs):\s*/;
+export function rsDiversityCap(list: RetrievedChunk[], perArticle = 2, perFamily = 4): RetrievedChunk[] {
+  const art = new Map<string, number>();
+  const fam = new Map<string, number>();
+  return list.filter((c) => {
+    const a = c.docId ?? c.chunkId;
+    const f = c.title.replace(RS_LIBRARY, "").split(/ — |:/)[0].trim().toLowerCase();
+    if ((art.get(a) ?? 0) >= perArticle || (fam.get(f) ?? 0) >= perFamily) return false;
+    art.set(a, (art.get(a) ?? 0) + 1);
+    fam.set(f, (fam.get(f) ?? 0) + 1);
+    return true;
+  });
