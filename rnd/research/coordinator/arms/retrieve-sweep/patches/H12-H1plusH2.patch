+import { afterEach, describe, expect, it } from "vitest";
+import { healthTopicTerms, onHealthTopic } from "./context";
+import { regexCondition } from "./conditionCards";
+import { healthTopicFallback } from "./healthTopicFallback";
+
+// RETRIEVE-SWEEP arm H2. The switch is read at call time; unset = healthTopicTerms unchanged.
+const c = (title: string, body: string, action?: boolean) => ({ chunkId: title, docId: title, title, body, score: 1, matchType: "lexical" as const, ...(action === undefined ? {} : { action }) });
+const env = (globalThis as any).process.env as Record<string, string | undefined>;
+afterEach(() => { delete env.RS_HEALTH_TOPIC_FB; });
+
+const JELLY = "My friend just got stung by a jellyfish while swimming in Thailand. Should I pour vinegar or fresh water on it?";
+const ALT = "I'm at 4,000 m in the Andes with a headache and nausea. What should I do?";
+
+describe("healthTopicFallback", () => {
+  it("is healthTopicTerms exactly when the switch is off", () => {
+    for (const q of [JELLY, ALT, "How do I treat a burn on my arm?", "What is the capital of Australia?"]) {
+      const codes: string[] = [];
+      expect([...healthTopicFallback(q, null, codes)].sort()).toEqual([...healthTopicTerms(q, null)].sort());
+      expect(codes).toEqual([]);
+    }
+  });
+
+  it("jellyfish: the empty topic gets the card's terms and the jellyfish article passes", () => {
+    expect(healthTopicTerms(JELLY, null).size).toBe(0);
+    env.RS_HEALTH_TOPIC_FB = "1";
+    const codes: string[] = [];
+    const t = healthTopicFallback(JELLY, null, codes);
+    expect(t.has("jellyfish")).toBe(true);
+    expect(t.has("sting")).toBe(true);
+    expect(t.has("stung")).toBe(true);
+    expect(codes.some((x) => x.startsWith("rs:health-topic-fb:"))).toBe(true);
+    expect(onHealthTopic(t, c("Jellyfish", "Jellyfish stings are treated with vinegar."))).toBe(true);
+    expect(onHealthTopic(healthTopicTerms(JELLY, null), c("Jellyfish", "Jellyfish stings are treated with vinegar."))).toBe(false);
+  });
+
+  it("jellyfish mode 2 keeps only the distinctive term", () => {
+    env.RS_HEALTH_TOPIC_FB = "2";
+    expect([...healthTopicFallback(JELLY, null)]).toEqual(["jellyfish"]);
+  });
+
+  it("altitude: a symptom-only topic gets the condition added", () => {
+    env.RS_HEALTH_TOPIC_FB = "1";
+    const t = healthTopicFallback(ALT, null);
+    for (const w of ["altitude", "hace", "hape"]) expect(t.has(w), w).toBe(true);
+    expect(onHealthTopic(t, c("Wikivoyage: Altitude sickness", "Altitude sickness is common above 2,500 m.", false))).toBe(true);
+    expect(onHealthTopic(t, c("Wikivoyage: Vung Tau", "Rub isopropyl alcohol in the ear after swimming."))).toBe(false);
+  });
+
+  it("a health question with no card and a topic already named is unchanged", () => {
+    env.RS_HEALTH_TOPIC_FB = "1";
+    const q = "What are the symptoms of dehydration and what is the dosage of oral rehydration salts?";
+    const codes: string[] = [];
+    expect([...healthTopicFallback(q, null, codes)].sort()).toEqual([...healthTopicTerms(q, null)].sort());
+    expect(codes).toEqual([]);
+  });
+
+  it("an empty topic with a venomous animal and no card gets the animal (b)", () => {
+    env.RS_HEALTH_TOPIC_FB = "1";
+    const q = "A spider bit my toddler, is it grave?";
+    expect(healthTopicTerms(q, null).has("spider")).toBe(false);
+    const codes: string[] = [];
+    expect(healthTopicFallback(q, null, codes).has("spider")).toBe(true);
+    expect(codes.length).toBe(1);
+  });
+
+  it("MULTI conditions add nothing from the card", () => {
+    env.RS_HEALTH_TOPIC_FB = "1";
+    const q = "My son had a seizure and burned his hand on a hot stove, what do I do?";
+    expect(regexCondition(q)).toBe("MULTI");
+    const codes: string[] = [];
+    expect([...healthTopicFallback(q, null, codes)].sort()).toEqual([...healthTopicTerms(q, null)].sort());
+  });
+});
