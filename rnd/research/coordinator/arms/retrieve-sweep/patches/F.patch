+/** RETRIEVE-SWEEP arm B: stop, wh- and auxiliary words left out of a question's keyword form. */
+const RS_KEYQ_STOP = new Set(
+  ("a an the and or but if then than so of to in on at by for with from into onto about as over under after before during between " +
+   "what which who whom whose when where why how is are was were be been being am do does did doing done have has had having " +
+   "can could will would shall should may might must i me my mine we us our you your he him his she her it its they them their " +
+   "this that these those there here not no yes any some all each one also just very really please tell know want need get " +
+   "explain describe give show list let lets s t i'm im i've ive i'd i'll it's that's what's don't doesn't isn't up out too much " +
+   "many more most right now roughly really like ok okay")
+    .split(" ")
+);
+/** The question's content words in order (stop/wh/aux words removed), at most 6, duplicates dropped. */
+export function keywordForm(query: string): string {
+  const out: string[] = [];
+  const seen = new Set<string>();
+  for (const w of query.match(/[\p{L}\p{N}][\p{L}\p{N}'’,.-]*[\p{L}\p{N}]|[\p{L}\p{N}]/gu) ?? []) {
+    const k = w.toLowerCase().replace(/’/g, "'").replace(/'s$/, "");
+    if (k.length < 2 || RS_KEYQ_STOP.has(k) || seen.has(k)) continue;
+    seen.add(k);
+    out.push(w.replace(/['’]s$/, "").replace(/[,.]/g, (m, i, str) => (/\d/.test(str[i - 1] ?? "") && /\d/.test(str[i + 1] ?? "") ? m : "")));
+    if (out.length >= 6) break;
+  }
+  return out.join(" ");
+}
