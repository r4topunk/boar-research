+/** The question's content words in order (stop/wh/aux words removed), at most 6, duplicates dropped. */
+export function keywordForm(query: string): string {
+  const out: string[] = [];
+  const seen = new Set<string>();
+  for (const w of query.match(/[\p{L}\p{N}][\p{L}\p{N}'’,.-]*[\p{L}\p{N}]|[\p{L}\p{N}]/gu) ?? []) {
+    const k = w.toLowerCase().replace(/’/g, "'").replace(/'s$/, "");
+    if (k.length < 2 || RS_KEYQ_STOP.has(k) || seen.has(k)) continue;
+    seen.add(k);
+    out.push(w.replace(/['’]s$/, "").replace(/[,.]/g, (m, i, str) => (/\d/.test(str[i - 1] ?? "") && /\d/.test(str[i + 1] ?? "") ? m : "")));
+    if (out.length >= 6) break;
+  }
+  return out.join(" ");
+}
