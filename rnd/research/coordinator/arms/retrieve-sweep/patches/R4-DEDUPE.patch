+/**
+ * SEARCHPAR arm R4 (RS_DEDUPE=0.9, bench-only, default off = unchanged): near-duplicate filter on the ranked candidate list. A candidate is
+ * dropped when at least `min` of its 8-word shingles (lower-cased word runs of the body; a body under 8 words is one shingle) also occur in
+ * a higher-ranked candidate that was kept, so a Stack Exchange thread that repeats another thread's answer does not take a second slot.
+ * `against` seeds the kept set (the list the candidates join). Appends one line per call to RS_DEDUPE_LOG when set.
+ */
+const rsShingles = (text: string): Set<string> => {
+  const w = text.toLowerCase().match(/[\p{L}\p{N}]+/gu) ?? [];
+  const out = new Set<string>();
+  if (w.length < 8) { out.add(w.join(" ")); return out; }
+  for (let i = 0; i + 8 <= w.length; i++) out.add(w.slice(i, i + 8).join(" "));
+  return out;
+};
+export function rsNearDup<T extends { chunkId: string; body: string }>(list: T[], min: number, against: T[] = []): { kept: T[]; dropped: { id: string; of: string; share: number }[] } {
+  const keptSets: { id: string; sh: Set<string> }[] = against.map((c) => ({ id: c.chunkId, sh: rsShingles(c.body) }));
+  const kept: T[] = [];
+  const dropped: { id: string; of: string; share: number }[] = [];
+  for (const c of list) {
+    const sh = rsShingles(c.body);
+    let hit: { id: string; share: number } | null = null;
+    for (const k of keptSets) {
+      let n = 0;
+      for (const x of sh) if (k.sh.has(x)) n++;
+      const share = n / sh.size;
+      if (share >= min) { hit = { id: k.id, share }; break; }
+    }
+    if (hit) dropped.push({ id: c.chunkId, of: hit.id, share: hit.share });
+    else { kept.push(c); keptSets.push({ id: c.chunkId, sh }); }
+  }
+  return { kept, dropped };
+}
+function rsDedupeMin(): number {
+  const v = Number((globalThis as any).process?.env?.RS_DEDUPE ?? 0);
+  return v > 0 && v <= 1 ? v : 0;
 }
+function rsDedupeLog(stage: string, query: string, topK: number, dropped: { id: string; of: string; share: number }[]) {
+  const f = (globalThis as any).process?.env?.RS_DEDUPE_LOG;
+  if (!f) return;
+  try { (globalThis as any).process.getBuiltinModule("node:fs").appendFileSync(f, JSON.stringify({ stage, query, topK, n: dropped.length, dropped }) + "\n"); } catch {}
+}
 
