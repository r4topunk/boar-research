+
+/**
+ * SEARCHPAR arm R1 DENSE-RERANK (RS_RERANK=cos|mix). The candidate pool is the engine's list `raw` (k, plus any dense "extra"
+ * slots) united with the wider list `wide` (k = 12, no dense extras), one copy per chunkId. Every candidate gets the cosine
+ * between the question's vector and its own vector: the chunk_vecs vector of a format-2 pack chunk, else its article's lead
+ * vector, else (bundled corpus, format-1 packs) the similarity retrieve() already computed, else an on-the-fly embedding of
+ * "title\nbody" (first 1500 chars). cos: the pool is re-ordered by that cosine (ties: pool order). mix: 0.5 * rank in the
+ * pool order (raw in its own order, then the wide-only candidates in wide order) + 0.5 * cosine rank (ties: pool order).
+ * The first |raw| candidates of the new order are returned, so the list keeps the engine's length.
+ */
+export async function rsRerank(
+  query: string,
+  raw: RetrievedChunk[],
+  wide: RetrievedChunk[],
+  mode: "cos" | "mix",
+  queryVecIn?: Float32Array
+): Promise<RetrievedChunk[]> {
+  const queryVec = queryVecIn ?? (await embeddingEngine.embed(query));
+  const seen = new Set<string>();
+  const pool = [...raw, ...wide].filter((c) => !seen.has(c.chunkId) && (seen.add(c.chunkId), true));
+  const packCos = await rsPackCosines(pool, queryVec);
+  const cos: number[] = [];
+  const kinds: string[] = [];
+  for (const c of pool) {
+    const p = packCos.get(c.chunkId);
+    if (p) (cos.push(p.cos), kinds.push(p.kind));
+    else if (typeof c.similarity === "number" && Number.isFinite(c.similarity)) (cos.push(c.similarity), kinds.push("sim"));
+    else (cos.push(cosineSimilarity(queryVec, await embeddingEngine.embed(`${c.title}\n${c.body}`.slice(0, 1500)))), kinds.push("embed"));
+  }
+  const idx = pool.map((_, i) => i);
+  const cosOrder = [...idx].sort((a, b) => cos[b] - cos[a] || a - b);
+  let order = cosOrder;
+  if (mode === "mix") {
+    const cosRank = new Array<number>(pool.length);
+    cosOrder.forEach((i, r) => (cosRank[i] = r));
+    const mixed = idx.map((i) => 0.5 * i + 0.5 * cosRank[i]);
+    order = [...idx].sort((a, b) => mixed[a] - mixed[b] || a - b);
+  }
+  const out = order.slice(0, raw.length).map((i) => pool[i]);
+  const logPath = (globalThis as any).process?.env?.RS_RERANK_LOG;
+  if (logPath) {
+    try {
+      (globalThis as any).process.getBuiltinModule("node:fs").appendFileSync(
+        logPath,
+        JSON.stringify({ q: query, mode, raw: raw.map((c) => c.chunkId), pool: pool.map((c, i) => [c.chunkId, +cos[i].toFixed(4), kinds[i]]), out: out.map((c) => c.chunkId) }) + "\n"
+      );
+    } catch {}
+  }
+  return out;
+}
