+/**
+ * RS_RERANK (RETRIEVE-SWEEP arm R1, bench-only): cosine between the question's vector and the vector of each format-2 pack
+ * chunk in `chunks` (map chunkId -> cosine): the chunk's own chunk_vecs vector when its pack has the sidecar and a row for it,
+ * else its article's lead vector; a chunk with neither (or not from a format-2 pack) is left out of the map.
+ */
+export async function rsPackCosines(chunks: RetrievedChunk[], queryVec: Float32Array): Promise<Map<string, { cos: number; kind: "chunk" | "lead" }>> {
+  const out = new Map<string, { cos: number; kind: "chunk" | "lead" }>();
+  const byPack = new Map<string, { chunkId: string; cid: number; aid: number }[]>();
+  for (const c of chunks) {
+    const m = /^pack:([^:]+):(\d+)$/.exec(c.chunkId);
+    const a = /^pack:[^:]+:a(\d+)$/.exec(c.docId ?? "");
+    if (!m || !a) continue;
+    (byPack.get(m[1]) ?? byPack.set(m[1], []).get(m[1])!).push({ chunkId: c.chunkId, cid: Number(m[2]), aid: Number(a[1]) });
+  }
+  for (const [packId, rows] of byPack) {
+    const wp = wikiPacks.get(packId);
+    if (!wp) continue;
+    const cv = await wp.rsChunkVectors(rows.map((r) => r.cid));
+    const missing = rows.filter((r) => !cv.has(r.cid));
+    const lv = missing.length ? await wp.leadVectors([...new Set(missing.map((r) => r.aid))]) : new Map<number, Uint8Array>();
+    for (const r of rows) {
+      const v = cv.get(r.cid);
+      if (v) out.set(r.chunkId, { cos: cosineSimilarityInt8(queryVec, v), kind: "chunk" });
+      else {
+        const l = lv.get(r.aid);
+        if (l) out.set(r.chunkId, { cos: cosineSimilarityInt8(queryVec, l), kind: "lead" });
+      }
+    }
+  }
+  return out;
+}
