--- be-0cfd4a77-cut7-litepacks/src/routing/healthTopicFallback.ts	1969-12-31 21:00:00
+++ rs-H2/src/routing/healthTopicFallback.ts	2026-10-22 16:06:57
@@ -0,0 +1,89 @@
+/**
+ * RETRIEVE-SWEEP arm H2 HEALTH-TOPIC-FALLBACK (bench-only, env switch RS_HEALTH_TOPIC_FB, default off = healthTopicTerms unchanged).
+ *
+ * health-strict (answer.ts) keeps only sources whose title (or, for lay sources, text) names the question's health topic, and
+ * healthTopicTerms() builds that topic from the lexical HEALTH regex only. The learned detector and the card-condition
+ * trigger fire on questions the regex misses ("stung by a jellyfish", "at 4,000 m ... headache and nausea"), so the topic is
+ * empty or symptom-only and every retrieved passage, the Altitude sickness article included, is dropped as off-topic.
+ *
+ * healthTopicFallback(query, english, userTurns) = healthTopicTerms plus
+ *  (a) the term list of the first-aid condition card the question (or, for a follow-up, the conversation) names, and
+ *  (b) when the set is still empty, the venomous animal / sting-bite words the detector matched.
+ * RS_HEALTH_TOPIC_FB=1: full lists (spec); =2: distinctive terms only (no sting/sickness/mountain-type generic words).
+ * onHealthTopic is not changed.
+ */
+import { COMPOUNDS, GENERIC_TOPIC, STUNG_OR_RISK, VENOMOUS, healthTopicTerms, tokenizeTerms } from "./context";
+import { conversationCondition } from "./conditionCards";
+
+/** Condition card key -> its name / alias / title words (Wikipedia, Wikivoyage, first-aid book titles). */
+export const CARD_TOPIC_TERMS: Record<string, string> = {
+  co: "carbon monoxide poisoning",
+  burn: "burn scald",
+  heatstroke: "heatstroke heat stroke",
+  hypothermia: "hypothermia",
+  frostbite: "frostbite frostnip",
+  choking: "choking heimlich",
+  chokinginfant: "choking heimlich",
+  bleeding: "bleeding hemorrhage",
+  heartattack: "heart attack myocardial infarction cardiac",
+  stroke: "stroke",
+  seizure: "seizure epilepsy convulsion",
+  anaphylaxis: "anaphylaxis allergic reaction",
+  battery: "button battery ingestion",
+  eyechem: "chemical burn eye",
+  electric: "electrical injury electrocution shock",
+  jellyfish: "jellyfish sting stings stung",
+  nosebleed: "nosebleed epistaxis",
+  earthquake: "earthquake",
+  tsunami: "tsunami",
+  drowning: "drowning",
+  hypoglycemia: "hypoglycemia",
+  altitude: "altitude sickness acute mountain sickness hace hape",
+  beesting: "bee wasp hornet sting",
+  scorpion: "scorpion sting",
+  scorpionadult: "scorpion sting",
+  marinepuncture: "stingray sea urchin stonefish",
+  tick: "tick",
+  animalbite: "animal bite rabies",
+  heatexhaustion: "heat exhaustion heat cramps",
+  headinjury: "head injury concussion",
+  ripcurrent: "rip current",
+  snakebite: "snakebite snake bite",
+};
+
+/** Generic words dropped from the card lists in mode 2 (they name no condition on their own in a title). */
+const GENERIC_ALIAS = new Set(tokenizeTerms("acute sting stings stung sickness mountain reaction attack heart carbon blood low shock chemical eye button battery injury electrical allergic heat animal cramps head rip current"));
+
+const mode = (): number => {
+  const v = Number((globalThis as any).process?.env?.RS_HEALTH_TOPIC_FB ?? "");
+  return v === 1 || v === 2 ? v : 0;
+};
+
+export function healthTopicFallback(query: string, english: string | null, reasonCodes?: string[], userTurns: string[] = []): Set<string> {
+  const t = healthTopicTerms(query, english);
+  const m = mode();
+  if (!m) return t;
+  const before = t.size;
+  const add = (src: string) => {
+    for (const w of tokenizeTerms(src)) if (!GENERIC_TOPIC.has(w) && !(m === 2 && GENERIC_ALIAS.has(w))) t.add(w);
+  };
+  // (a) the card the matcher names (several conditions = MULTI = none)
+  const { condition } = conversationCondition(query, userTurns);
+  if (condition && condition !== "MULTI" && CARD_TOPIC_TERMS[condition]) add(CARD_TOPIC_TERMS[condition]);
+  // (b) still nothing: the animal the detector matched (VENOMOUS) and, in mode 1, the sting / bite words next to it
+  // (STUNG_OR_RISK without its child / severity words, and never "a bit" or "picked"). Only when the animal side fired.
+  if (t.size === 0) {
+    const animals = query.match(new RegExp(VENOMOUS.source, "giu")) ?? [];
+    if (animals.length) {
+      add(animals.join(" "));
+      if (m === 1) add((query.replace(/\ba (little )?bit\b/gi, " ").match(new RegExp(STUNG_OR_RISK.source, "giu")) ?? []).filter((w) => /^(stung|sting|bit|bite|bitten)/i.test(w.trim())).join(" "));
+    }
+  }
+  // "snakebite snake bite": the parts only count together, as in healthTopicTerms.
+  for (const [compound, parts] of Object.entries(COMPOUNDS)) if (t.has(compound)) parts.forEach((p) => t.delete(p));
+  if (t.size > before && reasonCodes) {
+    const code = `rs:health-topic-fb:${[...t].sort().join(",")}`;
+    if (!reasonCodes.includes(code)) reasonCodes.push(code);
+  }
+  return t;
+}
