+  /** W78C: exact int8 cosine (same arithmetic as the exact scan and W78B) of the given article ids, visited in the given order; top `keep` (ties: visit order). */
+  private async rsExactRescore(queryVec: Float32Array, candIds: number[], keep: number) {
+    const dims = queryVec.length;
+    const rows = candIds.length
+      ? await this.db.getAllAsync<{ article_id: number; vec: Uint8Array }>(`SELECT article_id, vec FROM lead_vecs WHERE article_id IN (${candIds.map(() => "?").join(",")})`, candIds)
+      : [];
+    const byId = new Map(rows.map((r) => [r.article_id, r.vec]));
+    let qn = 0;
+    for (let d = 0; d < dims; d++) qn += queryVec[d] * queryVec[d];
+    qn = Math.sqrt(qn) || 1;
+    const top: Array<{ id: number; s: number }> = [];
+    for (const id of candIds) {
+      const raw = byId.get(id);
+      if (!raw) continue;
+      const vv = new Int8Array(raw.buffer, raw.byteOffset, dims);
+      let nn = 0;
+      for (let d = 0; d < dims; d++) nn += vv[d] * vv[d];
+      const norm = Math.fround(Math.sqrt(nn));
+      let dot = 0;
+      for (let d = 0; d < dims; d++) dot += queryVec[d] * vv[d];
+      const s = norm ? dot / (qn * norm) : 0;
+      if (top.length < keep || s > top[top.length - 1].s) {
+        let j = top.length < keep ? top.length : top.length - 1;
+        if (top.length < keep) top.push({ id, s });
+        while (j > 0 && top[j - 1].s < s) (top[j] = top[j - 1]), j--;
+        top[j] = { id, s };
+      }
+    }
+    return { top, rows: rows.length };
+  }
+
+  /**
+   * W78C-DENSE: IVF-256 stage 1 over the int8 lead matrix (<manifest16>.ivf256 in RS_DENSE_Q_DIR, tools/build_ivf.py): cosine of the query to the k centroids,
+   * the `nprobe` best lists (ties: lower list), exact int8 cosine of their member rows in ascending row order from the resident matrix, top m. Null: no sidecar.
+   */
+  private async rsDenseStage1Ivf(queryVec: Float32Array, m: number, nprobe: number) {
+    const dims = queryVec.length;
+    let loadMs = 0;
+    if (this.rsIvf === undefined) {
+      const fs = await import("node:fs");
+      const env = (globalThis as any).process?.env;
+      const path = `${env?.RS_DENSE_Q_DIR ?? "."}/${String(this.meta.manifestSha256 ?? "").slice(0, 16)}.ivf256`;
+      if (!fs.existsSync(path)) this.rsIvf = null;
+      else {
+        const t = Date.now();
+        const buf = fs.readFileSync(path);
+        const ab = buf.buffer.slice(buf.byteOffset, buf.byteOffset + buf.byteLength);
+        const hdr = new DataView(ab, 8, 12);
+        const n = hdr.getUint32(0, true), k = hdr.getUint32(8, true);
+        if (hdr.getUint32(4, true) !== dims) throw new Error(`W78C: ${path} dims mismatch`);
+        let o = 20;
+        const ids = new Int32Array(ab, o, n); o += 4 * n;
+        const cents = new Float32Array(ab, o, k * dims); o += 4 * k * dims;
+        const start = new Uint32Array(ab, o, k + 1); o += 4 * (k + 1);
+        const rows = new Uint32Array(ab, o, n);
+        const lm = this.leadMatrix!;
+        if (lm.ids.length !== n || lm.ids.some((v, i) => v !== ids[i])) throw new Error(`W78C: ${path} ids differ from lead_vecs`);
+        this.rsIvf = { ids, cents, start, rows, n, k, fileBytes: buf.byteLength };
+        loadMs = Date.now() - t;
+      }
+    }
+    const iv = this.rsIvf;
+    if (!iv) return null;
+    const tScan = Date.now();
+    const cs: Array<{ j: number; s: number }> = [];
+    for (let j = 0; j < iv.k; j++) {
+      let dot = 0;
+      const o = j * dims;
+      for (let d = 0; d < dims; d++) dot += queryVec[d] * iv.cents[o + d];
+      cs.push({ j, s: dot });
+    }
+    cs.sort((a, b) => b.s - a.s || a.j - b.j);
+    const members: number[] = [];
+    for (const { j } of cs.slice(0, nprobe)) for (let r = iv.start[j]; r < iv.start[j + 1]; r++) members.push(iv.rows[r]);
+    members.sort((a, b) => a - b);
+    const tCent = Date.now();
+    const { ids, vecs, norms } = this.leadMatrix!;
+    let qn = 0;
+    for (let d = 0; d < dims; d++) qn += queryVec[d] * queryVec[d];
+    qn = Math.sqrt(qn) || 1;
+    const top: Array<{ id: number; s: number }> = [];
+    for (const i of members) {
+      let dot = 0;
+      const o = i * dims;
+      for (let d = 0; d < dims; d++) dot += queryVec[d] * vecs[o + d];
+      const s = norms[i] ? dot / (qn * norms[i]) : 0;
+      if (top.length < m || s > top[top.length - 1].s) {
+        let j = top.length < m ? top.length : top.length - 1;
+        if (top.length < m) top.push({ id: ids[i], s });
+        while (j > 0 && top[j - 1].s < s) (top[j] = top[j - 1]), j--;
+        top[j] = { id: ids[i], s };
+      }
+    }
+    return { top, scanMs: Date.now() - tScan, hamMs: tCent - tScan, loadMs, scanBytes: iv.k * dims * 4 + members.length * dims, residentBytes: iv.fileBytes, rows: iv.n, rescoreRows: members.length };
+  }
