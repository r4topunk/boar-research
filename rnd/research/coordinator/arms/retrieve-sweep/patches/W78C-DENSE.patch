+  /**
+   * W78C-DENSE: stage 1 through a per-row-scaled 4-bit or 2-bit sidecar (<manifest16>.lead4 / .lead2 in RS_DENSE_Q_DIR, tools/build_leadq.py): approximate
+   * score of every row by a per-query lookup table, the `qn` best (ties: lower row), exact int8 cosine of only those rows in row order, top min(m, qn).
+   * Returns null when the pack has no sidecar (the caller then runs the exact scan).
+   */
+  private async rsDenseStage1Q(queryVec: Float32Array, m: number, bits: number, qn: number) {
+    const dims = queryVec.length;
+    const env = (globalThis as any).process?.env;
+    let loadMs = 0;
+    if (!(bits in this.rsLeadQ)) {
+      const fs = await import("node:fs");
+      const path = `${env?.RS_DENSE_Q_DIR ?? "."}/${String(this.meta.manifestSha256 ?? "").slice(0, 16)}.lead${bits}`;
+      if (!fs.existsSync(path)) this.rsLeadQ[bits] = null;
+      else {
+        const t = Date.now();
+        const buf = fs.readFileSync(path);
+        const ab = buf.buffer.slice(buf.byteOffset, buf.byteOffset + buf.byteLength);
+        const hdr = new DataView(ab, 8, 8);
+        const n = hdr.getUint32(0, true);
+        if (hdr.getUint32(4, true) !== dims) throw new Error(`W78C: ${path} dims mismatch`);
+        this.rsLeadQ[bits] = { ids: new Int32Array(ab, 16, n), factor: new Float32Array(ab, 16 + 4 * n, n), codes: new Uint8Array(ab, 16 + 8 * n, (n * dims * bits) / 8), n, fileBytes: buf.byteLength };
+        loadMs = Date.now() - t;
+      }
+    }
+    const sc = this.rsLeadQ[bits];
+    if (!sc) return null;
+    const tScan = Date.now();
+    const per = 8 / bits; // dims per byte
+    const P = dims / per; // bytes per row
+    const lut = new Float32Array(P * 256);
+    for (let p = 0; p < P; p++)
+      for (let b = 0; b < 256; b++) {
+        let v = 0;
+        if (bits === 4) v = queryVec[2 * p] * ((b & 15) - 8) + queryVec[2 * p + 1] * ((b >> 4) - 8);
+        else for (let j = 0; j < 4; j++) v += queryVec[4 * p + j] * (2 * ((b >> (2 * j)) & 3) - 3);
+        lut[p * 256 + b] = v;
+      }
+    const { ids, factor, codes, n } = sc;
+    const want = Math.min(qn, n);
+    const best: Array<{ i: number; s: number }> = [];
+    for (let i = 0; i < n; i++) {
+      let a = 0;
+      const o = i * P;
+      for (let p = 0; p < P; p++) a += lut[(p << 8) | codes[o + p]];
+      const s = a * factor[i];
+      if (best.length < want || s > best[best.length - 1].s) {
+        let j = best.length < want ? best.length : best.length - 1;
+        if (best.length < want) best.push({ i, s });
+        while (j > 0 && best[j - 1].s < s) (best[j] = best[j - 1]), j--;
+        best[j] = { i, s };
+      }
+    }
+    const tApprox = Date.now();
+    const candIds = best.map((x) => x.i).sort((x, y) => x - y).map((i) => ids[i]);
+    const top = await this.rsExactRescore(queryVec, candIds, Math.min(m, qn));
+    return { top: top.top, scanMs: Date.now() - tScan, hamMs: tApprox - tScan, loadMs, scanBytes: n * (P + 4) + top.rows * dims, residentBytes: sc.fileBytes, rows: n, rescoreRows: top.rows };
+  }
