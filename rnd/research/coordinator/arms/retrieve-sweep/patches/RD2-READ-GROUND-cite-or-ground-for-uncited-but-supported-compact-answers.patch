+/**
+ * READ-GROUND (READER arm RD2, bench-only behind BOAR_READ_GROUND=1; default off = unchanged): cite-or-ground for a
+ * compact-model answer that carries no [n] at all after attribution. When at least half of its claim sentences
+ * (and at least one) are supported by an on-topic kept source at `bar` (below the ATTRIBUTION_MIN_SUPPORT bar the
+ * sentence-by-sentence pass already used, so only sentences it left alone are reached), each gets that source's [n]
+ * and the answer is not treated as memory. Guards: a source is eligible only if its title or body shares a key
+ * term with the query (off-topic neighbours never get cited); every number token in a sentence must appear in the
+ * source's title+body (memory figures never get a source). Otherwise the text is returned unchanged.
+ */
+const numberTokens = (text: string): string[] =>
+  (text.match(/\d[\d,.]*/g) ?? []).map((t) => t.replace(/,/g, "").replace(/\.+$/, "")).filter((t) => t.length > 0);
+
+export function groundUncited(answer: string, sources: RetrievedChunk[], query: string, bar = 0.6): AttributedCitations {
+  const none = { text: answer, added: [] as number[] };
+  if (!sources.length || !answer.trim()) return none;
+  const queryKeys = keyTerms(query);
+  const eligible = sources.map((s) => {
+    const have = terms(`${s.title} ${s.body}`);
+    return queryKeys.some((q) => have.some((h) => same(h, q)));
+  });
+  if (!eligible.some(Boolean)) return none;
+  const bodyNums = sources.map((s) => new Set(numberTokens(`${s.title} ${s.body}`)));
+  const picks = new Map<number, number>(); // sentence start offset -> source index
+  let claims = 0;
+  answer.replace(/(?:[^.!?\n]|(?<=\d)\.(?=\d))+[.!?]*/g, (sentence: string, at: number) => {
+    if (keyTerms(sentence).length < MIN_KEY_TERMS) return sentence;
+    if (/^\s*(#{1,6}\s|\*\*[^*]+\*\*\s*:?\s*$)/.test(sentence)) return sentence;
+    claims++;
+    const nums = numberTokens(sentence);
+    let best = -1;
+    let bestSupport = 0;
+    sources.forEach((source, i) => {
+      if (!eligible[i]) return;
+      if (nums.some((n) => !bodyNums[i].has(n))) return;
+      const support = citationSupport(sentence, source);
+      if (support >= bar && support > bestSupport) {
+        best = i;
+        bestSupport = support;
+      }
+    });
+    if (best >= 0) picks.set(at, best);
+    return sentence;
+  });
+  if (claims === 0 || picks.size === 0 || picks.size / claims < 0.5) return none;
+  const added: number[] = [];
+  const text = answer.replace(/(?:[^.!?\n]|(?<=\d)\.(?=\d))+[.!?]*/g, (sentence: string, at: number) => {
+    const best = picks.get(at);
+    if (best === undefined) return sentence;
+    added.push(best + 1);
+    const m = /^(.*?)(\s*)([.!?]*)(\s*)$/s.exec(sentence)!;
+    return `${m[1]} [${best + 1}]${m[3]}${m[4]}`;
+  });
+  return { text: dedupeCitations(text), added };
+}
+
 /** The same [n] twice around one sentence end ("… Zone [1]. [1]", "… [1] [1].") is shown once (Prism CIT-2). */
 export function dedupeCitations(text: string): string {
   return text.replace(/\[(\d+)\][ \t]*([.!?]?)[ \t]*\[\1\]/g, "[$1]$2");
