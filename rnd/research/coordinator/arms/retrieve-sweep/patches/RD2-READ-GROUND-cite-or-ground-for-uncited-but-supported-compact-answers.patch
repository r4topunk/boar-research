@@ -0,0 +1,70 @@
+import { describe, expect, it } from "vitest";
+import { groundUncited } from "./citations";
+
+const chunk = (id: string, title: string, body: string) => ({ chunkId: id, docId: id, title, body, score: 1, matchType: "lexical" as const });
+
+// Shapes of the READER arm RD2 pre-count (F1b kept chunks, answers without any [n]).
+const moose = chunk("m1", "Moose", "The moose or elk (Alces alces) is the world's tallest, largest and heaviest extant species of deer. Most adult male moose weigh between 380 and 700 kg.");
+const bison = chunk("b1", "American bison", "The American bison is a species of bison, a bovine mammal. Adult males weigh up to 1,270 kg, making the bison the heaviest land animal in North America.");
+const tiger = chunk("t1", "Siberian tiger", "The average historical wild male Siberian tiger weighed 215.3 kg and the female 137.5 kg.");
+
+describe("groundUncited (READ-GROUND)", () => {
+  it("lan-cmp-004 shape: a supported comparison answer gets the [n] of the bison chunk", () => {
+    const q = "Which weighs more on average, an adult male moose or an adult male American bison?";
+    const a = "An adult male American bison weighs up to 1,270 kg, so the bison is the heaviest land animal in North America.";
+    const out = groundUncited(a, [moose, bison, tiger], q);
+    expect(out.added).toEqual([2]);
+    expect(out.text).toBe("An adult male American bison weighs up to 1,270 kg, so the bison is the heaviest land animal in North America [2].");
+  });
+
+  it("lan-rsn-004 shape: a memory number absent from the sources gets no [n] (numeric guard)", () => {
+    const pop = chunk("p1", "Human overpopulation", "The world's population has greatly increased in the last 50 years. The recent rapid increase in human population over the past two centuries has raised concerns that humans are beginning to overpopulate the Earth.");
+    const q = "Roughly how many people were alive on Earth in 1900, and when did humanity first reach one billion?";
+    const a = "In 1900, there were approximately 1.2 billion people alive on Earth, and humanity first reached one billion around the year 1400.";
+    expect(groundUncited(a, [pop], q)).toEqual({ text: a, added: [] });
+  });
+
+  it("an off-topic source (no key term shared with the query) is never cited", () => {
+    const voy = chunk("v1", "Wikivoyage", "Travellers should carry cash. The currency is accepted everywhere and the coastline offers many beaches for tourists to enjoy in summer.");
+    const q = "How do I season sushi rice without vinegar?";
+    const a = "Travellers should carry cash, the currency is accepted everywhere and the coastline offers many beaches for tourists.";
+    expect(groundUncited(a, [voy], q)).toEqual({ text: a, added: [] });
+  });
+
+  it("the 50% rule: one supported claim in three stays uncited; two in three is cited", () => {
+    const q = "Tell me about moose and bison weight";
+    const s1 = "Most adult male moose weigh between 380 and 700 kg.";
+    const s2 = "Quantum chromodynamics describes gluon interactions inside protons.";
+    const s3 = "Pineapple plantations dominate Hawaiian agriculture exports.";
+    const one = [s1, s2, s3].join(" ");
+    expect(groundUncited(one, [moose], q)).toEqual({ text: one, added: [] });
+    const two = [s1, "The moose or elk is the tallest, largest and heaviest extant species of deer.", s3].join(" ");
+    const out = groundUncited(two, [moose], q);
+    expect(out.added).toEqual([1, 1]);
+    expect(out.text).toContain("700 kg [1].");
+    expect(out.text).toContain("species of deer [1].");
+    expect(out.text).not.toContain("Hawaiian agriculture exports [1]");
+  });
+
+  it("is deterministic and leaves decimals whole", () => {
+    const sah = chunk("s1", "Sahara", "The Sahara is the largest hot desert in the world, covering about 9.4 million square kilometres of North Africa.");
+    const a = "The Sahara is the largest hot desert in the world, covering about 9.4 million square kilometres.";
+    const out = groundUncited(a, [sah], "How big is the Sahara desert?");
+    expect(out.text).toBe("The Sahara is the largest hot desert in the world, covering about 9.4 million square kilometres [1].");
+    expect(out).toEqual(groundUncited(a, [sah], "How big is the Sahara desert?"));
+  });
+
+  it("a raised bar withholds a [n] that a lower bar gives", () => {
+    const q = "Which weighs more on average, an adult male moose or an adult male American bison?";
+    const a = "The American bison is heavier than the moose, a bovine mammal of North America.";
+    const lo = groundUncited(a, [moose, bison], q, 0.5);
+    const hi = groundUncited(a, [moose, bison], q, 0.95);
+    expect(lo.added.length).toBeGreaterThan(0);
+    expect(hi.added).toEqual([]);
+  });
+
+  it("empty inputs return the text unchanged", () => {
+    expect(groundUncited("", [moose], "moose")).toEqual({ text: "", added: [] });
+    expect(groundUncited("Moose are deer.", [], "moose")).toEqual({ text: "Moose are deer.", added: [] });
+  });
+});
