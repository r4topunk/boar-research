+  /** SEFIX (bench-only): a Stack Exchange Q&A pack (meta.sources names stackexchange). */
+  get rsIsSE(): boolean {
+    if (this.rsSeCache === null) {
+      try { this.rsSeCache = "stackexchange" in JSON.parse(this.meta.sources ?? "{}"); } catch { this.rsSeCache = false; }
