+  /**
+   * W78B-DENSE: stage 1 of denseChunks through the sign sidecar: Hamming distance of sign(query) to every article's sign bits, the `binN` nearest
+   * (ties: lower row), exact int8 cosine of only those rows (same arithmetic as the exact scan), top min(m, binN) of them (ties: scan order).
+   */
+  private async rsDenseStage1Bin(queryVec: Float32Array, m: number, binN: number) {
+    const dims = queryVec.length;
+    const W = dims >> 5;
+    const ld = await this.rsLeadBitsEnsure(dims);
+    if (!ld) return null;
+    const tScan = Date.now();
+    const { ids, words, n } = this.rsLeadBits!;
+    const q = new Uint32Array(W);
+    for (let d = 0; d < dims; d++) if (queryVec[d] > 0) q[d >> 5] |= 1 << (d & 31);
+    const dist = new Uint16Array(n);
+    const hist = new Uint32Array(dims + 1);
+    for (let i = 0; i < n; i++) {
+      let h = 0;
+      const o = i * W;
+      for (let w = 0; w < W; w++) {
+        let x = (words[o + w] ^ q[w]) >>> 0;
+        x = x - ((x >>> 1) & 0x55555555);
+        x = (x & 0x33333333) + ((x >>> 2) & 0x33333333);
+        h += (((x + (x >>> 4)) & 0x0f0f0f0f) * 0x01010101) >>> 24;
+      }
+      dist[i] = h;
+      hist[h]++;
+    }
+    const want = Math.min(binN, n);
+    let thr = 0;
+    for (let acc = 0; thr <= dims; thr++) if ((acc += hist[thr]) >= want) break;
+    const below = want - (thr > 0 ? hist.slice(0, thr).reduce((a, b) => a + b, 0) : 0);
+    const cand: number[] = [];
+    let atThr = 0;
+    for (let i = 0; i < n; i++) if (dist[i] < thr || (dist[i] === thr && atThr++ < below)) cand.push(i);
+    const tHam = Date.now();
+    const candIds = cand.map((i) => ids[i]);
+    const rows = candIds.length
+      ? await this.db.getAllAsync<{ article_id: number; vec: Uint8Array }>(`SELECT article_id, vec FROM lead_vecs WHERE article_id IN (${candIds.map(() => "?").join(",")})`, candIds)
+      : [];
+    const byId = new Map(rows.map((r) => [r.article_id, r.vec]));
+    let qn = 0;
+    for (let d = 0; d < dims; d++) qn += queryVec[d] * queryVec[d];
+    qn = Math.sqrt(qn) || 1;
+    const keep = Math.min(m, binN);
+    const top: Array<{ id: number; s: number }> = [];
+    for (const id of candIds) {
+      const raw = byId.get(id);
+      if (!raw) continue;
+      const vv = new Int8Array(raw.buffer, raw.byteOffset, dims);
+      let nn = 0;
+      for (let d = 0; d < dims; d++) nn += vv[d] * vv[d];
+      const norm = Math.fround(Math.sqrt(nn));
+      let dot = 0;
+      for (let d = 0; d < dims; d++) dot += queryVec[d] * vv[d];
+      const s = norm ? dot / (qn * norm) : 0;
+      if (top.length < keep || s > top[top.length - 1].s) {
+        let j = top.length < keep ? top.length : top.length - 1;
+        if (top.length < keep) top.push({ id, s });
+        while (j > 0 && top[j - 1].s < s) (top[j] = top[j - 1]), j--;
+        top[j] = { id, s };
+      }
+    }
+    return { top, scanMs: Date.now() - tScan, hamMs: tHam - tScan, loadMs: ld.loadMs, scanBytes: n * W * 4 + rows.length * dims, residentBytes: this.rsLeadBits!.fileBytes, rows: n, rescoreRows: rows.length };
   }
 
