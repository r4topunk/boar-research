+  /** W78B: loads the 1-bit sidecar of this pack (null: no sidecar file, the caller falls back to the exact scan). */
+  private async rsLeadBitsEnsure(dims: number): Promise<{ loadMs: number } | null> {
+    if (this.rsLeadBits) return { loadMs: 0 };
+    const env = (globalThis as any).process?.env;
+    const fs = await import("node:fs");
+    const path = `${env?.RS_SE_LEAD_BIN_DIR ?? "."}/${String(this.meta.manifestSha256 ?? "").slice(0, 16)}.leadbits`;
+    if (!fs.existsSync(path)) return null;
+    const t = Date.now();
+    const W = dims >> 5;
+    const buf = fs.readFileSync(path);
+    const ab = buf.buffer.slice(buf.byteOffset, buf.byteOffset + buf.byteLength);
+    const hdr = new DataView(ab, 8, 8);
+    const n = hdr.getUint32(0, true);
+    if (hdr.getUint32(4, true) !== dims) throw new Error(`W78B: ${path} dims mismatch`);
+    this.rsLeadBits = { ids: new Int32Array(ab, 16, n), words: new Uint32Array(ab, 16 + 4 * n, n * W), n, fileBytes: buf.byteLength };
+    return { loadMs: Date.now() - t };
+  }
