+  /** W78 (bench-only): RS_SE_LEAD_LOG=<file> appends one JSON line per F1 scan. */
+  private async rsSeLeadLog(rec: Record<string, unknown>): Promise<void> {
+    const f = (globalThis as any).process?.env?.RS_SE_LEAD_LOG;
+    if (!f) return;
+    const fs = await import("node:fs");
