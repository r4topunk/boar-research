+  /** SEFIX F1: the picked thread(s) as their answer chunks (positions 1-2 by start). */
+  private async rsSeLeadOut(top: Array<{ id: number; s: number }>): Promise<PackHit[]> {
     const out: PackHit[] = [];
     for (const t of top) {
       const rows = await this.db.getAllAsync<{ id: number; start: number; end: number }>("SELECT id, start, end FROM chunks WHERE article_id = ? ORDER BY start", [t.id]);
