 type PackRow = { id: number; title: string; body: string; vec: Uint8Array; rank: number };
 
+/** FMT1-SCAN full scan: every chunk vector of a format-1 pack, held in memory after the first query (bench-only). */
+const rsFmt1Vecs = new Map<string, { ids: number[]; vecs: Uint8Array[] }>();
+async function rsFmt1FullScan(
+  packId: string,
+  db: SQLite.SQLiteDatabase,
+  queryVec: Float32Array,
+  limit: number,
+  toChunk: (r: PackRow, score: number, matchType: RetrievedChunk["matchType"]) => RetrievedChunk
+): Promise<RetrievedChunk[]> {
+  let m = rsFmt1Vecs.get(packId);
+  if (!m) {
+    const t0 = performance.now();
+    const all = await db.getAllAsync<{ id: number; vec: Uint8Array }>("SELECT id, vec FROM chunks");
+    m = { ids: all.map((r) => r.id), vecs: all.map((r) => new Uint8Array(r.vec)) };
+    rsFmt1Vecs.set(packId, m);
+    (globalThis as any).process?.stderr?.write?.(`[fmt1] ${packId} loaded ${m.ids.length} vectors in ${Math.round(performance.now() - t0)} ms\n`);
+  }
+  const keep = Math.max(limit * 4, 50);
+  const top: { id: number; sim: number }[] = [];
+  for (let i = 0; i < m.ids.length; i++) {
+    const sim = cosineSimilarityInt8(queryVec, m.vecs[i]);
+    if (sim < MIN_SEMANTIC_SIMILARITY) continue;
+    if (top.length < keep) { top.push({ id: m.ids[i], sim }); if (top.length === keep) top.sort((a, b) => b.sim - a.sim); continue; }
+    if (sim <= top[keep - 1].sim) continue;
+    let j = keep - 1;
+    while (j > 0 && top[j - 1].sim < sim) { top[j] = top[j - 1]; j--; }
+    top[j] = { id: m.ids[i], sim };
+  }
+  if (!top.length) return [];
+  const rows = await db.getAllAsync<PackRow>(
+    `SELECT id, title, body, vec, 0 AS rank FROM chunks WHERE id IN (${top.map(() => "?").join(",")})`,
+    top.map((t) => t.id)
+  );
+  return rows.map((r) => toChunk(r, cosineSimilarityInt8(queryVec, r.vec), "semantic"));
+}
