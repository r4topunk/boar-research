+      "Headache is the most common early symptom of the condition. " +
+      "Many climbers also feel tired, dizzy and short of breath for the first days. " +
+      "Resting at the same height lets the body adjust to the thinner air over time. " +
+      "Severe cases need a quick descent to a lower altitude and medical care for the lungs and brain."
+  );
+  const FILLER = (id: string, title: string) =>
+    chunk(id, title, `${title} is a topic described in many books. It has a long history with many details. The details are listed in encyclopedias of every size.`);
+
+  it("slack budget: a 6-sentence ~120-token chunk comes back whole, with the switch on only", () => {
+    expect(approxTokens(`${SIX.title}\n${SIX.body}`)).toBeLessThanOrEqual(160);
+    expect(approxTokens(`${SIX.title}\n${SIX.body}`)).toBeGreaterThan(90);
+    const q = "What are the early symptoms of altitude sickness?";
+    const off = withHead(null, () => compressContext(q, [SIX], { tokenBudget: 1200 }));
+    expect(off.chunks[0].body).not.toBe(SIX.body);
+    expect(off.headProtected).toBeUndefined();
+    const on = withHead({ RS_COMPRESS_HEAD: "1" }, () => compressContext(q, [SIX], { tokenBudget: 1200 }));
