+      "Altitude sickness",
+      "Altitude sickness causes headache, dizziness, fatigue and nausea. Fever and fatigue are not typical, though headache and dizziness are common. Fatigue and headache can last for days."
+    );
+    const more = chunk("m", "Mountain", "Mountains are tall landforms. Headache and dizziness are common words on mountain trips.");
+    const q = "What causes headache, dizziness and fatigue?";
+    const input = [hiv, flu, sym, more];
+    const off = withHead(null, () => compressContext(q, input, { tokenBudget: 60 }));
+    expect(off.keptIndices.includes(0) && off.keptIndices.includes(1)).toBe(false);
+    const on = withHead({ RS_COMPRESS_HEAD: "1" }, () => compressContext(q, input, { tokenBudget: 60 }));
+    expect(on.keptIndices).toContain(0);
+    expect(on.keptIndices).toContain(1);
