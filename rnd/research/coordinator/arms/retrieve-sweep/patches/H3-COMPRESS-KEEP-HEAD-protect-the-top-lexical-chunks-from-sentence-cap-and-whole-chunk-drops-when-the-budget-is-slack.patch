+    const pool = [CANBERRA, SYDNEY, MOLD, INDUSTRIAL, SIX, FILLER("f1", "Rivers"), FILLER("f2", "Coins")];
+    const queries = ["What is the capital of Australia?", "Why did the Industrial Revolution begin?", "What are the symptoms of altitude sickness?", "Tell me about mold"];
+    const calls: [string, RetrievedChunk[], number][] = [];
+    for (let i = 0; i < 20; i++) calls.push([queries[i % 4], [0, 1, 2, 3].map((k) => pool[(i + k * 2) % pool.length]), [60, 120, 300, 1200, 2000][i % 5]]);
+    const ref = calls.map(([q, ch, b]) => withHead(null, () => compressContext(q, ch, { tokenBudget: b })));
