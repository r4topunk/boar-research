+import { describe, it, expect } from "vitest";
+import { reorderSeSources, seScore, isSeQuestion, isSeAnswer, SE_QUESTION_LABEL } from "./pure";
+
+const c = (chunkId: string, docId: string, title: string, body: string) => ({ chunkId, docId, title, body });
+const ids = (xs: { chunkId: string }[]) => xs.map((x) => x.chunkId);
+
+// lan-hlt-003-shaped: two threads, one question chunk with answers (dropped), one question without answers (kept last, labelled)
+const LAN = [
+  c("pack:local-qa-health-se:3681", "pack:local-qa-health-se:a856", "What diseases can be spread by mosquitos?", "Tags: infectious-diseases, mosquito I heard that the chance of cont"),
+  c("pack:local-qa-health-se:5344", "pack:local-qa-health-se:a1310", "Can a mosquito bite transmit STD's?", "Tags: sti, mosquito, syphilis Mosquitoes can of course transmit malaria"),
+  c("pack:local-boar-firstaid-en:5003", "pack:local-boar-firstaid-en:a495", "Appropedia: GEM mosquito control/FAQ", "Q14: Does mosquito spread HIV-AIDS?"),
+  c("pack:local-qa-health-se:5345", "pack:local-qa-health-se:a1310", "Can a mosquito bite transmit STD's?", "Diseases spread by mosquitoes only if they can replicate within the mosquito."),
+  c("pack:local-qa-health-se:5346", "pack:local-qa-health-se:a1310", "Can a mosquito bite transmit STD's?", "Answers > Answer (score 4, accepted): Yes, it is true that Zika can be transmitted sexually"),
+];
+
+// money-010-shaped: question + answer of one thread, a second thread with a better-voted answer after the first
+const MONEY = [
+  c("pack:local-qa-money-se:124071", "pack:local-qa-money-se:a30070", "New HSA contribution deadline", "Tags: united-states, taxes, hsa I had a qualifying event"),
+  c("pack:local-qa-money-se:124074", "pack:local-qa-money-se:a30070", "New HSA contribution deadline", "Answers > Answer (score 1): Because you did not become an HSA eligible individual until 2019"),
+  c("pack:local-qa-money-se:91261", "pack:local-qa-money-se:a22128", "Contribution limits and deadlines for HSA", "If I open an HSA after Dec. 31, 2018, any contribution goes toward 2019"),
+  c("pack:local-qa-money-se:91262", "pack:local-qa-money-se:a22128", "Contribution limits and deadlines for HSA", "Answers > Answer (score 3, accepted): Since you were HSA-eligible for 3 months in 2018"),
+];
+
+describe("reorderSeSources (READ-SEQ)", () => {
+  it("scores answers (accepted +0.5) and recognises question / answer chunks", () => {
+    expect(seScore(LAN[4])).toBe(4.5);
+    expect(seScore(MONEY[1])).toBe(1);
+    expect(seScore(LAN[3])).toBe(0);
+    expect(isSeQuestion(LAN[0])).toBe(true);
+    expect(isSeAnswer(LAN[4])).toBe(true);
+    expect(isSeQuestion(LAN[2])).toBe(false);
+  });
+
+  it("lan-hlt-003 shape: drops the question that has answers, keeps the other, wiki-like chunk keeps its position", () => {
+    const r = reorderSeSources(LAN);
+    // after the drop: [3681 q, 5003 fa, 5345 cont, 5346 ans]; SE positions 0, 2, 3 -> answer, continuation, question
+    expect(ids(r.sources)).toEqual([
+      "pack:local-qa-health-se:5346",
+      "pack:local-boar-firstaid-en:5003",
+      "pack:local-qa-health-se:5345",
+      "pack:local-qa-health-se:3681",
+    ]);
+    expect(r.droppedQuestions).toBe(1);
+    expect(r.labeledQuestions).toBe(1);
+    expect(r.reordered).toBe(true);
+    expect(r.sources[3].body.startsWith(SE_QUESTION_LABEL + "Tags:")).toBe(true);
+    expect(r.sources[3].title).toBe("What diseases can be spread by mosquitos?");
+    expect(r.sources[1]).toBe(LAN[2]);
+  });
+
+  it("money-010 shape: the question echo goes, the higher-score answer comes first", () => {
+    const r = reorderSeSources(MONEY);
+    // after the drop: [124074 a(1), 91261 cont, 91262 a(3.5)]; positions 0,1,2 -> 91262, 124074, 91261
+    expect(ids(r.sources)).toEqual(["pack:local-qa-money-se:91262", "pack:local-qa-money-se:124074", "pack:local-qa-money-se:91261"]);
+    expect(r.droppedQuestions).toBe(1);
+    expect(r.labeledQuestions).toBe(0);
+    expect(r.reordered).toBe(true);
+  });
+
+  it("a wiki-only list comes back unchanged (same objects, same order)", () => {
+    const wiki = [c("pack:local-boar-simplewiki-en:1", "d1", "A", "Alpha is a letter."), c("pack:local-boar-factbook:2", "d2", "B", "Tags: not an SE chunk")];
+    const r = reorderSeSources(wiki);
+    expect(r.sources).toEqual(wiki);
+    expect(r.sources[0]).toBe(wiki[0]);
+    expect(r.sources[1]).toBe(wiki[1]);
+    expect(r).toMatchObject({ droppedQuestions: 0, labeledQuestions: 0, reordered: false });
+  });
+
+  it("a pinned question chunk is never dropped (and is labelled)", () => {
+    const r = reorderSeSources(MONEY, new Set(["pack:local-qa-money-se:124071"]));
+    expect(r.droppedQuestions).toBe(0);
+    expect(ids(r.sources)).toEqual([
+      "pack:local-qa-money-se:91262",
+      "pack:local-qa-money-se:124074",
+      "pack:local-qa-money-se:91261",
+      "pack:local-qa-money-se:124071",
+    ]);
+    expect(r.sources[3].body.startsWith(SE_QUESTION_LABEL)).toBe(true);
+  });
+
+  it("ties keep the original order; an already-ordered list is not marked reordered", () => {
+    const a = [
+      c("pack:local-qa-x-se:1", "t1", "T", "Answers > Answer (score 2): one"),
+      c("pack:local-qa-x-se:2", "t1", "T", "Answers > Answer (score 2): two"),
+    ];
+    const r = reorderSeSources(a);
+    expect(ids(r.sources)).toEqual(["pack:local-qa-x-se:1", "pack:local-qa-x-se:2"]);
+    expect(r.reordered).toBe(false);
+  });
+
+  it("does not mutate the input", () => {
+    const copy = JSON.stringify(LAN);
+    reorderSeSources(LAN);
+    expect(JSON.stringify(LAN)).toBe(copy);
+  });
+});
