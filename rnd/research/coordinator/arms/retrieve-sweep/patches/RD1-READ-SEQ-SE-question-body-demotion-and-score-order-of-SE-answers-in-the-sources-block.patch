+/**
+ * READ-SEQ (READER arm RD1, bench-only, switch BOAR_READ_SEQ=1 in answer.ts; default off = unchanged).
+ * Stack Exchange pack threads reach the sources block as a "Tags: ..." question chunk and "Answers > Answer (score n[, accepted])"
+ * chunks. The question chunk echoes the user's own premise and reads like a statement of fact; the answers carry the fact and
+ * the vote score says which answer the community kept.
+ *   1. drop every SE question chunk whose thread (docId) has at least one SE answer chunk in the list (pinned chunks are kept);
+ *   2. refill the positions the SE chunks hold (after step 1), in order, with SE answer chunks by score desc (ties keep the
+ *      original order; an accepted answer counts +0.5), then SE continuation chunks in original order, then the SE question
+ *      chunks left (their thread has no answer chunk in the list); non-SE chunks keep their exact positions;
+ *   3. label the question chunks that remain: body prefixed with "Question asked (not an answer): " (title unchanged).
+ */
+export interface SeChunkLike {
+  chunkId: string;
+  docId?: string;
+  title: string;
+  body: string;
+}
+const isSeChunk = (c: SeChunkLike) => /^pack:local-qa-/.test(c.chunkId);
+export const isSeQuestion = (c: SeChunkLike) => isSeChunk(c) && /^Tags:/.test(c.body.trimStart());
+export const isSeAnswer = (c: SeChunkLike) => isSeChunk(c) && /^Answers >/.test(c.body.trimStart());
+export const seScore = (c: SeChunkLike) =>
+  Number(/^Answers > Answer \(score (-?\d+)/.exec(c.body.trimStart())?.[1] ?? 0) + (/accepted\)/.test(c.body.slice(0, 60)) ? 0.5 : 0);
+export const SE_QUESTION_LABEL = "Question asked (not an answer): ";
+
+export function reorderSeSources<T extends SeChunkLike>(
+  sources: T[],
+  pinned: ReadonlySet<string> = new Set(),
+): { sources: T[]; droppedQuestions: number; labeledQuestions: number; reordered: boolean } {
+  const threadsWithAnswer = new Set(sources.filter(isSeAnswer).map((c) => c.docId ?? c.chunkId));
+  const kept = sources.filter((c) => !(isSeQuestion(c) && !pinned.has(c.chunkId) && threadsWithAnswer.has(c.docId ?? c.chunkId)));
+  const droppedQuestions = sources.length - kept.length;
+  const positions: number[] = [];
+  kept.forEach((c, i) => { if (isSeChunk(c)) positions.push(i); });
+  const se = positions.map((i) => kept[i]);
+  const order = new Map(se.map((c, i) => [c, i] as const));
+  const answers = se.filter(isSeAnswer).sort((a, b) => seScore(b) - seScore(a) || order.get(a)! - order.get(b)!);
+  const rest = se.filter((c) => !isSeAnswer(c) && !isSeQuestion(c));
+  const questions = se.filter(isSeQuestion);
+  const sorted = [...answers, ...rest, ...questions];
+  const out = kept.slice();
+  positions.forEach((pos, i) => { out[pos] = sorted[i]; });
+  const reordered = out.some((c, i) => c !== kept[i]);
+  let labeledQuestions = 0;
+  const labeled = out.map((c) => {
+    if (!isSeQuestion(c)) return c;
+    labeledQuestions++;
+    return { ...c, body: SE_QUESTION_LABEL + c.body };
+  });
+  return { sources: labeled, droppedQuestions, labeledQuestions, reordered };
+}
