+/** RS_STICKY (SEARCHPAR arm R5, bench-only): the carried chunks of the previous turn (its `sources` event) as full passages: a format-2 pack chunk is
+ *  re-read from its pack by id (the original text, not the compressed copy the prompt carried); any other chunk is used as carried. */
+export async function rsRehydrate(carried: RetrievedChunk[]): Promise<RetrievedChunk[]> {
+  const out: RetrievedChunk[] = [];
+  for (const c of carried) {
+    const m = /^pack:([^:]+):(\d+)$/.exec(c.chunkId);
+    const wp = m ? wikiPacks.get(m[1]) : undefined;
+    let full: RetrievedChunk | null = null;
+    if (m && wp) {
+      try {
+        const h = await wp.rsChunkOf(Number(m[2]));
+        if (h) full = { ...packHitToChunk(m[1], h), score: c.score, ...(typeof c.similarity === "number" ? { similarity: c.similarity } : {}) };
+      } catch {}
+    }
+    out.push(full ?? c);
+  }
+  return out;
+}
