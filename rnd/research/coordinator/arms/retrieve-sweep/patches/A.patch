+/** RETRIEVE-SWEEP arm A: cosine of the search query to a chunk (its retrieval similarity when known, else both embedded now). */
+const rsQueryVec = new Map<string, Float32Array>();
+async function rsDenseSim(query: string, c: RetrievedChunk): Promise<number> {
+  if (typeof c.similarity === "number" && Number.isFinite(c.similarity)) return c.similarity;
+  try {
+    const { embeddingEngine } = await import("../rag/embed");
+    const { cosineSimilarity } = await import("../rag/pure");
+    let qv = rsQueryVec.get(query);
+    if (!qv) {
+      qv = await embeddingEngine.embed(query);
+      rsQueryVec.clear();
+      rsQueryVec.set(query, qv);
+    }
+    return cosineSimilarity(qv, await embeddingEngine.embed(`${c.title}\n${c.body}`.slice(0, 1500)));
+  } catch {
+    return -1;
+  }
+}
