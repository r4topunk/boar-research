+/** RETFLOOR: cosine of the question vector to a format-2 pack chunk's chunk_vecs row; null without a sidecar. */
+export async function packChunkCosine(chunkId: string, qv: Float32Array): Promise<number | null> {
+  const m = /^pack:([^:]+):(\d+)$/.exec(chunkId);
+  if (!m) return null;
+  const wp = wikiPacks.get(m[1]);
+  return wp ? wp.chunkCosine(Number(m[2]), qv) : null;
 }
 
