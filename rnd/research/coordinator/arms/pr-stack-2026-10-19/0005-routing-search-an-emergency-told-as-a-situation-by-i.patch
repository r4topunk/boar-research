diff --git a/src/rag/wikiPack.ts b/src/rag/wikiPack.ts
index 6cb269eb..9d1376c9 100644
--- a/src/rag/wikiPack.ts
+++ b/src/rag/wikiPack.ts
@@ -887,11 +887,29 @@ export class WikiPack {
       // A what-to-do question: official guidance (a government page's steps: Ready.gov "Protect Yourself During
       // Earthquakes") ranks above other sources' sections on the same topic, so it's among the first passages even
       // when other articles repeat the question's words more. Its best what-to-do sections go right after the first hit.
-      if (action && !hits.some((x) => x.source === "usgov")) {
+      // The page titled by the topic ("Floods" for a flood) is that guidance; a campaign page that only mentions it
+      // ("Flood Safety Social Media Toolkit") is not, so it does not stop the search for the titled one.
+      const topicStems = new Set((topic.length ? topic : stems).map((s) => s.stem));
+      const titled = async (title: string) => {
+        const own = await this.stems(title.replace(/\s*\([^)]*\)\s*$/, ""));
+        const inTopic = own.filter((s) => topicStems.has(s.stem)).length;
+        return inTopic > 0 && inTopic * 2 >= own.length;
+      };
+      const official = hits.filter((x) => x.source === "usgov");
+      let titledOfficial = false;
+      for (const x of official) if (!titledOfficial && (await titled(x.title))) titledOfficial = true;
+      if (action && !titledOfficial) {
+        // The titled page first, then (when no official page is in yet) the first one that covers the topic.
+        const found: Array<{ c: Candidate; titled: boolean }> = [];
         for (const c of pool) {
           if (seen.has(c.chunkId)) continue;
           const h = await this.materialize(c);
           if (h.source !== "usgov" || coverage(`${h.title} ${h.text}`, topic.length ? topic : stems) < 0.5) continue;
+          const t = await titled(h.title);
+          if (t || !official.length) found.push({ c, titled: t });
+          if (t) break;
+        }
+        for (const { c } of [...found.filter((f) => f.titled), ...found.filter((f) => !f.titled)]) {
           const acts = (await this.articlePassages(c.articleId, stems, 3, true)).filter((p) => p.action && !seen.has(p.chunkId)).slice(0, 2);
           if (!acts.length) continue;
           hits.splice(Math.min(1, hits.length), 0, ...acts.map((p) => ({ ...p, via: "bm25" as const })));
diff --git a/src/routing/answer.ts b/src/routing/answer.ts
index 22ca042e..ce27a9f5 100644
