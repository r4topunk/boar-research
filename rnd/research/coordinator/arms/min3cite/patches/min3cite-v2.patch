+/**
+ * MIN3CITE arm (2026-10-20): Ministral-only prompt adaptation, on when BOAR_MIN3CITE=1 (set by the adapter for the Ministral swap only).
+ * Changes only the persona's length sentence (system) and the style reminder (user turn); retrieval, routing, declines and the warning
+ * logic are untouched. With sources in the prompt ("Context:" lines "[n] title"), the style line states the citation format the engine keeps
+ * (one number per bracket, src/routing/citations.ts) with one example using the prompt's own numbering.
+ */
+export const MIN3CITE_VERSION = "v2";
+const MIN3_PERSONA_OLD = "Answer in 2-3 short, direct sentences";
+const MIN3_PERSONA_NEW = "Answer in 2-4 short, direct sentences";
+const MIN3_STYLE_OLD = "Keep it short: 2-3 sentences. No lists unless the question asks for one.";
+const MIN3_STYLE_NOSRC = "Keep it short: 2-4 plain sentences. No lists unless the question asks for one.";
+export function min3citeStyle(k: number): string {
+  if (k < 1) return MIN3_STYLE_NOSRC;
+  const range = k === 1 ? "[1]" : `[1] to [${k}]`;
+  return `Keep it short: 2-4 plain sentences, no lists or bold. Base the answer on the sources, numbered ${range}, and reuse their wording. ` +
+    `End each sentence that states a fact from a source with that source's number, one number per bracket, ` +
+    `for example: "Water boils at 100 degrees Celsius at sea level [1]." ` +
+    `A sentence not taken from a source gets no brackets. Do not add a list of sources.`;
+}
+export function min3citeMessages(messages: { role: string; content: string }[]): { role: string; content: string }[] {
+  if (process.env.BOAR_MIN3CITE !== "1" || !messages.length) return messages;
+  const sys = messages[0].role === "system" ? messages[0].content : "";
+  const ctx = sys.indexOf("\nContext:\n");
+  const k = ctx < 0 ? 0 : Math.max(0, ...[...sys.slice(ctx).matchAll(/^\[(\d+)\] /gm)].map((m) => Number(m[1])));
+  const last = messages.length - 1;
+  return messages.map((m, i) =>
+    i === 0 && m.role === "system" ? { ...m, content: m.content.replace(MIN3_PERSONA_OLD, MIN3_PERSONA_NEW) }
+    : i === last && m.role === "user" ? { ...m, content: m.content.replace(MIN3_STYLE_OLD, min3citeStyle(k)) }
+    : m);
+}
