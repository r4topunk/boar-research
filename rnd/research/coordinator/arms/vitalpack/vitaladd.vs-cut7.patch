+ * outside the catalog (corpus/<name>.sqlite, id "local-<name>") also answers to <name>. Absent = every pack.
+ */
+export interface PackFilter {
+  only?: string[];
+  exclude?: string[];
+  /** Also carry a format-1 pack's `source` column to the chunk (format-1 chunks have none otherwise). */
+  source?: boolean;
+}
+const packIds = (p: CatalogModel) => [p.id, p.id.replace(/^local-/, "")];
+export function packAllowed(p: CatalogModel, f?: PackFilter): boolean {
