+  if (DRUG.test(q)) return DOSE_INTENT.test(q) || DOSE_WORD.test(q) || PATIENT.test(q);
+  return DOSE_WORD.test(q) && DIGIT.test(q) && DOSE_INTENT.test(q) && !COOKING.test(q) && !WATER_PURIFY.test(q);
