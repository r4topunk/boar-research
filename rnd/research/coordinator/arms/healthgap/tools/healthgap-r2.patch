+const QUANTITY = bw(String.raw`\d+(?:[.,]\d+)? ?(?:g|mg|ml|grams?|gramas?|cups?|tablets?|pills?|drops?|bottles?|spoons?|teaspoons?|capsules?|comprimidos?|copos?|x[íi]caras?)`);
