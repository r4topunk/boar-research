+      ...(WATER_CUE.test(q) || HEAT_CUE.test(q) ? [String.raw`dehydrat${W}*`] : []),
+      ...(FOOD_CUE.test(q) ? ["starvation", "fasting", "malnutrition"] : []),
+    ];
+  return alts.length ? bw(alts.join("|")) : null;
+}
