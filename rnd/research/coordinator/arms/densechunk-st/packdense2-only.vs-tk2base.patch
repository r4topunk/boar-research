+import { describe, it, expect, vi } from "vitest";
+
+vi.mock("./db", () => ({ getDb: async () => ({ getAllAsync: async () => [] }) }));
+vi.mock("./embed", () => ({ embeddingEngine: { embed: async () => new Float32Array([1, 0, 0, 0]) } }));
+vi.mock("./ptLexiconAsset", () => ({ ptLexicon: () => ({}) }));
+vi.mock("expo-file-system/legacy", () => ({ documentDirectory: "file:///docs/" }));
+vi.mock("expo-sqlite", () => ({}));
+
+const { hit } = vi.hoisted(() => ({
+  hit: (chunkId: number, title: string, score: number, via: string) => ({
+    articleId: chunkId, chunkId, title, section: "", text: `${title} text.`, start: 0, end: 10, score, via, source: "simplewiki", views: 0, lead: false, action: false,
+  }),
+}));
+// One large pack: 8 keyword hits; with dense2 also a semantic list (chunk 3 is already a keyword hit).
+vi.mock("./packs", async (importOriginal) => {
+  const actual: any = await importOriginal();
+  return {
+    packHitToChunk: actual.packHitToChunk,
+    searchPacks: async () => ({ lexical: [], semantic: [] }),
+    searchWikiPacks: async (_q: string, o: any) => [
+      {
+        packId: "p",
+        hits: [1, 2, 3, 4, 5, 6, 7, 8].map((i) => hit(i, `Lex ${i}`, 10 - i, "bm25")),
+        ...(o.dense2 ? { semantic: [hit(3, "Lex 3", 0.9, "semantic"), hit(20, "Dense A", 0.7, "semantic"), hit(21, "Dense B", 0.8, "semantic"), hit(22, "Dense C", 0.6, "semantic")] } : {}),
+      },
+    ],
+  };
+});
+
+import { retrieve, appendDenseExtra } from "./retrieve";
+
+const ids = (cs: { chunkId: string }[]) => cs.map((c) => c.chunkId);
+
+describe("packDense2 extra (DENSECHUNK-ST2)", () => {
+  it("off and false give the same list; extra keeps that list and appends the 2 best new dense chunks", async () => {
+    const off = await retrieve("lex question", 6);
+    expect(ids(await retrieve("lex question", 6, { packDense2: false }))).toEqual(ids(off));
+    expect(off).toHaveLength(6);
+    const extra = await retrieve("lex question", 6, { packDense2: "extra" });
+    expect(ids(extra.slice(0, 6))).toEqual(ids(off));
+    // chunk 3 is already in the list; then similarity order: Dense B (0.8), Dense A (0.7); Dense C not taken.
+    expect(ids(extra.slice(6))).toEqual(["pack:p:21", "pack:p:20"]);
+    expect(extra[6].similarity).toBe(0.8);
+  });
+
+  it("fusion mode (true) is a different path: the dense hits compete inside the top-k", async () => {
+    const fused = await retrieve("lex question", 6, { packDense2: true });
+    expect(fused.length).toBeLessThanOrEqual(6);
+  });
+
+  it("appendDenseExtra: no dense or max 0 returns the same array", () => {
+    const l = [{ chunkId: "a" } as any];
+    expect(appendDenseExtra(l, [])).toBe(l);
+    expect(appendDenseExtra(l, [{ chunkId: "b", similarity: 0.6 } as any], 0)).toBe(l);
+    expect(ids(appendDenseExtra(l, [{ chunkId: "a", similarity: 0.9 } as any, { chunkId: "b", similarity: 0.6 } as any]))).toEqual(["a", "b"]);
+  });
+});
