@@ -0,0 +1,46 @@
+/**
+ * DEEPITER arm: one planner-driven second retrieval pass on the deep thinking tier (answer.ts, deep single branch).
+ * The deep model reads the question and the first pass's on-subject sources ("title — first 160 chars") and names up to
+ * N short follow-up searches for facts those sources lack; answer.ts runs them, filters them like the first pass and
+ * merges them after the first-pass sources (mergeSources, first-pass first) before compression. Pure helpers here.
+ */
+import type { RetrievedChunk } from "../rag/retrieve.types";
+
+export const DEEP_ITER_PLANNER_SYSTEM = "You plan searches for an offline library.";
+/** Characters of each source's body the planner sees. */
+export const DEEP_ITER_SNIPPET_CHARS = 160;
+/** Sources (first pass + follow-ups) kept before compression. */
+export const DEEP_ITER_MAX_SOURCES = 12;
+
+const oneLine = (s: string) => s.replace(/\s+/g, " ").trim();
+
+/** The planner's user message: the question, the kept first-pass sources, the instruction. */
+export function deepIterPlannerInput(query: string, sources: RetrievedChunk[], maxFollowups: number): string {
+  const lines = sources.map((c) => `- ${oneLine(c.title)} — ${oneLine(c.body).slice(0, DEEP_ITER_SNIPPET_CHARS)}`);
+  return (
+    `Question: ${query}\n\nSources:\n${lines.length ? lines.join("\n") : "(none)"}\n\n` +
+    `List up to ${maxFollowups} additional short search queries (one per line, prefixed \`Q: \`) that would retrieve facts ` +
+    "the sources above lack and the question needs. If the sources already suffice, output `NONE`."
+  );
+}
+
+/**
+ * The planner's `Q:` lines: trimmed (surrounding quotes/backticks dropped), empty ones and duplicates removed
+ * (case-insensitive), any equal to the first-pass query or the question removed, at most `max`. NONE or no Q: line -> [].
+ */
+export function parseDeepIterQueries(text: string, exclude: string[], max: number): string[] {
+  if (max <= 0) return [];
+  const seen = new Set(exclude.map((q) => oneLine(q).toLowerCase()));
+  const out: string[] = [];
+  for (const line of text.split("\n")) {
+    const m = line.match(/^\s*(?:[-*]\s*)?Q:\s*(.+)$/i);
+    if (!m) continue;
+    const q = oneLine(m[1].replace(/^["'`]+|["'`]+$/g, ""));
+    const key = q.toLowerCase();
+    if (!q || key === "none" || seen.has(key)) continue;
+    seen.add(key);
+    out.push(q);
+    if (out.length >= max) break;
+  }
+  return out;
+}
