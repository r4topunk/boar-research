+import { describe, it, expect } from "vitest";
+import type { RetrievedChunk } from "../rag/retrieve.types";
+import { assemblePrompt, assembleChatMessages } from "../rag/pure";
+import { AnswerDeps, createAnswerer, InstalledLlm, DEEP_ITER_FOLLOWUPS, DEEP_THINKING_BUDGET } from "./answer";
+import type { AnswerEvent } from "./events";
+import type { GenerateOptions } from "../inference/LlamaEngine";
+import { approxTokens } from "./context";
+import { DEEP_ITER_PLANNER_SYSTEM, deepIterPlannerInput, parseDeepIterQueries } from "./deepIter";
+
+const chunk = (chunkId: string, title: string, body: string): RetrievedChunk => ({
+  chunkId, docId: chunkId, title, body, score: 1, source: "wikipedia", matchType: "hybrid",
+} as RetrievedChunk);
+
+const CANBERRA = chunk("c1", "Canberra",
+  "Canberra is the capital city of Australia. The site of Canberra was selected for the location of the nation's capital in 1908 " +
+  "as a compromise between Sydney and Melbourne. The city was designed after an international design contest.");
+const CANBERRA_2 = chunk("c2", "Canberra",
+  "History: Canberra was chosen as the capital of Australia because neither Sydney nor Melbourne would accept the other as capital.");
+const GRIFFIN = chunk("g1", "Walter Burley Griffin",
+  "Walter Burley Griffin was an American architect who, with Marion Mahony Griffin, won the 1912 design contest for the plan of Canberra.");
+const OFF = chunk("x1", "Mold", "A mold is one of the structures that certain fungi can form. Mold growth needs moisture.");
+
+const GB = 1024 ** 3;
+const fast: InstalledLlm = { id: "fast4b", label: "Fast 4B", filename: "models/fast.gguf", sizeBytes: 2.5 * GB, roles: ["general", "fast"], isDefault: true };
+const deep: InstalledLlm = { id: "deep35", label: "Deep 35B", filename: "models/deep.gguf", sizeBytes: 12 * GB, roles: ["reasoning"] };
+
+function makeDeps(opts: { followups?: number; planner?: string; byQuery?: Record<string, RetrievedChunk[]> }) {
+  let clock = 0;
+  const gens: GenerateOptions[] = [];
+  const retrieves: { q: string; k: number }[] = [];
+  const loads: string[] = [];
+  let loaded: string | null = null;
+  const deps: AnswerDeps = {
+    now: () => (clock += 5),
+    engine: {
+      async load(filename) { loads.push(filename); loaded = filename; return { fit: null, warning: null }; },
+      async generate(o) {
+        gens.push(o);
+        if (o.messages?.[0]?.content === DEEP_ITER_PLANNER_SYSTEM) return opts.planner ?? "NONE";
+        const out = ["Canberra ", "was ", "a ", "compromise ", "[1]."];
+        for (const p of out) o.onToken?.(p);
+        const promptText = o.messages?.map((m) => m.content).join("\n") ?? o.prompt ?? "";
+        o.onTimings?.({ promptTokens: approxTokens(promptText), promptMs: 100, predictedTokens: out.length, predictedMs: 50 });
+        return out.join("");
+      },
+      async stop() {},
+      getModelInfo: () => (loaded ? { filename: loaded } : null),
+      hasEmbeddedChatTemplate: () => true,
+      async estimateFit() { return null; },
+    },
+    retrieve: async (q, k) => {
+      retrieves.push({ q, k });
+      return opts.byQuery?.[q] ?? [CANBERRA, OFF];
+    },
+    getSettings: async () => ({
+      quickFirst: true, alwaysComplete: true, deepModelId: deep.id,
+      ...(opts.followups !== undefined ? { deepIterFollowups: opts.followups } : {}),
+    }),
+    listInstalledLlms: async () => [fast, deep],
+    getActiveModelId: async () => fast.id,
+    runMultipass: async () => { throw new Error("no multipass in these tests"); },
+    assemblePrompt,
+    assembleChatMessages,
+  };
+  return { deps, gens, retrieves, loads };
+}
+
+async function run(deps: AnswerDeps, query: string) {
+  const events: AnswerEvent[] = [];
+  const result = await createAnswerer(deps).answer({ query }, (e) => events.push(e), { maxTokens: 512 }).done;
+  return { events, result };
+}
+
+const Q = "Why was Canberra chosen as the capital of Australia?";
+
+describe("deepIter helpers", () => {
+  it("parses Q: lines, drops duplicates, the original query and NONE, keeps at most max", () => {
+    const text = "Q: Walter Burley Griffin design\nq:  walter burley griffin design \nQ: " + Q + "\nNONE\n- Q: `Sydney Melbourne rivalry`\nQ: third one";
+    expect(parseDeepIterQueries(text, [Q], 2)).toEqual(["Walter Burley Griffin design", "Sydney Melbourne rivalry"]);
+    expect(parseDeepIterQueries("NONE", [Q], 2)).toEqual([]);
+    expect(parseDeepIterQueries("Q: a b c", [Q], 0)).toEqual([]);
+  });
+  it("shows each source as title — first 160 chars, and the instruction", () => {
+    const input = deepIterPlannerInput(Q, [CANBERRA], 2);
+    expect(input).toContain(`- Canberra — ${CANBERRA.body.slice(0, 160)}\n`);
+    expect(input).not.toContain(CANBERRA.body.slice(0, 161));
+    expect(input).toContain("List up to 2 additional short search queries (one per line, prefixed `Q: `)");
+    expect(input).toContain("If the sources already suffice, output `NONE`.");
+    expect(deepIterPlannerInput(Q, [], 2)).toContain("Sources:\n(none)");
+  });
+});
+
+describe("answer(): DEEPITER on the deep thinking tier", () => {
+  it("defaults to DEEP_ITER_FOLLOWUPS = 2", () => expect(DEEP_ITER_FOLLOWUPS).toBe(2));
+
+  it("followups 0: no planner call, one retrieval, no deepiter codes (the DT512 path)", async () => {
+    const t = makeDeps({ followups: 0, planner: "Q: Walter Burley Griffin design" });
+    const { result } = await run(t.deps, Q);
+    expect(result.tier).toBe("deep");
+    expect(t.gens.some((g) => g.messages?.[0]?.content === DEEP_ITER_PLANNER_SYSTEM)).toBe(false);
+    expect(t.retrieves).toHaveLength(1);
+    expect(result.receipt.reasonCodes.filter((c) => c.startsWith("deepiter:"))).toEqual([]);
+    expect(t.gens).toHaveLength(1);
+    expect(t.gens[0].thinkingBudget).toBe(DEEP_THINKING_BUDGET);
+  });
+
+  it("planner NONE: one planner call (greedy, no thinking), no extra retrieval", async () => {
+    const t = makeDeps({ planner: "NONE" });
+    const { result } = await run(t.deps, Q);
+    const planner = t.gens.filter((g) => g.messages?.[0]?.content === DEEP_ITER_PLANNER_SYSTEM);
+    expect(planner).toHaveLength(1);
+    expect(planner[0]).toMatchObject({ nPredict: 64, temperature: 0, enableThinking: false, timeoutMs: 20_000 });
+    expect(planner[0].onToken).toBeUndefined();
+    expect(planner[0].messages![1].content).toContain("- Canberra — ");
+    expect(planner[0].messages![1].content).not.toContain("- Mold — "); // only on-subject first-pass sources
+    expect(t.retrieves).toHaveLength(1);
+    expect(result.receipt.reasonCodes).toContain("deepiter:planner-none");
+    // The answer is still one thinking generation on the deep model, loaded once, before the planner.
+    expect(t.loads).toEqual([deep.filename]);
+    expect(t.gens.at(-1)!.thinkingBudget).toBe(DEEP_THINKING_BUDGET);
+  });
+
+  it("follow-ups: retrieves each (k 6), keeps on-topic new passages after the first pass's, logs counts", async () => {
+    const t = makeDeps({
+      planner: `Q: Walter Burley Griffin design contest\nQ: ${Q}\nQ: Canberra site selection 1908`,
+      byQuery: {
+        [Q]: [CANBERRA, OFF],
+        "Walter Burley Griffin design contest": [GRIFFIN, OFF, CANBERRA],
+        "Canberra site selection 1908": [CANBERRA_2],
+      },
+    });
+    const { events, result } = await run(t.deps, Q);
+    expect(t.retrieves).toEqual([{ q: Q, k: 6 }, { q: "Walter Burley Griffin design contest", k: 6 }, { q: "Canberra site selection 1908", k: 6 }]);
+    expect(result.receipt.reasonCodes).toContain("deepiter:followups-2");
+    expect(result.receipt.reasonCodes).toContain("deepiter:added-2"); // GRIFFIN + CANBERRA_2 (CANBERRA dup, OFF off-topic)
+    const ids = result.sources.map((s) => s.chunkId);
+    expect(ids).toContain("g1");
+    expect(ids).not.toContain("x1");
+    const prompt = t.gens.at(-1)!.messages!.map((m) => m.content).join("\n");
+    expect(prompt).toContain("Walter Burley Griffin");
+    const sourcesEvents = events.filter((e) => e.type === "sources");
+    expect(sourcesEvents.length).toBeGreaterThan(0);
+  });
+
+  it("never runs for health questions or the fast tier", async () => {
+    const t = makeDeps({ planner: "Q: something else" });
+    t.deps.getSettings = async () => ({ quickFirst: true, alwaysComplete: false, deepModelId: deep.id, deepIterFollowups: 2 });
+    await run(t.deps, "Tell me about Canberra's design");
+    expect(t.gens.some((g) => g.messages?.[0]?.content === DEEP_ITER_PLANNER_SYSTEM)).toBe(false);
+    const h = makeDeps({ planner: "Q: something else" });
+    await run(h.deps, "How do I treat a snake bite?");
+    expect(h.gens.some((g) => g.messages?.[0]?.content === DEEP_ITER_PLANNER_SYSTEM)).toBe(false);
+  });
+});
