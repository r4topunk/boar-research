 src/routing/calculators.ts     |  2 +-
 src/routing/classify.ts        |  2 +-
 src/routing/context.ts         |  2 +-
 src/routing/longDigits.test.ts | 34 ++++++++++++++++++++++++++++++++++
 src/routing/numguard.ts        |  2 +-
 5 files changed, 38 insertions(+), 4 deletions(-)
 create mode 100644 src/routing/longDigits.test.ts

