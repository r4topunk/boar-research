+/**
+ * HEALTHDROP (deps.healthDrop): a dropped health-pack chunk may be kept when its bare title (the source label
+ * "US government: " / "Wikibooks: " stripped) shares a term with the question's content words (minus the words that
+ * name no condition) or with its health topic terms. Title only: a body mention never counts.
+ */
+export function healthDropTitle(query: string, topic: Set<string>, title: string): boolean {
+  const bare = title.replace(/^[^:]{1,30}:\s*/, "");
+  const words = new Set([...tokenizeTerms(query).filter((t) => !GENERIC_TOPIC.has(t)), ...topic]);
+  return titleNames(bare, words);
+}
