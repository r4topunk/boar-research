--- /dev/null
+++ b/src/routing/factSanity.ts
@@ -0,0 +1,70 @@
+/**
+ * Fact sanity guard for the computed verdict (CVS, cut 3 dev; criterion arms/cvs/CVS-criterion.md). Pure, English only.
+ *
+ * CV rev1 failed its ship gate on three answers where the 4B's structured fact was absurd, not just wrong: a planet's mass with
+ * its exponent dropped ("1,898 kg"), a ship's length in km ("269 km"), a river 2,090 km long. The guard checks a fact the model
+ * gave against a plausibility range for the entity's class, and two same-class values against each other; a failure makes CV
+ * abstain, so the normal path (cut 3's answer) answers. An entity whose class is unknown gets no range check.
+ * Figures the question itself supplies are never checked.
+ */
+import type { Dim } from "./verdictUnits";
+
+export type EntityClass = "ship" | "building" | "bridge" | "river" | "mountain" | "celestial" | "country";
+
+const word = (s: string) => new RegExp(`\\b(?:${s})\\b`, "i");
+const CLASS_RE: [EntityClass, RegExp][] = [
+  ["ship", word("titanic|ships?|boats?|yachts?|liner|carrier|ferry|battleship|cruiser|submarine|lusitania|bismarck")],
+  ["bridge", word("bridges?|golden gate|brooklyn|akashi|tower bridge")],
+  ["building", word("towers?|buildings?|skyscraper|burj|empire state|pyramid|cathedral|statue|monument|khalifa|petronas|taipei 101|colosseum|eiffel|big ben|pantheon|sagrada|burj al arab|one world trade")],
+  ["river", word("rivers?|nile|amazon|danube|thames|seine|mississippi|missouri|volga|congo|rhine|yangtze|yellow river|ganges|mekong|euphrates|tigris|niger|zambezi|ob|lena|amur|rhone|elbe|loire|tagus|ebro|po|ural|dnieper|indus|murray|colorado river|hudson")],
+  ["mountain", word("mount|mt|mont|peak|k2|everest|kilimanjaro|kangchenjunga|whitney|rainier|denali|matterhorn|mont blanc|elbrus|aconcagua|fuji|olympus|annapurna|lhotse|makalu|cho oyu")],
+  ["celestial", word("planets?|moons?|stars?|mercury|venus|earth|mars|jupiter|saturn|uranus|neptune|pluto|ganymede|titan|callisto|europa|io|triton|sun|ceres|eris|luna|sirius")],
+  ["country", word("china|india|united states|usa|us|america|indonesia|pakistan|nigeria|brazil|bangladesh|russia|mexico|japan|ethiopia|philippines|egypt|vietnam|turkey|iran|germany|thailand|united kingdom|uk|france|italy|south africa|tanzania|myanmar|kenya|south korea|north korea|colombia|spain|uganda|argentina|algeria|sudan|south sudan|ukraine|iraq|afghanistan|poland|canada|morocco|saudi arabia|peru|uzbekistan|venezuela|malaysia|angola|ghana|mozambique|nepal|yemen|madagascar|australia|sri lanka|cameroon|niger|netherlands|chile|ecuador|belgium|greece|portugal|sweden|austria|switzerland|israel|norway|denmark|finland|ireland|new zealand|singapore|luxembourg|monaco|vatican city|iceland|cuba|haiti|cambodia|laos|jordan|lebanon|congo|democratic republic of the congo|north macedonia|hungary|romania|serbia|croatia|czech republic|belarus|kazakhstan|mongolia|libya|tunisia|senegal|zimbabwe|zambia|bolivia|paraguay|uruguay")],
+];
+
+/** The entity's class from its name, or null. Order matters: "Tower Bridge" is a bridge, "Titanic" a ship. */
+export function classOf(name: string): EntityClass | null {
+  const n = name.replace(/['’]s\b.*$/, "").trim();
+  // a river's name wins over the country it shares one with ("the Congo River"); a bare "Congo" is read as the river only with "river"
+  if (/\bcity\b|\bstate\b|\bcounty\b|\bprovince\b|\bregion\b/i.test(n) && !/\bcountry\b/i.test(n)) return null;
+  for (const [c, re] of CLASS_RE) if (re.test(n)) return c;
+  return null;
+}
+
+const M = 1;
+const KM = 1000;
+/** Plausible range [min, max] in the dimension's base unit, by class and the dimension of the fact. Null = no check. */
+function range(c: EntityClass, dim: Dim): [number, number] | null {
+  if (dim === "length") {
+    if (c === "ship" || c === "building" || c === "bridge") return [0.5 * M, 5 * KM];
+    if (c === "river") return [10 * KM, 7500 * KM];
+    if (c === "mountain") return [100 * M, 9000 * M];
+    if (c === "celestial") return [1e5, 2e11];
+  }
+  if (dim === "mass" && c === "celestial") return [1e19, 1e32];
+  if (dim === "people" && c === "country") return [1e3, 2e9];
+  return null;
+}
+
+/** False when a fact the model gave is outside the plausible range for the entity's class (class unknown: true). */
+export function plausibleFact(name: string, dim: Dim | "year", base: number): boolean {
+  if (dim === "year") return base >= -3000 && base <= new Date().getFullYear();
+  const c = classOf(name);
+  if (!c) return true;
+  const r = range(c, dim);
+  return !r || (base >= r[0] && base <= r[1]);
+}
+
+/**
+ * Two values of one quantity for two entities of the SAME known class that differ by more than 100x: for length, height and
+ * mass of same-class things that is a slipped unit or exponent, not a real difference. Different or unknown classes: allowed.
+ */
+export function comparableValues(nameA: string, nameB: string, dim: Dim, a: number, b: number): boolean {
+  if (dim !== "length" && dim !== "mass") return true;
+  const ca = classOf(nameA);
+  const cb = classOf(nameB);
+  if (!ca || ca !== cb) return true;
+  const lo = Math.min(Math.abs(a), Math.abs(b));
+  const hi = Math.max(Math.abs(a), Math.abs(b));
+  return lo > 0 && hi / lo <= 100;
+}
