+import { describe, it, expect } from "vitest";
+import { formatFigure, fromBase, parseFigure, parseNumber, parseUnit, parseYear, toBase } from "./verdictUnits";
+
+const km = (raw: string) => toBase(1, parseUnit(raw)!) / 1000;
+
+describe("verdictUnits (CV)", () => {
+  it("parses numbers: commas, decimals, scale words, scientific notation, a minus", () => {
+    expect(parseNumber("8,849")).toBe(8849);
+    expect(parseNumber("19.3")).toBe(19.3);
+    expect(parseNumber("1.4 billion")).toBe(1.4e9);
+    expect(parseNumber("7.35 × 10^22")).toBeCloseTo(7.35e22, -18);
+    expect(parseNumber("7.35e22")).toBeCloseTo(7.35e22, -18);
+    expect(parseNumber("7.35 × 10²²")).toBeCloseTo(7.35e22, -18);
+    expect(parseNumber("−40")).toBe(-40);
+    expect(parseNumber("~300")).toBe(300);
+  });
+  it("refuses ranges, words and nothing", () => {
+    expect(parseNumber("1,000–1,600")).toBeNull();
+    expect(parseNumber("about a thousand")).toBeNull();
+    expect(parseNumber("")).toBeNull();
+    expect(parseNumber("?")).toBeNull();
+  });
+  it("length units normalise to metres", () => {
+    expect(km("km")).toBe(1);
+    expect(km("mi")).toBeCloseTo(1.609344, 6);
+    expect(km("miles")).toBeCloseTo(1.609344, 6);
+    expect(km("nautical miles")).toBeCloseTo(1.852, 6);
+    expect(toBase(3280.84, parseUnit("ft")!)).toBeCloseTo(1000, 1);
+  });
+  it("area units: km², sq mi, square km, ha", () => {
+    const a = parseUnit("km²")!;
+    const b = parseUnit("square miles")!;
+    expect(a.dim).toBe("area");
+    expect(toBase(1, b) / toBase(1, a)).toBeCloseTo(2.589988, 5);
+    expect(parseUnit("sq km")!.factor).toBe(1e6);
+    expect(parseUnit("km2")!.factor).toBe(1e6);
+    expect(parseUnit("ha")!.factor).toBe(1e4);
+  });
+  it("density and speed ratios", () => {
+    expect(toBase(1, parseUnit("g/cm³")!)).toBeCloseTo(1000, 6);
+    expect(toBase(1, parseUnit("g/cm3")!)).toBeCloseTo(1000, 6);
+    expect(toBase(1000, parseUnit("kg/m3")!)).toBe(1000);
+    expect(toBase(1, parseUnit("grams per cubic centimeter")!)).toBeCloseTo(1000, 6);
+    expect(toBase(36, parseUnit("km/h")!)).toBeCloseTo(10, 9);
+    expect(toBase(1, parseUnit("km per second")!)).toBe(1000);
+    expect(toBase(100, parseUnit("mph")!)).toBeCloseTo(44.704, 6);
+  });
+  it("temperatures convert through kelvin, both ways", () => {
+    const c = parseUnit("°C")!;
+    const f = parseUnit("°F")!;
+    expect(toBase(0, c)).toBeCloseTo(273.15, 9);
+    expect(toBase(212, f)).toBeCloseTo(373.15, 9);
+    expect(toBase(-40, c)).toBeCloseTo(toBase(-40, f), 9);
+    expect(fromBase(toBase(100, c), f)).toBeCloseTo(212, 9);
+    expect(parseUnit("degrees Celsius")!.label).toBe("°C");
+  });
+  it("an unknown unit or a unit of another family is not guessed", () => {
+    expect(parseUnit("parsecs")).toBeNull();
+    expect(parseUnit("")).toBeNull();
+    expect(parseUnit("km/kg")).toBeNull();
+    expect(parseUnit("kg")!.dim).toBe("mass");
+  });
+  it("years carry an era", () => {
+    expect(parseYear("1969")).toBe(1969);
+    expect(parseYear("753", "BC")).toBe(-753);
+    expect(parseYear("44 BCE")).toBe(-44);
+    expect(parseYear("1066", "AD")).toBe(1066);
+    expect(parseYear("many")).toBeNull();
+  });
+  it("figures as the question writes them", () => {
+    expect(parseFigure("8,000 meters")?.base).toBe(8000);
+    expect(parseFigure("800m")?.base).toBe(800);
+    expect(parseFigure("a mile")?.base).toBeCloseTo(1609.344, 6);
+    expect(parseFigure("200 million people")?.base).toBe(2e8);
+    expect(parseFigure("40 million")?.unit.dim).toBe("people");
+    expect(parseFigure("5 million square km")?.base).toBe(5e12);
+    expect(parseFigure("300,000 km per second")?.base).toBe(3e8);
+    expect(parseFigure("-270 °C")?.unit.dim).toBe("temperature");
+    expect(parseFigure("is tall")).toBeNull();
+  });
+  it("formats a figure compactly", () => {
+    expect(formatFigure(8849, parseUnit("m")!)).toBe("8,849 m");
+    expect(formatFigure(1.4e9, parseUnit("people")!)).toBe("1.4 billion people");
+    expect(formatFigure(19.3, parseUnit("g/cm³")!)).toBe("19.3 g/cm³");
+    expect(formatFigure(7.35e22, parseUnit("kg")!)).toBe("7.35 × 10^22 kg");
+  });
+});
