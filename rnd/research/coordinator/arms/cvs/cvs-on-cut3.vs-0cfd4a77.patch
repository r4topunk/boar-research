+
+/** A year with its era: "1969", "-753", "753 BC", "44 BCE", "1066 AD" → a signed integer; null otherwise. */
+export function parseYear(raw: string, eraHint = ""): number | null {
+  const s = `${raw} ${eraHint}`.toLowerCase().replace(/,/g, "").trim();
+  const m = s.match(/(-?\d{1,4})(?!\d)\s*(?:year\s*)?(bc|bce|b\.c\.|ad|ce|a\.d\.)?/);
