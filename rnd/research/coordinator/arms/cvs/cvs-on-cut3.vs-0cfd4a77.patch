+
+const SUPER: Record<string, string> = { "²": "2", "³": "3", "⁰": "0", "¹": "1", "⁴": "4", "⁵": "5", "⁶": "6", "⁷": "7", "⁸": "8", "⁹": "9", "⁻": "-" };
+
+function norm(raw: string): string {
+  return raw
+    .toLowerCase()
+    .replace(/[²³]/g, (c) => `^${SUPER[c]}`)
+    .replace(/[°.]/g, "")
+    .replace(/\bper\b/g, "/")
+    .replace(/\s*\/\s*/g, "/")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+/** A length/mass/volume/time word → its table entry, or null. */
+function simple(s: string): Unit | null {
+  return LENGTH[s] ?? MASS[s] ?? VOLUME[s] ?? null;
+}
+
+/** Parses a unit as written ("km²", "square miles", "g/cm3", "km per hour", "degrees Celsius"); null if unknown. */
+export function parseUnit(raw: string): Unit | null {
+  let s = norm(raw);
+  if (!s) return null;
+  s = s.replace(/^(approximately|approx|about|around|roughly)\s+/, "");
+  if (FIXED[s]) return FIXED[s];
+  // ratios: density (mass/volume) and speed (length/time)
+  const slash = s.split("/");
+  if (slash.length === 2) {
+    const [n, d] = slash;
+    const den = d.replace(/^(?:cubic|cu)\s+/, "").replace(/\^?3$/, "").trim();
+    const numU = simple(n);
+    if (numU?.dim === "mass") {
+      const cubic = /^(?:cubic|cu)\s+/.test(d) || /\^?3$/.test(d);
+      const volU = cubic ? lengthUnit(den) : VOLUME[d];
+      if (volU) {
+        const volBase = cubic ? volU.factor ** 3 : volU.factor;
+        return u("density", `${numU.label}/${cubic ? `${volU.label}³` : volU.label}`, numU.factor / volBase);
+      }
+    }
+    if (numU?.dim === "length" && TIME[d] !== undefined) return u("speed", `${numU.label}/${d.startsWith("h") ? "h" : d.startsWith("s") ? "s" : "min"}`, numU.factor / TIME[d]);
+    return null;
+  }
