+  return { fig, tail };
+}
+
+/** A number written without a unit and followed by a noun: "50 known moons" → count figure. */
+function countFigure(right: string): { fig: Figure; noun: string } | null {
+  const m = right.trim().match(/^(-?\d[\d,]*(?:\.\d+)?)\s+([a-z][a-z \-]{2,40})$/i);
+  if (!m) return null;
+  const v = parseNumber(m[1]);
+  const unit = parseUnit("people");
+  if (v === null || !unit) return null;
+  return { fig: { base: v, unit: { dim: "count", label: "", factor: 1, offset: 0 }, text: m[1] }, noun: m[2].replace(/^known\s+/i, "known ") };
