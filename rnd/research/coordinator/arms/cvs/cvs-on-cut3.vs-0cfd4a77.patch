+import { describe, it, expect } from "vitest";
+import { classOf, comparableValues, plausibleFact } from "./factSanity";
+import { computedVerdictAnswer } from "./computedVerdict";
+
+const fake = (facts: string) => async (system: string) => (system.startsWith("Write one") ? "" : facts);
+const run = (q: string, facts: string) => computedVerdictAnswer(q, fake(facts), { noSentences: true });
+
+describe("CVS fact sanity: entity classes", () => {
+  it("reads a class from the name, or none", () => {
+    expect(classOf("the Titanic")).toBe("ship");
+    expect(classOf("the Eiffel Tower")).toBe("building");
+    expect(classOf("the Golden Gate Bridge's main span")).toBe("bridge");
+    expect(classOf("the Danube")).toBe("river");
+    expect(classOf("Mount Everest")).toBe("mountain");
+    expect(classOf("Jupiter")).toBe("celestial");
+    expect(classOf("Brazil")).toBe("country");
+    expect(classOf("Tower Bridge")).toBe("bridge");
+  });
+  it("an unknown class, a city or a state gets none (no range check)", () => {
+    expect(classOf("Lake Baikal")).toBeNull();
+    expect(classOf("New York City")).toBeNull();
+    expect(classOf("New York State")).toBeNull();
+    expect(classOf("Wyoming")).toBeNull();
+    expect(classOf("a cheetah")).toBeNull();
+  });
+});
+
+describe("CVS fact sanity: ranges", () => {
+  it("a mass without its exponent, a ship in km, a river under 10 km, a mountain in the stratosphere", () => {
+    expect(plausibleFact("Jupiter", "mass", 1898)).toBe(false);
+    expect(plausibleFact("Jupiter", "mass", 1.898e27)).toBe(true);
+    expect(plausibleFact("the Titanic", "length", 269000)).toBe(false);
+    expect(plausibleFact("the Titanic", "length", 269)).toBe(true);
+    expect(plausibleFact("the Danube", "length", 5000)).toBe(false);
+    expect(plausibleFact("the Danube", "length", 2850e3)).toBe(true);
+    expect(plausibleFact("Mount Everest", "length", 88490)).toBe(false);
+    expect(plausibleFact("Mount Everest", "length", 8849)).toBe(true);
+  });
+  it("country population and dates", () => {
+    expect(plausibleFact("Brazil", "people", 213)).toBe(false);
+    expect(plausibleFact("Brazil", "people", 2.13e8)).toBe(true);
+    expect(plausibleFact("China", "people", 1.4e10)).toBe(false);
+    expect(plausibleFact("anything", "year", -5000)).toBe(false);
+    expect(plausibleFact("anything", "year", 3000)).toBe(false);
+    expect(plausibleFact("anything", "year", -753)).toBe(true);
+  });
+  it("an unknown class passes, and so does a dimension with no range", () => {
+    expect(plausibleFact("Lake Baikal", "length", 1)).toBe(true);
+    expect(plausibleFact("the Danube", "mass", 1)).toBe(true);
+  });
+});
+
+describe("CVS fact sanity: same-class values 100x apart", () => {
+  it("abstain for length and mass of one class, allow across classes and unknown classes", () => {
+    expect(comparableValues("the Titanic", "the Queen Mary ship", "length", 269, 2)).toBe(false);
+    expect(comparableValues("the Danube", "the Rhine", "length", 2.85e6, 1.2e6)).toBe(true);
+    expect(comparableValues("Jupiter", "Saturn", "mass", 1.9e27, 5.68e26)).toBe(true);
+    expect(comparableValues("Jupiter", "Earth", "mass", 1.9e27, 5.97e24)).toBe(false); // true values, but the rule is by class: abstain
+    expect(comparableValues("Jupiter", "Earth", "mass", 1.9e27, 5.97e21)).toBe(false);
+    expect(comparableValues("the Eiffel Tower", "Mount Everest", "length", 330, 8849)).toBe(true);
+    expect(comparableValues("Lake Baikal", "Lake Erie", "length", 1642, 1)).toBe(true);
+    expect(comparableValues("Brazil", "Chile", "people", 2e8, 1e3)).toBe(true);
+  });
+});
+
+describe("CVS: CV abstains on implausible facts (the normal path answers)", () => {
+  it("Jupiter mass 1,898 kg (dropped exponent) in a which-question", async () => {
+    expect(await run("Which has more mass, Jupiter or Saturn?", "Jupiter | 1898 | kg\nSaturn | 5.68e26 | kg")).toBeNull();
+    expect((await run("Which has more mass, Jupiter or Saturn?", "Jupiter | 1.898e27 | kg\nSaturn | 5.68e26 | kg"))?.winner).toBe("Jupiter");
+  });
+  it("Titanic 269 km (unit slip) in a which and in a threshold question", async () => {
+    expect(await run("Which is longer, the Titanic or the Queen Mary 2?", "Titanic | 269 | km\nQueen Mary 2 | 345 | m")).toBeNull();
+    expect(await run("Is the Titanic longer than 200 m?", "Titanic | 269 | km")).toBeNull();
+    expect((await run("Is the Titanic longer than 200 m?", "Titanic | 269 | m"))?.yes).toBe(true);
+  });
+  it("a river under 10 km, a mountain too high, a date before 3000 BC", async () => {
+    expect(await run("Is the Danube longer than 3000 km?", "Danube | 5 | km")).toBeNull();
+    expect(await run("Is Mont Blanc higher than 5,000 m?", "Mont Blanc | 48070 | m")).toBeNull();
+    expect(await run("Did the Taj Mahal get built before 1700?", "the Taj Mahal | 5000 | BC")).toBeNull();
+  });
+  it("two same-class values 100x apart abstain; plausible ones answer as in CV", async () => {
+    expect(await run("Which is taller, K2 or Mount Everest?", "K2 | 8611 | m\nEverest | 86.11 | m")).toBeNull();
+    expect((await run("Which is taller, K2 or Mount Everest?", "K2 | 8611 | m\nEverest | 8849 | m"))?.winner).toBe("Mount Everest");
