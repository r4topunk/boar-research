+/* ───────────────────────────── router ───────────────────────────── */
+
+/** Words of the paths CV never takes: health and danger, cards, calculators, venues, country facts, money advice, opinion. */
+const VETO = new RegExp(
+  String.raw`\b(?:symptoms?|dos(?:e|age)|overdos\w*|poison\w*|toxic|medic\w*|drugs?|pills?|safe(?:ly)?|pregnan\w*|allerg\w*|infect\w*|disease|cancer|injur\w*|bleed\w*|burns?|burnt|bites?|bitten|stings?|stung|snakes?|emergenc\w*|danger\w*|lethal|fatal|deadly|cook\w*|bake|recipes?|rash|fever|pain|hurts?|sick|ill|diet|calories|vitamins?|dying|suicid\w*|panic|choking|drown\w*|heart attack|stroke|` +
+    String.raw`restaurants?|cafes?|caf[eé]s?|bars?|hotels?|hostels?|near me|nearby|open now|where to (?:eat|stay|go)|menu|` +
+    String.raw`convert|conversion|exchange rate|currency|mpg|battery|tip|plug|voltage|time zone|calling code|emergency number|capital of|` +
+    String.raw`stocks?|invest\w*|crypto\w*|bitcoin|ethereum|eth|buy|sell|price of|` +
+    String.raw`should|better|best|worth|recommend\w*|prefer|safer|healthier|cheaper|easier|worse|good|bad|my|mine|i|me|you|your)\b`,
+  "i"
+);
+
+const MIN_WORDS = /\b(?:shorter|smaller|lighter|slower|colder|cooler|fewer|less|lower|closer|younger|smallest|shortest|lowest|coldest|slowest|youngest|lightest)\b/i;
+
+interface QHit {
+  q: QId;
+  dir: "max" | "min";
+  ask: "older" | "before" | "plain";
+}
+
+/** The quantity a comparative phrase asks about, and which end of it wins. Null when no known quantity matches. */
+function inferQuantity(text: string): QHit | null {
+  const t = text.toLowerCase();
+  const dir: "max" | "min" = MIN_WORDS.test(t) ? "min" : "max";
+  const hit = (q: QId, d = dir, ask: QHit["ask"] = "plain"): QHit => ({ q, dir: d, ask });
+  if (/\bper capita\b/.test(t)) return hit("gdp_pc");
+  if (/\b(?:gdp|econom(?:y|ies)|richer)\b/.test(t)) return hit("gdp");
+  if (/\b(?:denser|density|dense)\b/.test(t)) return hit("density");
+  if (/\b(?:population|populous|people|residents|inhabitants|citizens)\b/.test(t)) return hit("population");
+  if (/\b(?:older|oldest)\b/.test(t)) return hit("year", "min", "older");
+  if (/\b(?:younger|youngest|newer|more recent)\b/.test(t)) return hit("year", "max", "older");
+  if (/\b(?:came first|first|earlier|before|founded first)\b/.test(t)) return hit("year", "min", "before");
+  if (/\b(?:came later|later|after|came after)\b/.test(t)) return hit("year", "max", "before");
+  if (/\b(?:mass|massive|heavier|heavier|heaviest|weigh\w*)\b/.test(t)) return hit("mass");
+  if (/\b(?:speed|faster|slower|fastest|runs faster|top speed)\b/.test(t)) return hit("speed");
+  if (/\b(?:hotter|colder|warmer|cooler|temperature|hottest|coldest)\b/.test(t)) return hit("temperature");
+  if (/\b(?:closer to earth|gets closer)\b/.test(t)) return hit("distance_earth");
+  if (/\b(?:diameter|wider|width|across)\b/.test(t)) return hit("diameter");
+  if (/\b(?:deeper|depth|deepest)\b/.test(t)) return hit("depth");
+  if (/\b(?:taller|height|tall|higher|highest|elevation|summit|altitude|tallest)\b/.test(t)) return hit("height", "max");
+  if (/\b(?:longer|length|long|longest|shorter|shortest)\b/.test(t)) return hit("length");
+  if (/\b(?:area|square|sq|land|covers more)\b/.test(t)) return hit("area");
+  if (/\b(?:bigger|larger|smaller|biggest|largest|smallest|big|large)\b/.test(t)) return hit("size");
+  return null;
+}
+
+const SMALL = new Set(["of", "the", "and", "in", "on", "de", "la", "da"]);
+const ACRONYM: Record<string, string> = { uk: "UK", us: "US", usa: "USA", uae: "UAE", eu: "EU", drc: "DRC", un: "UN", dc: "DC" };
+
+/** An entity as the question writes it, tidied: no articles' trailing junk, and title-cased when the question had no capitals. */
+function tidy(raw: string, lowerCaseQuestion: boolean): string {
+  let s = raw
+    .trim()
+    .replace(/^[\s,:;-]+|[\s,:;.!?-]+$/g, "")
+    .replace(/\s+(?:as a whole|itself|overall|in total)$/i, "")
+    .replace(/\s+/g, " ");
+  if (lowerCaseQuestion) {
+    s = s
+      .split(" ")
+      .map((w, i) => (ACRONYM[w] ? ACRONYM[w] : SMALL.has(w) && i > 0 ? w : w.replace(/^(\(?)([a-z])/, (_m, p: string, c: string) => p + c.toUpperCase())))
+      .join(" ");
+  }
+  return s;
+}
+
+/** "(14,505 ft)" after a name → the figure and the bare name. */
+function withGiven(raw: string): { name: string; given?: Figure } {
+  const m = raw.match(/^(.*?)\s*\(\s*([^()]+?)\s*\)\s*$/);
+  if (m) {
+    const fig = parseFigure(m[2]);
+    if (fig) return { name: m[1], given: fig };
+  }
+  return { name: raw };
+}
+
+const AUX = "(?:is|are|was|were|does|do|did|has|have|had)";
+const COMP_TOKEN =
+  /\b(?:(?:a\s+)?(?:much\s+|far\s+)?(?:bigger|larger|smaller|taller|shorter|longer|higher|lower|deeper|wider|denser|faster|slower|heavier|lighter|hotter|colder|warmer|cooler|older|younger|further|farther|closer|greater)|(?:a\s+)?(?:more|less|fewer)(?:\s+\w+)?|(?:a\s+)?(?:bigger|larger|higher|lower|smaller)\s+\w+|more\s+massive)\b/i;
+
+/** Splits "Is the Eiffel Tower taller" / "Does Washington DC have more people" into the subject and the comparative phrase. */
+function splitSubjectComp(left: string): { subject: string; comp: string } | null {
+  const l = left.trim().replace(new RegExp(`^${AUX}\\s+`, "i"), "");
+  const m = COMP_TOKEN.exec(l);
+  if (!m || m.index === 0) return null;
+  const subject = l.slice(0, m.index).trim().replace(/\s+(?:have|has|had|do|does|is|are|was|were)$/i, "").trim();
+  if (!subject) return null;
+  return { subject, comp: l.slice(m.index) };
+}
+
+/** The first top-level " or " / " vs " in a string (not inside parentheses). */
+function splitOr(s: string): [string, string] | null {
+  let depth = 0;
+  for (let i = 0; i < s.length; i++) {
+    const c = s[i];
+    if (c === "(") depth++;
+    else if (c === ")") depth = Math.max(0, depth - 1);
+    else if (depth === 0) {
+      const m = /^\s+(?:or|vs\.?|versus)\s+/i.exec(s.slice(i));
+      if (m && i > 0) return [s.slice(0, i), s.slice(i + m[0].length)];
+    }
+  }
+  return null;
+}
+
+const REVERSE_TAIL = /\s*,?\s*(?:or\s+is\s+it|or\s+are\s+they|or\s+does\s+it|or\s+the)\s+(?:the\s+)?(?:reverse|other way around|opposite|other way)\b.*$/i;
+const QUAL_TAIL = /\s+(?:in|by)\s+((?:total\s+|land\s+)?(?:area|population|size|height|length|depth|diameter|mass|weight|square\s+\w+|sq\s+\w+|miles|km)\b[\w\s²]*)$/i;
+
+type Prep = { s: string; tail: string; lower: boolean };
+
+function prep(query: string): Prep | null {
+  if (/\n/.test(query.trim()) || query.length > 220) return null;
+  let s = query.replace(/\s+/g, " ").trim();
+  s = s.replace(/^(?:quick (?:one|question)|hey|hi|ok|okay|so|um+|just curious|curious|question)\s*[:,!-]*\s*/i, "");
+  const q = s.indexOf("?");
+  let tail = "";
+  if (q >= 0) {
+    tail = s.slice(q + 1).replace(/^[?\s]+/, "");
+    s = s.slice(0, q);
+    if (tail.includes("?")) return null;
+  } else if (!/^(?:is|are|was|were|does|do|did|has|have|which|who|what|[\p{L}])/iu.test(s)) return null;
+  s = s.replace(/[.!\s]+$/, "");
+  if (!s || s.length < 8) return null;
+  if (VETO.test(s)) return null;
+  return { s, tail, lower: s === s.toLowerCase() };
+}
+
+const YEAR_RE = /^(?:the\s+year\s+|year\s+)?(\d{3,4})(?:\s*(bc|bce|ad|ce))?$/i;
+const EVENT_VERB =
+  /\b(?:start(?:ed)?|began|begin|sink|sank|end(?:ed)?|dissolv\w+|collaps\w+|open(?:ed)?|built|finished|completed|signed|land(?:ed)?|founded|established|created|invented|discovered|published|released|arriv\w+|constructed|launched|born|died|fall|fell|erupt\w*|unveiled|introduced|formed|occurred|happen\w*|invaded|won|abolished|ratified|adopted|come to an end)\b/i;
+
+/** "Did the French Revolution start before 1800?", "Was the Panama Canal opened before World War II?" */
+function routeDate(p: Prep): VerdictPlan | null {
+  const m = p.s.match(/^(did|was|were)\s+(.+?)\s+(before|after)\s+(.+)$/i);
+  if (!m || /\bthan\b/i.test(p.s)) return null;
+  const ev = m[2].trim();
+  const ref = m[4].trim();
+  if (!(EVENT_VERB.test(ev) || /\bthe first\b/i.test(ev))) return null;
+  const op = m[3].toLowerCase() as "before" | "after";
+  const clause = eventClause(ev, m[1]);
+  const y = ref.match(YEAR_RE);
+  if (y) {
+    const year = parseYear(y[1], y[2] ?? "");
+    if (year === null) return null;
+    return { kind: "year", subject: clause, op, year, yearText: ref };
+  }
+  if (ref.length > 70 || /\d{2,}\s*(?:km|m|ft|miles?|kg)\b/i.test(ref)) return null;
+  // an event against an event: the same year question for both, the earlier one first
+  return {
+    kind: "compare",
+    q: "year",
+    a: { name: clause },
+    b: { name: ref },
+    dir: op === "before" ? "min" : "max",
+    form: "yesno",
+    ask: "before",
+    events: true,
+  };
+}
+
+const PAST: Record<string, string> = {
+  start: "started", begin: "began", sink: "sank", end: "ended", dissolve: "dissolved", collapse: "collapsed", open: "opened", land: "landed",
+  fall: "fell", erupt: "erupted", arrive: "arrived", form: "formed", happen: "happened", occur: "occurred", launch: "launched", die: "died",
+  invade: "invaded", win: "won",
+};
+
+/** "the Titanic sink" + did → "the Titanic sank"; "the Taj Mahal built" + was → "the Taj Mahal was built"; "the first moon landing" + was → "... was". */
+function eventClause(ev: string, aux: string): string {
+  const m = EVENT_VERB.exec(ev);
+  const a = aux.toLowerCase();
+  if (!m) return `${ev} ${a === "did" ? "happened" : a}`;
+  if (a === "did") {
+    const w = m[0].toLowerCase();
+    const past = PAST[w] ?? (w.endsWith("e") ? `${w}d` : `${w}ed`);
+    return `${ev.slice(0, m.index)}${past}${ev.slice(m.index + m[0].length)}`;
+  }
+  return `${ev.slice(0, m.index)}${a} ${m[0]}${ev.slice(m.index + m[0].length)}`;
+}
+
+const FIG_AFTER = new RegExp(`^(${FIGURE_RE})(?:\\s+(.*))?$`, "i");
+
+function figureAndTail(right: string): { fig: Figure; tail: string } | null {
+  const m = right.trim().match(FIG_AFTER);
+  if (!m) return null;
+  const whole = m[1];
+  const fig = parseFigure(whole);
+  if (!fig) return null;
+  let tail = (m[m.length - 1] ?? "").trim();
