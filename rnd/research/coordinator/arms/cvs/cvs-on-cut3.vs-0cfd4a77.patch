+
+/** Compact display of a figure in its own unit: 8849 → "8,849", 1.4e9 people → "1.4 billion", 7.35e22 → "7.35 × 10^22". */
+export function formatFigure(value: number, unit: Unit): string {
+  const abs = Math.abs(value);
+  const trim = (n: number, d = 3) => String(Number(n.toFixed(d)));
