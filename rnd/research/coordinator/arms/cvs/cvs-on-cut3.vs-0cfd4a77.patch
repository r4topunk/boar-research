+  String.raw`^\s*(?:is|are|was|were|does|do|did|has|have)\s+(.+?)\s+((?:have\s+|has\s+)?(?:a\s+)?${COMPARATIVE}\b.*?)\s+than\s+(.+?)\s*\?\s*$`,
+  "i"
+);
