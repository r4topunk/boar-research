+    else if (w === "height" || w === "elevation") q = "height";
+    else if (w === "length") q = "length";
+    else if (w === "depth") q = "depth";
+    else if (w === "area") q = "area";
+    else if (w === "mass") q = "mass";
+    else if (w === "density") q = "density";
+    else if (w === "speed") q = "speed";
+    else if (w === "temperature") q = "temperature";
