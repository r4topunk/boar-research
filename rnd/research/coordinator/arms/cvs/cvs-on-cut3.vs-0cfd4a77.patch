+const WHICH_Q = new RegExp(
+  String.raw`^\s*(?:which|who|what)\s+(.*?\b${COMPARATIVE}\b.*?)\s*[,:]\s*(.+?)\s+or\s+(.+?)(?:\s*,\s*and\b.*?|\s+and\s+by\s+how\s+much.*?)?\s*\?\s*$`,
