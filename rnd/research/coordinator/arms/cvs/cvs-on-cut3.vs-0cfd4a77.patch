+/**
+ * CV, the computed verdict (cut 3 dev, coordinator CV-criterion). English only.
+ *
+ * The 4B contradicts its own facts in about 1 of 7 comparison, threshold and "is it the largest" answers, and regex repair of
+ * free text stopped at 1 of 17 (VG line closed). So for a question whose verdict is arithmetic on a few numbers, the model
+ * is asked for the numbers only, in a strict line format, and the engine computes the verdict:
+ *
+ *   router        compare (two entities, one quantity) | threshold (a number or a year) | superlative (is X the largest ...)
+ *   facts call    one short model call: "<number> | <unit> | <year>" per item (llama.rn's completion takes a grammar, but
+ *                 GenerateOptions doesn't pass one yet, so the format is strict and the parser is lenient)
+ *   verdict       deterministic, with unit normalisation (verdictUnits.ts); any parse failure, unknown unit, unit family
+ *                 mismatch, tie or missing item abstains (null) and the normal path answers
+ *   render        verdict line, "Facts:" block, and at most two model sentences that may only use the facts' numbers
+ *
+ * Never on health, danger, card, calculator, venue or country-facts questions (the router vetoes their words, and answer.ts
+ * only calls this after those paths). The distance and the literal-figure comparisons need no model at all.
+ */
+import { lookupCity, greatCircleKm } from "./travelDistance";
+import { comparableValues, plausibleFact } from "./factSanity";
+import { type Dim, type Figure, type Unit, FIGURE_RE, formatFigure, fromBase, parseFigure, parseNumber, parseUnit, parseYear, toBase } from "./verdictUnits";
+
+export type QId =
+  | "height" | "length" | "depth" | "diameter" | "area" | "size" | "population" | "mass" | "density" | "speed"
+  | "temperature" | "gdp" | "gdp_pc" | "year" | "distance_earth" | "volume" | "abundance" | "count";
+
+interface QDef {
+  /** What the facts call asks for. */
+  label: string;
+  /** Unit the model is asked to answer in. */
+  hint: string;
+  /** Unit families a figure may come back in. */
+  dims: Dim[];
+  /** Comparative phrases: [true form, negated form] for the larger and the smaller one. */
+  max: [string, string];
+  min: [string, string];
+}
+
+const QDEFS: Record<QId, QDef> = {
+  height: { label: "height (for a mountain: elevation above sea level)", hint: "m", dims: ["length"], max: ["is taller than", "is not taller than"], min: ["is shorter than", "is not shorter than"] },
+  length: { label: "length", hint: "km", dims: ["length"], max: ["is longer than", "is not longer than"], min: ["is shorter than", "is not shorter than"] },
+  depth: { label: "maximum depth", hint: "m", dims: ["length"], max: ["is deeper than", "is not deeper than"], min: ["is shallower than", "is not shallower than"] },
+  diameter: { label: "diameter", hint: "km", dims: ["length"], max: ["is wider than", "is not wider than"], min: ["is narrower than", "is not narrower than"] },
+  area: { label: "total area", hint: "km²", dims: ["area"], max: ["is larger in area than", "is not larger in area than"], min: ["is smaller in area than", "is not smaller in area than"] },
