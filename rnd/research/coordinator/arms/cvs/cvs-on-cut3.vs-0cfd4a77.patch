+
+const SUP_RE =
+  /^(?:is|are|was|were)\s+(.+?)\s+(?:(?:still|now|currently|really|actually|always)\s+)?the\s+(largest|biggest|smallest|longest|shortest|tallest|highest|lowest|deepest|oldest|youngest|hottest|coldest|fastest|heaviest|most\s+(?:populous|common|massive))\s*(.*)$/i;
+
+/** "Is X the largest ...?" */
+function routeSuperlative(p: Prep): VerdictPlan | null {
+  const m = p.s.match(SUP_RE);
+  if (!m) return null;
+  const subject = tidy(m[1], p.lower);
+  const sup = m[2].toLowerCase().replace(/\s+/g, " ");
+  let rest = m[3].trim();
+  if (/\b(?:measured|based on|when|if|since|excluding|including)\b/i.test(rest)) return null;
+  let by = "";
+  const byM = rest.match(/\s*\bby\s+((?:total\s+|land\s+)?(?:area|volume|population|height|length|depth|mass|weight|size))\b/i);
+  if (byM) {
+    by = byM[1].toLowerCase().replace(/^(?:total|land)\s+/, "");
+    rest = rest.replace(byM[0], "").trim();
+  } else if (/\bby\b/i.test(rest)) return null;
+  const sm = rest.match(/^(.*?)(?:\s+((?:in|on|of|within|among|across)\s+.+))?$/i);
+  const category = (sm?.[1] ?? "").trim();
+  const scope = (sm?.[2] ?? "").trim();
+  if (!category && !scope) return null;
+  const dir: "max" | "min" = /^(?:smallest|shortest|lowest|coldest|youngest)$/.test(sup) ? "min" : "max";
+  const cat = category.toLowerCase();
+  let q: QId | null = null;
+  if (by === "volume") q = "volume";
+  else if (by === "area" || by === "size") q = "area";
+  else if (by === "population") q = "population";
+  else if (by === "height") q = "height";
+  else if (by === "length") q = "length";
+  else if (by === "depth") q = "depth";
+  else if (by === "mass" || by === "weight") q = "mass";
+  else if (sup === "most populous") q = "population";
+  else if (sup === "most common") q = "abundance";
+  else if (sup === "most massive" || sup === "heaviest") q = "mass";
+  else if (sup === "oldest" || sup === "youngest") q = "year";
+  else if (sup === "hottest" || sup === "coldest") q = "temperature";
+  else if (sup === "fastest") q = "speed";
+  else if (sup === "deepest") q = "depth";
+  else if (sup === "longest" || sup === "shortest") q = "length";
+  else if (sup === "tallest" || sup === "highest" || sup === "lowest") q = "height";
+  else if (sup === "largest" || sup === "biggest" || sup === "smallest") {
+    if (/\b(?:animal|whale|dinosaur|mammal|bird|fish|creature|species)\b/.test(cat)) q = "mass";
+    else if (/\b(?:planet|moon|star)\b/.test(cat)) q = "diameter";
+    else q = "area";
+  }
+  if (!q || q === "year") return null;
+  return { kind: "superlative", q, subject, dir, category: category || "item", scope, sup, by };
+}
+
+const FACTOR_RE = /^(twice|double|half|two times|three times|(\d+(?:\.\d+)?)\s+times)\s+(?:as\s+\w+\s+as\s+|the\s+(?:\w+\s+)?(?:of\s+)?|that of\s+)?(.+)$/i;
+
+/** "Is the Eiffel Tower taller than the Empire State Building?" and its relatives. */
+function routeCompareYesNo(p: Prep): VerdictPlan | null {
+  const than = p.s.search(/\bthan\b/i);
+  if (than <= 0 || !new RegExp(`^${AUX}\\b`, "i").test(p.s)) return null;
+  const sc = splitSubjectComp(p.s.slice(0, than));
+  if (!sc) return null;
+  let right = p.s.slice(than + 4).trim().replace(REVERSE_TAIL, "");
+  let compText = sc.comp;
+  const qm = right.match(QUAL_TAIL);
+  if (qm) {
+    right = right.slice(0, right.length - qm[0].length);
+    compText += ` ${qm[0]}`;
+  }
+  let factor: number | undefined;
+  let factorWord: string | undefined;
+  const fm = right.match(FACTOR_RE);
+  if (fm) {
+    const w = fm[1].toLowerCase();
+    factor = w === "twice" || w === "double" || w === "two times" ? 2 : w === "half" ? 0.5 : w === "three times" ? 3 : Number(fm[2]);
+    factorWord = w.endsWith("times") ? `${factor} times` : w === "double" ? "twice" : w;
+    right = fm[3].trim();
+  }
+  if (!right || /^\d/.test(right)) return null;
+  let leftName = sc.subject;
+  let hit = inferQuantity(compText);
+  const poss = leftName.match(/^(.+?)(?:'s|’s)\s+(population|diameter|height|length|depth|area|mass|density|speed|temperature)$/i);
+  if (poss) {
+    leftName = poss[1];
+    hit = inferQuantity(poss[2]) ?? hit;
+  }
+  if (!hit) return null;
+  const a = withGiven(tidy(leftName, p.lower));
+  const b = withGiven(tidy(right.replace(/^(?:the\s+)?(?:diameter|height|population|area|mass|density|length)\s+of\s+/i, ""), p.lower));
+  if (!a.name || !b.name || a.name.toLowerCase() === b.name.toLowerCase()) return null;
+  return { kind: "compare", q: hit.q, a, b, dir: hit.dir, form: "yesno", ask: hit.ask, ...(factor !== undefined ? { factor, factorWord } : {}) };
+}
+
+/** "Which is denser, gold or lead?", "Burj Khalifa or Shanghai Tower, which one's taller?" */
+function routeCompareWhich(p: Prep): VerdictPlan | null {
+  const s = p.s;
+  let a = "";
+  let b = "";
+  let compText = "";
+  const front = s.match(/^(?:which|who|what)\b(.*)$/i);
+  if (front) {
+    const rest = front[1];
+    // the entities follow the comparative clause: after the first comma/colon past the comparative word
+    const comp = COMP_TOKEN.exec(rest) ?? /\b(?:faster|runs faster|covers more|has more|more)\b/i.exec(rest);
+    const sepIdx = rest.search(/[,:]/);
+    let head: string;
+    let entities: string;
+    if (sepIdx < 0) {
+      // "which has more people north korea or south korea": the entities follow the comparative phrase
+      if (!comp) return null;
+      head = rest.slice(0, comp.index + comp[0].length);
+      entities = rest.slice(comp.index + comp[0].length);
+    } else {
+      const lastColon = rest.lastIndexOf(":");
+      const cut = lastColon >= 0 && rest.slice(0, lastColon).search(/\b(?:or|vs)\b/i) < 0 ? lastColon : sepIdx;
+      head = rest.slice(0, cut);
+      entities = rest.slice(cut + 1);
+    }
+    const pair = splitOr(entities.replace(/,\s+(?=(?:or|vs\.?)\s)/i, " "));
+    if (!pair) return null;
+    compText = head;
+    if (!comp && !inferQuantity(head)) return null;
+    a = pair[0];
+    b = pair[1].replace(/\s*,.*$/, "");
+  } else {
+    const m = s.match(/^(.+?)\s+(?:or|vs\.?|versus)\s+(.+?)\s*(?:[,:]|\s[-–—]\s)\s*(?:which|who|what)\b(.*)$/i);
+    if (!m) return null;
+    a = m[1];
+    b = m[2];
+    compText = m[3];
+  }
+  if (REVERSE_TAIL.test(b)) b = b.replace(REVERSE_TAIL, "");
+  const hit = inferQuantity(`${compText} ${p.tail}`);
+  if (!hit) return null;
+  const ea = withGiven(tidy(a, p.lower));
+  const eb = withGiven(tidy(b, p.lower));
+  if (!ea.name || !eb.name || ea.name.split(" ").length > 8 || eb.name.split(" ").length > 8) return null;
+  if (ea.name.toLowerCase() === eb.name.toLowerCase()) return null;
+  const showUnit = p.tail.match(/\bin\s+(miles|kilometers|kilometres|km|meters|metres|feet|ft)\b/i)?.[1];
+  return { kind: "compare", q: hit.q, a: ea, b: eb, dir: hit.dir, form: "which", ask: hit.ask, ...(showUnit ? { showUnit } : {}) };
+}
+
+/** Two literal figures: "Is 100 °F hotter than 40 °C?" (no model needed). */
+function routeLiteral(p: Prep): VerdictPlan | null {
+  const than = p.s.search(/\bthan\b/i);
+  if (than <= 0) return null;
+  const left = p.s.slice(0, than).trim().replace(new RegExp(`^${AUX}\\s+`, "i"), "");
+  const m = left.match(/^(.+?)\s+((?:much\s+|far\s+)?(?:hotter|colder|warmer|cooler|taller|shorter|longer|heavier|lighter|faster|slower|bigger|larger|smaller|higher|lower))$/i);
+  if (!m) return null;
+  const a = parseFigure(m[1]);
+  const b = parseFigure(p.s.slice(than + 4));
+  if (!a || !b || a.unit.dim !== b.unit.dim) return null;
+  const hit = inferQuantity(m[2]);
+  if (!hit) return null;
+  const q: QId = hit.q === "size" ? (a.unit.dim === "area" ? "area" : "length") : hit.q;
+  return { kind: "literal", a, b, q, dir: hit.dir, aName: m[1].trim(), bName: p.s.slice(than + 4).trim(), yesno: true };
+}
+
+/** "Is London farther from New York or from Cairo?", from the bundled city table. */
+function routeDistance(p: Prep): VerdictPlan | null {
+  const m = p.s.match(/^(?:is|are)\s+(.+?)\s+(closer|farther|further)\s+(?:away\s+)?(?:to|from)\s+(.+?)\s+or\s+(?:to\s+|from\s+)?(.+)$/i);
+  if (!m) return null;
+  const look = (x: string) => lookupCity(x) ?? (/^new york$/i.test(x.trim()) ? lookupCity("New York City") : null);
+  const from = look(m[1]);
+  const a = look(m[3]);
+  const b = look(m[4]);
+  if (!from || !a || !b || a === b || from === a || from === b) return null;
+  return {
+    kind: "distance",
+    from: from.name,
+    a: a.name,
+    b: b.name,
+    km: [greatCircleKm(from, a), greatCircleKm(from, b)],
+    dir: /closer/i.test(m[2]) ? "min" : "max",
+  };
+}
+
+/** The router: a plan for a verdict question computable from numbers, or null (the normal path). English only. */
+export function routeVerdict(query: string): VerdictPlan | null {
+  const p = prep(query);
+  if (!p) return null;
+  return (
+    routeLiteral(p) ??
+    routeDistance(p) ??
+    routeDate(p) ??
+    routeThreshold(p) ??
+    // Revision 1: superlative / rank questions ("is X the largest ...") are not routed: they need the true global holder, which the 4B recalls badly.
+    routeCompareYesNo(p) ??
+    routeCompareWhich(p)
+  );
+}
+
+/* ───────────────────────── facts call ───────────────────────── */
+
+const FACTS_SYSTEM =
+  "You are a fact lookup tool. For each item named, give the best-known figure from memory for the quantity asked. " +
+  "Reply with exactly one line per item, in the order given, and nothing else. Each line has four fields separated by ' | ': " +
+  "<item name> | <number> | <unit> | <year the figure is for, or - if it does not apply>. " +
+  "Write the number in digits (a decimal point if needed, no commas, no ranges). For big numbers put the scale in the unit, such as 'million km²' or 'million people'. " +
+  "If you do not know an item, write: <item name> | ? | ? | ?\n" +
+  "Example (format only; these items are made up). Quantity: area, preferred unit km².\nItems:\n- Examplia\n- Sampleland\nReply:\n" +
+  "Examplia | 3.2 | million km² | 2020\nSampleland | 41000 | km² | 2020";
+
+const YEAR_SYSTEM =
+  "You are a fact lookup tool. For each item named, give the year it happened. " +
+  "(Something built: the year it was completed. A war or a revolution: the year it began. A treaty or declaration: the year it was signed. " +
+  "A university, state or company: the year it was founded.) Reply with exactly one line per item, in the order given, and nothing else. " +
+  "Each line: <item name> | <year> | <BC or AD>. If you do not know, write: <item name> | ? | ?\n" +
+  "Example (format only). Items:\n- the Eiffel Tower completed\n- the fall of Rome\nReply:\n" +
+  "the Eiffel Tower completed | 1889 | AD\nthe fall of Rome | 476 | AD";
+
+const SUP_SYSTEM =
+  "You are a fact lookup tool. List the 3 top items of the category asked, in order from the top, then give the figure for the item to check. " +
+  "Reply with exactly 4 lines and nothing else. Each line: <name> | <number> | <unit>. Lines 1 to 3 are the top 3; line 4 is the item to check. " +
+  "Write numbers in digits (a decimal point if needed, no commas, no ranges); for big numbers put the scale in the unit, such as 'million km²'. If you do not know, write the name and: ? | ?\n" +
+  "Example (format only), ranked by height, preferred unit m, item to check: Big Ben:\nReply:\nBurj Khalifa | 828 | m\nShanghai Tower | 632 | m\nAbraj Al-Bait | 601 | m\nBig Ben | 96 | m";
+
+export interface FactsPrompt {
+  system: string;
+  user: string;
+  maxTokens: number;
+}
+
+function qLabel(q: QId, override?: string): string {
+  return override ?? QDEFS[q].label;
+}
+
+const bullets = (names: string[]) => names.map((n) => `- ${n}`).join("\n");
+
+/** The facts call for a plan (the items the question did not already give a figure for), or null when none is needed. */
+export function factsPrompt(plan: VerdictPlan): FactsPrompt | null {
+  switch (plan.kind) {
+    case "compare": {
+      const items = [plan.a, plan.b].filter((e) => !e.given).map((e) => e.name);
+      if (!items.length) return null;
+      if (plan.q === "year") return { system: YEAR_SYSTEM, user: `Items:\n${bullets(items)}`, maxTokens: 28 * items.length + 8 };
+      return {
+        system: FACTS_SYSTEM,
+        user: `Quantity: ${qLabel(plan.q, plan.label)}, preferred unit ${QDEFS[plan.q].hint}\nItems:\n${bullets(items)}`,
+        maxTokens: 36 * items.length + 8,
+      };
+    }
+    case "threshold":
+      return {
+        system: FACTS_SYSTEM,
+        user: `Quantity: ${qLabel(plan.q, plan.label)}, preferred unit ${plan.q === "count" ? "count" : QDEFS[plan.q].hint}\nItems:\n${bullets([plan.item])}`,
+        maxTokens: 44,
+      };
+    case "year":
+      return { system: YEAR_SYSTEM, user: `Items:\n${bullets([plan.subject])}`, maxTokens: 32 };
+    case "superlative":
+      return {
+        system: SUP_SYSTEM,
+        user: `Category: the ${plan.sup} ${plan.category}${plan.scope ? ` ${plan.scope}` : ""}${plan.by ? ` by ${plan.by}` : ""}\nRanked by: ${qLabel(plan.q)}, preferred unit ${QDEFS[plan.q].hint}\nItem to check: ${plan.subject}`,
+        maxTokens: 130,
+      };
+    default:
+      return null;
+  }
+}
+
+export interface Fact {
+  name: string;
+  /** Value in the dimension's base unit (a signed year for q = year). */
+  base: number;
+  unit: Unit | null;
+  /** The figure in the unit the model wrote it in. */
+  raw: number;
+}
+
+const COUNT_UNIT: Unit = { dim: "count", label: "", factor: 1, offset: 0 };
+const SCALE_WORD: Record<string, number> = { thousand: 1e3, k: 1e3, million: 1e6, billion: 1e9, bn: 1e9, trillion: 1e12 };
+
+function fieldsOf(line: string): string[] {
+  return line
+    .replace(/^\s*(?:[-*•]\s+|\d+\s*[.)]\s+)/, "")
+    .split("|")
+    .map((x) => x.trim());
+}
+
+export interface Row {
+  name: string;
+  fact: Fact | null;
+}
+
+/** One reply line, "<name> | <number> | <unit> | <year>" (the name may be absent): its figure in the unit family asked, else null. */
+function parseRow(line: string, q: QId, hintDims: Dim[]): Row {
+  const f = fieldsOf(line);
+  const named = f.length >= 2 && parseNumber(f[0]) === null && f[0] !== "?";
+  const name = named ? f[0] : "";
+  const rest = named ? f.slice(1) : f;
+  const valueField = rest[0] ?? "";
+  const unitField = rest[1] ?? "";
+  const none: Row = { name, fact: null };
+  if (valueField === "?" || !valueField) return none;
+  if (q === "year") {
+    const y = parseYear(valueField, unitField);
+    return { name, fact: y === null ? null : { name: "", base: y, unit: COUNT_UNIT, raw: y } };
+  }
+  let v = parseNumber(valueField);
+  if (v === null) return none;
+  // "million km²", "billion", "million people": the scale word leads the unit
+  let unitText = unitField;
+  const sm = unitText.match(/^(thousand|million|billion|trillion|bn|k)\b\s*(.*)$/i);
+  if (sm) {
+    v *= SCALE_WORD[sm[1].toLowerCase()];
+    unitText = sm[2];
+  }
+  let unit = parseUnit(unitText);
+  if (!unit && !unitText.trim() && q === "population") unit = parseUnit("people");
+  if (!unit && !unitText.trim() && (q === "gdp" || q === "gdp_pc")) unit = parseUnit("USD");
+  if (!unit && q === "count") unit = COUNT_UNIT;
+  if (!unit || !hintDims.includes(unit.dim)) return none;
+  const base = toBase(v, unit);
+  // a figure the unit can't have (a negative length, area or population)
+  if (unit.dim !== "temperature" && base < 0) return none;
+  return { name, fact: { name: "", base, unit, raw: v } };
+}
+
+const linesOf = (reply: string) =>
+  reply
+    .split("\n")
+    .map((l) => l.trim())
+    .filter((l) => l.includes("|"));
+
+/**
+ * Parses the facts reply into one figure per requested item, in the order asked. A line is matched to its item by the name it
+ * echoes, else by position. Anything unparseable, in an unknown unit or in the wrong unit family is null.
+ */
+export function parseFacts(reply: string, items: string[] | number, q: QId, hintDims: Dim[] = QDEFS[q].dims): (Fact | null)[] {
+  const names = typeof items === "number" ? Array.from({ length: items }, () => "") : items;
+  const rows = linesOf(reply).map((l) => parseRow(l, q, hintDims));
+  const out: (Fact | null)[] = names.map(() => null);
+  const used = new Set<number>();
+  names.forEach((nm, i) => {
+    const j = nm ? rows.findIndex((r, k) => !used.has(k) && r.name && sameName(r.name, nm)) : -1;
+    if (j >= 0) {
+      used.add(j);
+      out[i] = rows[j].fact;
+    }
+  });
+  let next = 0;
+  names.forEach((nm, i) => {
+    if (out[i] || (nm && rows.some((r, k) => !used.has(k) && r.name && sameName(r.name, nm)))) return;
+    while (next < rows.length && used.has(next)) next++;
+    if (next < rows.length && (!nm || !rows[next].name || !names.some((other, o) => o !== i && sameName(rows[next].name, other)))) {
+      used.add(next);
+      out[i] = rows[next].fact;
+    }
+  });
+  return out;
+}
+
+/* ───────────────────────── names, rendering ───────────────────────── */
+
+const GENERIC = new Set(["the", "river", "lake", "mount", "mt", "sea", "ocean", "desert", "island", "state", "country", "republic", "of", "city", "and", "a", "an"]);
+const ABBR: Record<string, string> = { us: "united states", usa: "united states", america: "united states", uk: "united kingdom", britain: "united kingdom", uae: "united arab emirates", eu: "european union", drc: "congo" };
+
+function nameTokens(s: string): string[] {
+  const t = s
+    .toLowerCase()
+    .replace(/[^a-z0-9 ]/g, " ")
+    .split(/\s+/)
+    .filter(Boolean);
+  const exp = t.flatMap((w) => (ABBR[w] ? ABBR[w].split(" ") : [w]));
+  const core = exp.filter((w) => !GENERIC.has(w));
+  return core.length ? core : exp;
+}
+
+/** Two names for one thing ("the Mississippi River" / "Mississippi", "US" / "United States of America"). */
+export function sameName(a: string, b: string): boolean {
+  const x = nameTokens(a);
+  const y = nameTokens(b);
+  if (!x.length || !y.length) return false;
+  return x.every((w) => y.includes(w)) || y.every((w) => x.includes(w));
+}
+
+const cap = (s: string) => (s ? s[0].toUpperCase() + s.slice(1) : s);
+
+function showFigure(f: Fact, firstUnit: Unit | null, displayUnit?: string): string {
+  if (!f.unit) return String(f.raw);
+  const target = displayUnit ? parseUnit(displayUnit) : null;
+  if (target && target.dim === f.unit.dim) return formatFigure(fromBase(f.base, target), target);
+  const own = formatFigure(f.raw, f.unit);
+  if (firstUnit && firstUnit.dim === f.unit.dim && firstUnit.label !== f.unit.label) {
+    return `${own} (= ${formatFigure(fromBase(f.base, firstUnit), firstUnit)})`;
+  }
+  return own;
+}
+
+const yearText = (y: number) => (y < 0 ? `${-y} BC` : String(y));
+
+const CAVEAT = "These figures are the model's recall, not checked against a source.";
+
+function factsBlock(lines: string[], note: string | null): string {
+  return `Facts:\n${lines.map((l) => `- ${l}`).join("\n")}${note ? `\n${note}` : ""}`;
+}
+
+/* ───────────────────────── compute and render ───────────────────────── */
+
+export interface Computed {
+  kind: VerdictPlan["kind"];
+  verdict: string;
+  facts: string[];
+  yes: boolean | null;
+  winner: string | null;
+  /** Numbers the verdict and facts show (for the sentence check). */
+  figures: string[];
+}
+
+/** Equal figures (float noise only): the verdict abstains, it never calls a tie. */
+const nearlyEqual = (a: number, b: number) => Math.abs(a - b) <= 1e-9 * Math.max(1, Math.abs(a), Math.abs(b));
+
+function cmpPhrase(plan: Extract<VerdictPlan, { kind: "compare" }>, positive: boolean): string {
+  if (plan.q === "year" && plan.ask === "before") {
+    return plan.dir === "min" ? (positive ? "came before" : "did not come before") : positive ? "came after" : "did not come after";
+  }
+  const d = QDEFS[plan.q];
+  const [pos, neg] = plan.dir === "max" ? d.max : d.min;
+  return positive ? pos : neg;
+}
+
+/** Facts for a compare plan (given figures first, then the model's, in entity order) → verdict, or null to abstain. */
+function computeCompare(plan: Extract<VerdictPlan, { kind: "compare" }>, got: (Fact | null)[]): Computed | null {
+  const items = [plan.a, plan.b];
+  let k = 0;
+  const f: Fact[] = [];
+  for (const e of items) {
+    if (e.given) f.push({ name: e.name, base: e.given.base, unit: e.given.unit, raw: fromBase(e.given.base, e.given.unit) });
+    else {
+      const x = got[k++];
+      if (!x) return null;
+      // CVS: a figure the model gave that its entity class rules out abstains (a figure the question gave is never checked)
+      if (!plausibleFact(e.name, plan.q === "year" ? "year" : x.unit?.dim ?? "count", x.base)) return null;
+      f.push({ ...x, name: e.name });
+    }
+  }
+  const [fa, fb] = f;
+  if (plan.q !== "year") {
+    if (!fa.unit || !fb.unit || fa.unit.dim !== fb.unit.dim) return null;
+    if (!QDEFS[plan.q].dims.includes(fa.unit.dim)) return null;
+  }
+  if (plan.q !== "year" && fa.unit && !comparableValues(fa.name, fb.name, fa.unit.dim, fa.base, fb.base)) return null;
+  const rawA = fa.base;
+  const rawB = plan.factor !== undefined ? fb.base * plan.factor : fb.base;
+  if (nearlyEqual(rawA, rawB)) return null;
+  const aWins = plan.dir === "max" ? rawA > rawB : rawA < rawB;
+  const firstUnit = fa.unit;
+  const label = plan.q === "year" ? "year" : plan.q === "size" ? (fa.unit?.dim === "area" ? "area" : fa.unit?.dim === "mass" ? "mass" : "diameter") : QDEFS[plan.q].label.replace(/\s*\(.*\)$/, "");
+  const lineFor = (x: Fact) =>
+    plan.q === "year" ? `${cap(x.name)}: ${yearText(x.base)}` : `${cap(x.name)}: ${label} ${showFigure(x, x === fa ? null : firstUnit, plan.showUnit)}`;
+  const facts = [lineFor(fa), lineFor(fb)];
+  const figures = f.map((x) => (plan.q === "year" ? yearText(x.base) : showFigure(x, null, plan.showUnit)));
+  let verdict: string;
+  let winner: string | null;
+  if (plan.form === "which") {
+    winner = aWins ? fa.name : fb.name;
+    const loser = aWins ? fb.name : fa.name;
+    verdict = `${cap(winner)} ${cmpPhrase(plan, true)} ${loser}.`;
+    return { kind: "compare", verdict, facts, yes: null, winner, figures };
+  }
+  winner = null;
+  if (plan.events) {
+    verdict = `${aWins ? "Yes" : "No"}. ${cap(fa.name)} in ${yearText(fa.base)}, which is ${aWins ? "" : "not "}${plan.dir === "min" ? "before" : "after"} ${fb.name} in ${yearText(fb.base)}.`;
+  } else if (plan.factor !== undefined) {
+    const ratio = fb.base ? fa.base / fb.base : 0;
+    verdict = `${aWins ? "Yes" : "No"}. ${fa.name} ${cmpPhrase(plan, aWins)} ${plan.factorWord} ${fb.name} (about ${Number(ratio.toFixed(2))} times).`;
+  } else verdict = `${aWins ? "Yes" : "No"}. ${cap(fa.name)} ${cmpPhrase(plan, aWins)} ${fb.name}.`;
+  return { kind: "compare", verdict, facts, yes: aWins, winner, figures };
+}
+
+function computeThreshold(plan: Extract<VerdictPlan, { kind: "threshold" }>, got: Fact | null): Computed | null {
+  if (!got || !got.unit) return null;
+  if (!plausibleFact(plan.item, got.unit.dim, got.base)) return null;
+  const lim = plan.limit;
+  const wantDims = plan.q === "count" ? (["count"] as Dim[]) : QDEFS[plan.q].dims;
+  if (got.unit.dim !== lim.unit.dim || !wantDims.includes(got.unit.dim)) return null;
+  if (nearlyEqual(got.base, lim.base)) return null;
+  const yes = plan.op === "gt" ? got.base > lim.base : got.base < lim.base;
+  const limitText = lim.unit.dim === "count" ? String(lim.text) : formatFigure(fromBase(lim.base, lim.unit), lim.unit);
+  const ownRaw = got.unit.dim === "count" ? String(got.raw) : formatFigure(got.raw, got.unit);
+  const own = got.unit.dim !== "count" && got.unit.label !== lim.unit.label ? `${ownRaw} (= ${formatFigure(fromBase(got.base, lim.unit), lim.unit)})` : ownRaw;
+  const subj = plan.subject;
+  let verdict: string;
+  if (plan.verb === "have") verdict = yes ? `Yes. ${cap(subj)} has ${plan.opText} ${limitText}${plan.q === "count" ? ` ${plan.label?.replace(/^number of /, "") ?? ""}` : ""}.` : `No. ${cap(subj)} does not have ${plan.opText} ${limitText}${plan.q === "count" ? ` ${plan.label?.replace(/^number of /, "") ?? ""}` : ""}.`;
+  else if (plan.verb === "be") verdict = yes ? `Yes. ${cap(subj)} is ${plan.opText} ${limitText}.` : `No. ${cap(subj)} is not ${plan.opText} ${limitText}.`;
+  else verdict = yes ? `Yes. ${cap(subj)} ${plan.verb}s ${plan.opText} ${limitText}.` : `No. ${cap(subj)} does not ${plan.verb} ${plan.opText} ${limitText}.`;
+  const dimWord: Partial<Record<QId, string>> = { length: "long", height: "tall", depth: "deep", diameter: "wide" };
+  if (plan.verb === "be" && dimWord[plan.q] && /^(?:more than|over|above|under|below|less than|beyond|greater than|at least|at most|exceed)$/.test(plan.opText)) {
+    verdict = verdict.replace(/\.$/, ` ${dimWord[plan.q]}.`);
+  }
+  verdict = verdict.replace(/\s+\./, ".");
+  const label = plan.label ?? QDEFS[plan.q].label.replace(/\s*\(.*\)$/, "");
+  return {
+    kind: "threshold",
+    verdict,
+    facts: [`${cap(plan.item)}: ${label} ${own}`, `Threshold in the question: ${limitText}`],
+    yes,
+    winner: null,
+    figures: [own, limitText],
+  };
+}
+
+function computeYear(plan: Extract<VerdictPlan, { kind: "year" }>, got: Fact | null): Computed | null {
+  if (!got) return null;
+  const y = got.base;
+  if (!plausibleFact(plan.subject, "year", y)) return null;
+  if (y === plan.year) return null;
+  const yes = plan.op === "before" ? y < plan.year : y > plan.year;
+  const verb = plan.op === "before" ? "before" : "after";
+  return {
+    kind: "year",
+    verdict: `${yes ? "Yes" : "No"}. ${cap(plan.subject)} in ${yearText(y)}, which is ${yes ? "" : "not "}${verb} ${plan.yearText}.`,
+    facts: [`${cap(plan.subject)}: ${yearText(y)}`, `Year in the question: ${plan.yearText}`],
+    yes,
+    winner: null,
+    figures: [yearText(y), plan.yearText],
+  };
+}
+
+interface NamedFact extends Fact {
+  name: string;
+}
+
+/** The superlative reply: up to 4 named, parseable lines (the top 3, then the item's own line). */
+export function parseSuperlative(reply: string, q: QId): NamedFact[] {
+  const dims = QDEFS[q].dims;
+  const rows: NamedFact[] = [];
+  for (const line of linesOf(reply).slice(0, 4)) {
+    const r = parseRow(line, q, dims);
+    if (r.name && r.fact) rows.push({ ...r.fact, name: r.name });
+  }
+  return rows;
+}
+
+export function computeSuperlativeFrom(plan: Extract<VerdictPlan, { kind: "superlative" }>, reply: string): Computed | null {
+  if (plan.q === "year") return null;
+  const rows = parseSuperlative(reply, plan.q);
+  if (rows.length < 2) return null;
+  const d0 = rows[0].unit?.dim;
+  if (!d0 || rows.some((x) => x.unit?.dim !== d0)) return null;
+  // the item's own line is the 4th; failing that it must be one of the listed names
+  const own = rows.length === 4 && sameName(rows[3].name, plan.subject) ? rows[3] : rows.slice(0, 3).find((x) => sameName(x.name, plan.subject));
+  if (!own) return null;
+  const others = rows.slice(0, 3).filter((x) => !sameName(x.name, plan.subject));
+  if (!others.length) return null;
+  const better = (x: number, y: number) => (plan.dir === "max" ? x > y : x < y);
+  const leader = others.reduce((a, b) => (better(b.base, a.base) ? b : a));
+  if (nearlyEqual(leader.base, own.base)) return null;
+  const yes = !better(leader.base, own.base);
+  const label = QDEFS[plan.q].label.replace(/\s*\(.*\)$/, "");
+  const shown = (x: NamedFact) => `${cap(x.name)}: ${label} ${formatFigure(x.raw, x.unit as Unit)}`;
+  const facts = [shown({ ...own, name: plan.subject }), ...others.map(shown)];
+  const scope = [plan.category, plan.scope, plan.by ? `by ${plan.by}` : ""].filter(Boolean).join(" ").trim();
+  const subj = cap(plan.subject);
+  const verdict = yes ? `Yes. ${subj} is the ${plan.sup} ${scope}.` : `No. ${subj} is not the ${plan.sup} ${scope}; ${leader.name} is ahead of it.`;
+  return { kind: "superlative", verdict, facts, yes, winner: yes ? plan.subject : leader.name, figures: facts };
+}
+
+function computeLiteral(plan: Extract<VerdictPlan, { kind: "literal" }>): Computed | null {
+  const { a, b } = plan;
+  if (nearlyEqual(a.base, b.base)) {
+    return { kind: "literal", verdict: `No. ${plan.aName} and ${plan.bName} are equal.`, facts: [`${plan.aName} = ${plan.bName}`], yes: false, winner: null, figures: [] };
+  }
+  const aWins = plan.dir === "max" ? a.base > b.base : a.base < b.base;
+  const word = QDEFS[plan.q as QId];
+  const phrase = (aWins ? (plan.dir === "max" ? word.max[0] : word.min[0]) : plan.dir === "max" ? word.max[1] : word.min[1]).replace(/^(?:has|does not have)\b/, "is");
+  const inA = (x: Figure) => formatFigure(fromBase(x.base, a.unit), a.unit);
+  return {
+    kind: "literal",
+    verdict: `${aWins ? "Yes" : "No"}. ${plan.aName} ${phrase} ${plan.bName}.`,
+    facts: [`${plan.aName} = ${inA(a)}`, `${plan.bName} = ${inA(b)}`],
+    yes: aWins,
+    winner: null,
+    figures: [],
+  };
+}
+
+function computeDistance(plan: Extract<VerdictPlan, { kind: "distance" }>): Computed | null {
+  const [da, db] = plan.km;
+  if (nearlyEqual(da, db)) return null;
+  const nearA = da < db;
+  const winner = (plan.dir === "min" ? nearA : !nearA) ? plan.a : plan.b;
+  const loser = winner === plan.a ? plan.b : plan.a;
+  const fmt = (x: number) => `${Math.round(x).toLocaleString("en-US")} km (${Math.round(x * 0.621371).toLocaleString("en-US")} mi)`;
+  return {
+    kind: "distance",
+    verdict: `${plan.from} is ${plan.dir === "min" ? "closer to" : "farther from"} ${winner} than ${loser}.`,
+    facts: [`${plan.from} to ${plan.a}: ${fmt(da)} in a straight line`, `${plan.from} to ${plan.b}: ${fmt(db)} in a straight line`],
+    yes: null,
+    winner,
+    figures: [],
+  };
+}
+
+/* ───────────────────────── entry point ───────────────────────── */
+
+export type Generate = (system: string, user: string, maxTokens: number) => Promise<string>;
+
+const EXPLAIN_SYSTEM =
+  "Write one or two short plain sentences of context about this comparison. Use ONLY the facts given: do not state any number that is not in them, " +
+  "do not repeat the verdict word for word, and do not add new facts. Reply with the sentences only.";
+
+function numbersIn(s: string): string[] {
+  return (s.match(/\d[\d,]*(?:\.\d+)?/g) ?? []).map((x) => x.replace(/,/g, ""));
+}
+
+/** Keeps at most two model sentences, and only those whose numbers all come from the facts (or are 1-2 digit counts). */
+export function constrainSentences(reply: string, allowed: string): string {
+  const ok = new Set(numbersIn(allowed));
+  const sentences = reply
+    .replace(/\s+/g, " ")
+    .trim()
+    .split(/(?<=[.!?])\s+/)
+    .filter((x) => x.length >= 12 && x.length <= 240);
+  const keep: string[] = [];
+  for (const sentence of sentences) {
+    if (/^(?:yes|no)\b/i.test(sentence)) continue;
+    if (/\b(?:however|but actually|correction|note:|contradict\w*|incorrect\w*|inaccura\w*|error|mistake|typo|actually|seems|appears|unrealistic|implausible|not accurate|I )\b/i.test(sentence)) continue;
+    if (numbersIn(sentence).some((n) => !ok.has(n) && !(n.length <= 1))) continue;
+    keep.push(sentence);
+    if (keep.length === 2) break;
+  }
+  return keep.join(" ");
+}
+
+export interface RunOptions {
+  /** Skip the optional model sentences (L0 timing, tests). */
+  noSentences?: boolean;
+}
+
+/** Route, ask the model for the figures, compute, render. Null (abstain) leaves the question to the normal path. */
+export async function computedVerdictAnswer(query: string, generate: Generate, opts: RunOptions = {}): Promise<ComputedVerdict | null> {
+  const plan = routeVerdict(query);
+  if (!plan) return null;
+  return answerPlan(plan, generate, opts);
+}
+
+export async function answerPlan(plan: VerdictPlan, generate: Generate, opts: RunOptions = {}): Promise<ComputedVerdict | null> {
+  let computed: Computed | null = null;
+  if (plan.kind === "literal") computed = computeLiteral(plan);
+  else if (plan.kind === "distance") computed = computeDistance(plan);
+  else {
+    const fp = factsPrompt(plan);
+    let reply = "";
+    if (fp) {
+      try {
+        reply = await generate(fp.system, fp.user, fp.maxTokens);
+      } catch {
+        return null;
+      }
+    }
+    if (plan.kind === "compare") {
+      const need = [plan.a, plan.b].filter((e) => !e.given).map((e) => e.name);
+      computed = computeCompare(plan, need.length ? parseFacts(reply, need, plan.q) : []);
+    } else if (plan.kind === "threshold") {
+      computed = computeThreshold(plan, parseFacts(reply, [plan.item], plan.q, plan.q === "count" ? ["count"] : undefined)[0] ?? null);
+    } else if (plan.kind === "year") {
+      computed = computeYear(plan, parseFacts(reply, [plan.subject], "year")[0] ?? null);
+    } else if (plan.kind === "superlative") {
+      computed = computeSuperlativeFrom(plan, reply);
+    }
+  }
+  if (!computed) return null;
+  const note = plan.kind === "literal" ? null : plan.kind === "distance" ? "Straight-line distances computed from the cities' coordinates." : CAVEAT;
+  let text = `${computed.verdict}\n\n${factsBlock(computed.facts, note)}`;
+  if (!opts.noSentences && plan.kind !== "literal" && plan.kind !== "distance") {
+    try {
+      const reply = await generate(EXPLAIN_SYSTEM, `${computed.verdict}\n${computed.facts.join("\n")}`, 80);
+      const extra = constrainSentences(reply, `${computed.verdict} ${computed.facts.join(" ")}`);
+      if (extra) text = `${text}\n\n${extra}`;
+    } catch {
+      // the verdict and the facts stand without them
+    }
+  }
+  return { kind: computed.kind, text, verdict: computed.verdict, yes: computed.yes, winner: computed.winner };
+}
