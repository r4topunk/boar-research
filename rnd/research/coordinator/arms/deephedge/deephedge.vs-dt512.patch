diff --git a/src/routing/deepHedge.test.ts b/src/routing/deepHedge.test.ts
new file mode 100644
index 00000000..ce7a1481
--- /dev/null
+++ b/src/routing/deepHedge.test.ts
@@ -0,0 +1,88 @@
+import { describe, it, expect } from "vitest";
+import type { RetrievedChunk } from "../rag/retrieve.types";
+import { assemblePrompt, assembleChatMessages } from "../rag/pure";
+import { AnswerDeps, createAnswerer, InstalledLlm, DEEP_HEDGE_INSTRUCTION } from "./answer";
+import { DEEP_MAX_TOKENS } from "./depth";
+import type { GenerateOptions } from "../inference/LlamaEngine";
+
+const chunk = (chunkId: string, title: string, body: string): RetrievedChunk =>
+  ({ chunkId, docId: chunkId, title, body, score: 1, source: "wikipedia", matchType: "hybrid" }) as RetrievedChunk;
+const CANBERRA = chunk("c1", "Canberra",
+  "Canberra is the capital city of Australia. The site of Canberra was selected for the location of the nation's capital in 1908 " +
+  "as a compromise between Sydney and Melbourne. The city was designed after an international design contest.");
+const SNAKE = chunk("s1", "Snakebite",
+  "Snakebite first aid: keep the person still and calm, remove rings and tight items, keep the bitten limb at heart level, and get to a hospital quickly.");
+
+const GB = 1024 ** 3;
+const fast: InstalledLlm = { id: "fast4b", label: "Fast 4B", filename: "models/fast.gguf", sizeBytes: 2.5 * GB, roles: ["general", "fast"], isDefault: true };
+const deep: InstalledLlm = { id: "deep35", label: "Deep 35B", filename: "models/deep.gguf", sizeBytes: 12 * GB, roles: ["reasoning"] };
+const PERSONA = "You are Boar. Answer succinctly.";
+
+function makeDeps(settings: Record<string, unknown>) {
+  const gens: GenerateOptions[] = [];
+  let clock = 0;
+  let loaded: string | null = null;
+  const deps: AnswerDeps = {
+    now: () => (clock += 5),
+    engine: {
+      async load(filename) { loaded = filename; return { fit: null, warning: null }; },
+      async generate(o) { gens.push(o); o.onToken?.("Canberra was a compromise [1]."); return "Canberra was a compromise [1]."; },
+      async stop() {},
+      getModelInfo: () => (loaded ? { filename: loaded } : null),
+      hasEmbeddedChatTemplate: () => true,
+      async estimateFit() { return null; },
+    },
+    retrieve: async (q) => (/snake/i.test(q) ? [SNAKE] : [CANBERRA]),
+    getSettings: async () => ({ quickFirst: true, alwaysComplete: true, deepModelId: deep.id, ...settings }),
+    listInstalledLlms: async () => [fast, deep],
+    getActiveModelId: async () => fast.id,
+    runMultipass: async () => { throw new Error("no multipass"); },
+    assemblePrompt,
+    assembleChatMessages,
+  };
+  return { deps, gens };
+}
+
+async function run(settings: Record<string, unknown>, query: string) {
+  const t = makeDeps(settings);
+  const result = await createAnswerer(t.deps).answer({ query }, () => {}, { systemPrompt: PERSONA, maxTokens: 512 }).done;
+  const text = (g: GenerateOptions) => g.messages?.map((m) => m.content).join("\n") ?? g.prompt ?? "";
+  return { gens: t.gens, result, texts: t.gens.map(text) };
+}
+
+const Q = "Why was Canberra chosen as the capital of Australia?";
+const count = (s: string, sub: string) => s.split(sub).length - 1;
+
+describe("answer(): DEEPHEDGE (settings.deepHedge)", () => {
+  it("off (undefined or false): deep thinking generation = dt512 (no instruction, no code, cap unchanged)", async () => {
+    const a = await run({}, Q);
+    const b = await run({ deepHedge: false }, Q);
+    expect(a.result.tier).toBe("deep");
+    expect(JSON.stringify(a.gens)).toBe(JSON.stringify(b.gens));
+    expect(a.gens.at(-1)!.nPredict).toBe(DEEP_MAX_TOKENS);
+    expect(a.texts.join("\n")).not.toContain(DEEP_HEDGE_INSTRUCTION);
+    expect(a.result.receipt.reasonCodes).not.toContain("deephedge:on");
+    expect(a.gens.at(-1)!.messages![0].content.startsWith(PERSONA)).toBe(true);
+  });
+
+  it("on: instruction once in the system message after the persona, cap still DEEP_MAX_TOKENS, reason code", async () => {
+    const { gens, result, texts } = await run({ deepHedge: true }, Q);
+    const g = gens.at(-1)!;
+    expect(g.thinkingBudget).toBeGreaterThan(0);
+    expect(g.nPredict).toBe(DEEP_MAX_TOKENS);
+    expect(count(texts.at(-1)!, DEEP_HEDGE_INSTRUCTION)).toBe(1);
+    expect(g.messages![0].content.startsWith(`${PERSONA} ${DEEP_HEDGE_INSTRUCTION}`)).toBe(true);
+    expect(result.receipt.reasonCodes).toContain("deephedge:on");
+  });
+
+  it("on: absent on the fast tier and on the health path", async () => {
+    const f = await run({ deepHedge: true, alwaysComplete: false }, Q);
+    expect(f.result.tier).toBe("fast");
+    expect(f.texts.join("\n")).not.toContain(DEEP_HEDGE_INSTRUCTION);
+    expect(f.result.receipt.reasonCodes).not.toContain("deephedge:on");
+    const h = await run({ deepHedge: true }, "How do I treat a snake bite?");
+    expect(h.result.receipt.reasonCodes).toContain("grounding:health-extractive");
+    expect(h.texts.join("\n")).not.toContain(DEEP_HEDGE_INSTRUCTION);
+    expect(h.result.receipt.reasonCodes).not.toContain("deephedge:on");
+  });
+});
