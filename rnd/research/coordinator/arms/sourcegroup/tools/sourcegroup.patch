+import { describe, it, expect } from "vitest";
+import type { RetrievedChunk } from "../rag/retrieve.types";
+import { groupSources, pageKey } from "./sourceGroups";
+
+const src = (chunkId: string, title: string, url?: string, extra: Partial<RetrievedChunk & { relevance?: number }> = {}) => ({
+  chunkId,
+  docId: chunkId,
+  title,
+  body: `${title} passage ${chunkId}.`,
+  score: 1,
+  matchType: "hybrid" as const,
+  ...(url !== undefined ? { source: url ? `Wikivoyage — ${url}` : "Offline library" } : {}),
+  ...extra,
+});
+
+describe("groupSources (SOURCEGROUP)", () => {
+  it("merges passages of one URL into one group and keeps every passage with its place in the source list", () => {
+    const s = [
+      src("a1", "Wikivoyage: Rail travel in Japan", "https://en.wikivoyage.org/wiki/Rail_travel_in_Japan", { similarity: 0.6, relevance: 0.4 }),
+      src("b1", "Japan Rail Pass", "https://en.wikivoyage.org/wiki/Japan_Rail_Pass"),
+      src("a2", "Wikivoyage: Rail travel in Japan", "https://en.wikivoyage.org/wiki/Rail_travel_in_Japan", { similarity: 0.7, relevance: 0.2 }),
+    ];
+    const g = groupSources("A [1]. B [2]. C [3].", s);
+    expect(g.groups.map((x) => [x.n, x.title, x.passages.map((p) => [p.chunkId, p.sourceIndex])])).toEqual([
+      [1, "Wikivoyage: Rail travel in Japan", [["a1", 0], ["a2", 2]]],
+      [2, "Japan Rail Pass", [["b1", 1]]],
+    ]);
+    expect(g.groups[0].similarity).toBe(0.7);
+    expect(g.groups[0].relevance).toBe(0.4);
+    expect(g.text).toBe("A [1]. B [2]. C [1].");
+    expect(g.cited).toEqual([1, 2]);
+    expect([g.before, g.after]).toEqual([3, 2]);
+  });
+
+  it("same URL wins over different titles; different URLs with one title stay apart", () => {
+    const u = "https://travel.stackexchange.com/questions/66836";
+    expect(pageKey(src("x", "Q one", u))).toBe(pageKey(src("y", "Q one (answer 2)", u)));
+    expect(pageKey(src("x", "Paris", "https://en.wikipedia.org/wiki/Paris"))).not.toBe(pageKey(src("y", "Paris", "https://en.wikivoyage.org/wiki/Paris")));
+  });
+
+  it("falls back to the title (case and spaces ignored) when the source has no URL", () => {
+    const s = [src("c1", "Choking"), src("c2", "choking "), src("h1", "Heimlich manoeuvre", ""), src("c3", "Choking", "")];
+    const g = groupSources("Back blows [2]. Thrusts [3]. Call [4].", s);
+    expect(g.groups.map((x) => x.passages.length)).toEqual([3, 1]);
+    expect(g.groups[0].key).toBe("title:choking");
+    expect(g.text).toBe("Back blows [1]. Thrusts [2]. Call [1].");
+  });
+
+  it("renumbers markers to the groups: [1][3] -> [1][2], and [1][2] of one page -> [1]", () => {
+    const s = [src("a", "A", "https://x.org/A"), src("a2", "A", "https://x.org/A"), src("b", "B", "https://x.org/B")];
+    expect(groupSources("Both say so [1][3].", s).text).toBe("Both say so [1][2].");
+    expect(groupSources("One page [1][2].", s).text).toBe("One page [1].");
+    expect(groupSources("One page [1] [2]. Next [3].", s).text).toBe("One page [1]. Next [2].");
+    // Out-of-range markers are not the engine's to renumber.
+    expect(groupSources("Odd [7]. Fine [2].", s).text).toBe("Odd [7]. Fine [1].");
+  });
+
+  it("leaves an answer without citations untouched and keeps the text identical when no page repeats", () => {
+    const dup = [src("a", "A", "https://x.org/A"), src("a2", "A", "https://x.org/A")];
+    const none = groupSources("No marker here.", dup);
+    expect(none.text).toBe("No marker here.");
+    expect(none.cited).toEqual([]);
+    expect(none.groups).toHaveLength(1);
+    const distinct = [src("a", "A", "https://x.org/A"), src("b", "B", "https://x.org/B"), src("c", "C")];
+    const text = "C first [3]. A [1]. A again [1] [1].";
+    const same = groupSources(text, distinct);
+    expect(same.text).toBe(text);
+    expect(same.map).toEqual([0, 1, 2, 3]);
+    expect(same.groups.map((x) => x.passages.length)).toEqual([1, 1, 1]);
+    expect(groupSources("", [])).toMatchObject({ text: "", groups: [], cited: [], before: 0, after: 0 });
+  });
+
+  it("maps a citation that is not written in the text (the instant excerpt) to its group", () => {
+    const s = [src("a", "A", "https://x.org/A"), src("b", "B", "https://x.org/B"), src("a2", "A", "https://x.org/A")];
+    expect(groupSources("An excerpt.", s, [3]).cited).toEqual([1]);
+    expect(groupSources("An excerpt.", s, [2]).cited).toEqual([2]);
+  });
+});
