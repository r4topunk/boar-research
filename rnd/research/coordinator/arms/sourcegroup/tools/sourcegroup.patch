@@ -0,0 +1,110 @@
+/**
+ * SOURCEGROUP: one entry per page in the final answer's source list.
+ *
+ * Retrieval numbers sources per passage, so a page that gave two or three passages shows up two or
+ * three times ("Choking" ×3, PHONEFAIL failure 4: 8/27 desktop traces, 15/37 phone rows). After the
+ * answer is final, groupSources() merges the passages of one page into a group, numbers the groups by
+ * the page's first appearance in the source list (rank order kept), and rewrites every [n] in the text
+ * to its group's number ([1][3] with 2 a passage of page 1 -> [1][2]; [1][2] of one page -> [1]).
+ * Nothing else in the text changes. Pure: no I/O, no model.
+ */
+import type { RetrievedChunk } from "../rag/retrieve.types";
+import { dedupeCitations } from "./citations";
+
+/** A passage of a grouped page: the source as the sources event sent it, plus its place there. */
+export type GroupedPassage = RetrievedChunk & {
+  relevance?: number;
+  /** 0-based index into the sources event list ("[sourceIndex + 1]" before grouping). */
+  sourceIndex: number;
+};
+
+export interface SourceGroup {
+  /** The number "[n]" in the final text uses for this page (1-based, = index + 1 in sourceGroups). */
+  n: number;
+  /** "url:<url>" when the source label carries one, else "title:<lowercased title>". */
+  key: string;
+  title: string;
+  source?: string;
+  docId: string;
+  /** Best of the passages' values (absent when none has one). */
+  similarity?: number;
+  relevance?: number;
+  /** The page's passages in source-list order (length ≥ 1): for renderers that keep a chip per passage. */
+  passages: GroupedPassage[];
+}
+
+export interface GroupedSources {
+  groups: SourceGroup[];
+  /** The text with every [n] (1 ≤ n ≤ sources.length) rewritten to its group's number; others left as they are. */
+  text: string;
+  /** Group numbers the text cites, ascending. */
+  cited: number[];
+  /** Passage number (1-based) -> group number. */
+  map: number[];
+  before: number;
+  after: number;
+}
+
+const URL_RE = /https?:\/\/[^\s)\]]+/;
+
+/** The page a source belongs to: its URL when the label has one, else its title (case- and space-insensitive). */
+export function pageKey(c: { title: string; source?: string }): string {
+  const url = c.source?.match(URL_RE)?.[0];
+  if (url) return `url:${url.replace(/[.,;]+$/, "")}`;
+  return `title:${(c.title ?? "").trim().replace(/\s+/g, " ").toLowerCase()}`;
+}
+
+const best = (xs: (number | undefined)[]): number | undefined => {
+  const v = xs.filter((x): x is number => typeof x === "number");
+  return v.length ? Math.max(...v) : undefined;
+};
+
+/**
+ * Groups `sources` by page and renumbers the [n] in `text`. citedPassages (1-based passage numbers) is
+ * for an answer whose citation is not written in the text (the instant excerpt): mapped to groups.
+ * No two sources of one page -> groups mirror sources one to one and the text is returned unchanged.
+ */
+export function groupSources(
+  text: string,
+  sources: (RetrievedChunk & { relevance?: number })[],
+  citedPassages?: number[]
+): GroupedSources {
+  const byKey = new Map<string, SourceGroup>();
+  const groups: SourceGroup[] = [];
+  const map: number[] = [0];
+  sources.forEach((c, i) => {
+    const key = pageKey(c);
+    let g = byKey.get(key);
+    if (!g) {
+      g = { n: groups.length + 1, key, title: c.title, ...(c.source !== undefined ? { source: c.source } : {}), docId: c.docId, passages: [] };
+      byKey.set(key, g);
+      groups.push(g);
+    }
+    g.passages.push({ ...c, sourceIndex: i });
+    map.push(g.n);
+  });
+  for (const g of groups) {
+    const s = best(g.passages.map((p) => p.similarity));
+    const r = best(g.passages.map((p) => p.relevance));
+    if (s !== undefined) g.similarity = s;
+    if (r !== undefined) g.relevance = r;
+  }
+  const merged = groups.length < sources.length;
+  let out = text;
+  if (merged) {
+    out = text.replace(/\[(\d+)\]/g, (whole, num: string) => {
+      const k = Number(num);
+      return k >= 1 && k <= sources.length ? `[${map[k]}]` : whole;
+    });
+    // Two passages of one page cited side by side now read "[1][1]": keep one.
+    let prev: string;
+    do {
+      prev = out;
+      out = dedupeCitations(out).replace(/\[(\d+)\](?:[ \t]*\[\1\])+/g, "[$1]");
+    } while (out !== prev);
+  }
+  const fromText = [...out.matchAll(/\[(\d+)\]/g)].map((m) => Number(m[1])).filter((n) => n >= 1 && n <= groups.length);
+  const fromOverride = (citedPassages ?? []).filter((k) => k >= 1 && k <= sources.length).map((k) => map[k]);
+  const cited = [...new Set(citedPassages ? fromOverride : fromText)].sort((a, b) => a - b);
+  return { groups, text: out, cited, map, before: sources.length, after: groups.length };
+}
