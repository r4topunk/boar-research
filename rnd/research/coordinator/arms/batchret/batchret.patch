+/// <reference types="node" />
+import { describe, it, expect, beforeAll } from "vitest";
+import { execFileSync } from "node:child_process";
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { decompress } from "fzstd";
+import { nodeSqliteDatabase } from "./testing/nodeSqlite";
+import { WikiPack, titleCandidates, type PackSource, type PackSql } from "./wikiPack";
+
+// Batched lookups (BATCHRET): every batched path must return exactly what the one-row queries it replaces return.
+// The one-row queries below are the ones wikiPack.ts made before batching, kept here as the reference.
+
+type Db = ReturnType<typeof nodeSqliteDatabase>;
+
+/** A PackSql that counts its calls. */
+function counted(db: Db): PackSql & { calls: number } {
+  const c = {
+    calls: 0,
+    getAllAsync: (sql: string, p: any[]) => (c.calls++, db.getAllAsync<any>(sql, p)),
+    getFirstAsync: (sql: string, p: any[]) => (c.calls++, db.getFirstAsync<any>(sql, p)),
+    execAsync: (sql: string) => (c.calls++, db.execAsync(sql)),
+    runAsync: (sql: string, p: any[]) => (c.calls++, db.runAsync(sql, p)),
+  };
+  return c as any;
+}
+
+const STOP = new Set("the of a is what how do does and in to why was".split(" "));
+
+/** The pre-batching stems(): one tokenizer pass per text, one df (then fts_v) query per term. */
+async function refStems(db: Db, text: string, nIndexed: number, hasDf: boolean, stop: (w: string) => boolean) {
+  const words = (text.toLowerCase().match(/[\p{L}\p{N}]+/gu) ?? []).filter((w) => w.length > 1 && !stop(w));
+  if (!words.length) return [];
+  await db.execAsync("DELETE FROM temp.qtok");
+  await db.runAsync("INSERT INTO temp.qtok (x) VALUES (?)", [words.join(" ")]);
+  const terms = await db.getAllAsync<{ term: string }>("SELECT term FROM temp.qtok_v", []);
+  const out: Array<{ stem: string; idf: number }> = [];
+  for (const { term } of terms) {
+    const row =
+      (hasDf ? await db.getFirstAsync<{ doc: number }>("SELECT doc FROM df WHERE term = ?", [term]) : null) ??
+      (await db.getFirstAsync<{ doc: number }>("SELECT doc FROM temp.fts_v WHERE term = ?", [term]));
+    if (row && row.doc > 0) out.push({ stem: term, idf: Math.log(nIndexed / row.doc) });
+  }
+  return out;
+}
+
+/**
+ * A hand-built format-2 pack (blocks stored uncompressed: identity decompress) with the cases batching must not
+ * change: two articles with the same title (case aside) and the same views (a tie), redirects that tie, titles that
+ * differ only in case, a non-ASCII title (NOCASE folds ASCII only), url/license rows for some articles only, and a
+ * df table that holds only some terms. `redirectNocase` false builds the redirects table with a binary title.
+ */
+function synthPack(redirectNocase: boolean): Db {
+  const db = nodeSqliteDatabase(":memory:");
+  const raw = db.raw;
+  raw.exec(`
+    CREATE TABLE meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
+    CREATE TABLE blocks (id INTEGER PRIMARY KEY, zdata BLOB NOT NULL);
+    CREATE TABLE articles (id INTEGER PRIMARY KEY, source INTEGER NOT NULL, page_id INTEGER NOT NULL, title TEXT NOT NULL,
+                           views INTEGER NOT NULL, block_id INTEGER NOT NULL, off INTEGER NOT NULL, len INTEGER NOT NULL);
+    CREATE INDEX articles_title ON articles (title COLLATE NOCASE);
+    CREATE TABLE chunks (id INTEGER PRIMARY KEY, article_id INTEGER NOT NULL, start INTEGER NOT NULL, end INTEGER NOT NULL);
+    CREATE INDEX chunks_article ON chunks (article_id);
+    CREATE VIRTUAL TABLE fts USING fts5(title, section, body, content='', detail=full, tokenize='porter unicode61 remove_diacritics 2');
+    CREATE TABLE redirects (title TEXT NOT NULL ${redirectNocase ? "COLLATE NOCASE" : ""}, article_id INTEGER NOT NULL, PRIMARY KEY (title, article_id)) WITHOUT ROWID;
+    CREATE TABLE df (term TEXT PRIMARY KEY, doc INTEGER NOT NULL) WITHOUT ROWID;
+    CREATE TABLE article_meta (article_id INTEGER PRIMARY KEY, url TEXT, license TEXT);
+  `);
+  const arts: Array<[number, number, string, number]> = [
+    // id, source (0 enwiki, 1 enwikivoyage, 5 eips), title, views
+    [1, 0, "Georgia", 10],
+    [2, 0, "georgia", 10],
+    [3, 1, "Paris", 5],
+    [4, 1, "PARIS", 9],
+    [5, 0, "New York City", 7],
+    [6, 1, "New York City", 3],
+    [7, 0, "Éire", 4],
+    [8, 0, "éire", 2],
+    [9, 5, "ERC-20: Token Standard", 0],
+    [10, 0, "Georgia (disambiguation)", 1],
+  ];
+  const ins = raw.prepare("INSERT INTO articles VALUES (?, ?, ?, ?, ?, ?, ?, ?)");
+  const enc = new TextEncoder();
+  const blocks = new Map<number, string>();
+  for (const [id, source, title, views] of arts) {
+    const block = Math.ceil(id / 3);
+    const prev = blocks.get(block) ?? "";
+    const text = `# ${title}\n\n${title} is a test article number ${id} about places and tokens.`;
+    ins.run(id, source, 100 + id, title, views, block, enc.encode(prev).length, enc.encode(text).length);
+    blocks.set(block, prev + text);
+    raw.prepare("INSERT INTO chunks VALUES (?, ?, 0, ?)").run(id, id, text.length);
+    raw.prepare("INSERT INTO fts (rowid, title, section, body) VALUES (?, ?, '', ?)").run(id, title, text);
+  }
+  for (const [b, text] of blocks) raw.prepare("INSERT INTO blocks VALUES (?, ?)").run(b, enc.encode(text));
+  for (const [t, a] of [["Big Apple", 5], ["Big Apple", 6], ["Lutetia", 3], ["Lutetia", 4], ["Sakartvelo", 1], ["Sakartvelo", 2], ["ERC20", 9], ["sakartvelo2", 1]] as const)
+    raw.prepare("INSERT INTO redirects VALUES (?, ?)").run(t, a);
+  raw.prepare("INSERT INTO article_meta VALUES (9, 'https://eips.ethereum.org/EIPS/eip-20', 'CC0-1.0')").run();
+  raw.prepare("INSERT INTO article_meta VALUES (3, NULL, 'CC BY-SA 4.0')").run();
+  raw.prepare("INSERT INTO df VALUES ('test', 10), ('articl', 10), ('zero', 0)").run();
+  for (const [k, v] of [["format", "boar-knowledge-pack"], ["formatVersion", "2"], ["indexedChunks", "10"]])
+    raw.prepare("INSERT INTO meta VALUES (?, ?)").run(k, v);
+  return db;
+}
+
+const TITLES = [
+  "Georgia", "GEORGIA", "georgia", "Paris", "paris", "PARIS", "Big Apple", "BIG APPLE", "big apple", "Lutetia", "lutetia",
+  "Sakartvelo", "SAKARTVELO", "sakartvelo2", "Sakartvelo2", "New York City", "new york city", "Éire", "éire", "ÉIRE",
+  "ERC20", "erc20", "ERC-20: Token Standard", "Nowhere", "",
+];
+const SOURCES: PackSource[] = ["enwiki", "enwikivoyage", "eips", "bips"];
+
+describe.each([true, false])("batched title, article and stem lookups (redirects NOCASE: %s)", (nocase) => {
+  it("prefetchTitles + resolveTitle returns what resolveTitle's own queries return, ties and case included", async () => {
+    const ref = await WikiPack.open(synthPack(nocase), (d) => d);
+    const db = counted(synthPack(nocase));
+    const pack = await WikiPack.open(db, (d) => d);
+    await pack.prefetchTitles(TITLES, SOURCES);
+    const before = db.calls;
+    let fallbacks = 0;
+    for (const t of TITLES)
+      for (const source of SOURCES) {
+        const n = db.calls;
+        expect(await pack.resolveTitle(t, { fuzzy: false, source }), `${t} @ ${source}`).toBe(await ref.resolveTitle(t, { fuzzy: false, source }));
+        if (db.calls > n) fallbacks++;
+      }
+    // Only the ties go back to the one-row query: Georgia/georgia (3 spellings), Sakartvelo (2 spellings, nocase only).
+    expect(fallbacks).toBe(nocase ? 5 : 4);
+    expect(db.calls - before).toBeGreaterThan(0);
+  });
+
+  it("prefetchArticles + article returns the same article (text, url, license) and still fails on a missing id", async () => {
+    const ref = await WikiPack.open(synthPack(nocase), (d) => d);
+    const db = counted(synthPack(nocase));
+    const pack = await WikiPack.open(db, (d) => d);
+    const ids = [9, 3, 1, 2, 4, 5, 6, 7, 8, 10];
+    const n0 = db.calls;
+    await pack.prefetchArticles([...ids, 404]);
+    for (const id of ids) expect(await pack.article(id)).toEqual(await ref.article(id));
+    // One query for the rows, one for url/license, then blocks in windows (4 blocks here: one query).
+    expect(db.calls - n0).toBe(3);
+    await expect(pack.article(404)).rejects.toThrow("pack article 404 missing");
+    await expect(ref.article(404)).rejects.toThrow("pack article 404 missing");
+  });
+
+  it("stemsMany returns, per text, what one stems() pass per text returned (df first, then the index's count)", async () => {
+    const rdb = synthPack(nocase);
+    const ref = await WikiPack.open(rdb, (d) => d);
+    const db = counted(synthPack(nocase));
+    const pack = await WikiPack.open(db, (d) => d);
+    const texts = ["Test articles about places", "the of and", "", "Éire tokens tokens zero", "PLACES", "test", "articles about places test"];
+    const stop = (w: string) => ["the", "of", "and", "about"].includes(w);
+    const n0 = db.calls;
+    const got = await pack.stemsMany(texts);
+    // DELETE + INSERT + one vocabulary read + df + fts_v for the terms df doesn't hold.
+    expect(db.calls - n0).toBe(5);
+    for (let i = 0; i < texts.length; i++) expect(got[i], texts[i]).toEqual(await refStems(rdb, texts[i], 10, true, stop));
+    // Second time: no SQL at all.
+    const n1 = db.calls;
+    expect(await pack.stemsMany(texts)).toEqual(got);
+    expect(await pack.stems(texts[0])).toEqual(got[0]);
+    expect(db.calls).toBe(n1);
+    void ref;
+  });
+});
+
+describe("batched search on a real built pack", () => {
+  let path: string;
+  beforeAll(() => {
+    path = join(mkdtempSync(join(tmpdir(), "boar-pack-batch-")), "mini.sqlite");
+    execFileSync(process.execPath, [
+      "scripts/build-wiki-pack.mjs", "--out", path, "--shards", "src/rag/testing/fixtures/mini-wiki.jsonl", "--no-embed", "--chunk-chars", "300",
+    ], { stdio: "pipe" });
+  }, 60000);
+
+  const QUESTIONS = [
+    "What is a black hole?",
+    "What is a black hole and how does one form?",
+    "Compare the French Revolution and the Industrial Revolution.",
+    "How do vaccines train the immune system?",
+    "Why was Kuala Kubu Bharu rebuilt?",
+    "Which financial crisis and debt problems led to the revolution, not the Black Sea trade?",
+    "How do I treat a burn?",
+  ];
+
+  it("stems of the question and of every title n-gram match the one-pass-per-text stems", async () => {
+    const rdb = nodeSqliteDatabase(path);
+    const ref = await WikiPack.open(rdb, decompress);
+    const pack = await WikiPack.open(nodeSqliteDatabase(path), decompress);
+    const n = Number(ref.meta.indexedChunks) || 1;
+    const hasDf = !!(await rdb.getFirstAsync("SELECT name FROM sqlite_master WHERE name = 'df'", []));
+    // The engine's STOPWORDS decide which words are stemmed: compare through stems() on a fresh instance per text.
+    for (const q of QUESTIONS) {
+      const texts = [q, ...titleCandidates(q)];
+      const got = await pack.stemsMany(texts);
+      for (let i = 0; i < texts.length; i++) {
+        const fresh = await WikiPack.open(nodeSqliteDatabase(path), decompress);
+        expect(got[i], texts[i]).toEqual(await fresh.stems(texts[i]));
+      }
+    }
+    // And the single-text path equals the pre-batching algorithm on a text without engine stopwords.
+    expect(await pack.stems("photons spacetime gravity")).toEqual(await refStems(rdb, "photons spacetime gravity", n, hasDf, (w) => STOP.has(w)));
+  });
+
+  it("gives the same hits cold and warm, in far fewer SQL calls than one per term, title and article", async () => {
+    for (const q of QUESTIONS) {
+      const db = counted(nodeSqliteDatabase(path));
+      const cold = await WikiPack.open(db, decompress);
+      const n0 = db.calls;
+      const first = await cold.searchDetailed(q);
+      const calls = db.calls - n0;
+      expect(calls, q).toBeLessThanOrEqual(20);
+      // Warm caches (same instance, after other questions) change nothing.
+      for (const other of QUESTIONS) await cold.search(other);
+      expect(await cold.searchDetailed(q)).toEqual(first);
+    }
+  });
+});
