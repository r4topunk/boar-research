+/** ORACLE-ST (eval only): a pack article's chunk by index (ordered by start), or its lead, in the shape of a retrieved pack passage. */
+export async function packOracleChunk(packId: string, articleId: number, index: number | "lead"): Promise<RetrievedChunk | null> {
+  // A pack file copied into corpus/ outside the catalog is listed as "local-<file name>" (knowledgePacks).
+  const pack = (await knowledgePacks()).find((p) => p.id === packId || p.id === `local-${packId}`);
+  if (!pack || !(await openPack(pack))) return null;
+  const wp = wikiPacks.get(pack.id);
+  if (!wp) return null;
+  const h = index === "lead" ? await wp.oracleLead(articleId) : await wp.oracleChunk(articleId, index);
+  return h ? packHitToChunk(pack.id, h) : null;
+}
