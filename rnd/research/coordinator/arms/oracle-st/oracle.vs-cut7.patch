+/** ORACLE-ST (eval only, default off): BOAR_ORACLE_FILE = JSON {queryId: {pack, article_id, chunk_index, mode: "add" | "only", question}};
+ *  BOAR_PROMPT_DUMP = JSONL file that receives each generation's prompt/messages. Both absent = the shipped code path. */
+const ORACLE_FILE: string | undefined = typeof process !== "undefined" ? process.env?.BOAR_ORACLE_FILE || undefined : undefined;
+const PROMPT_DUMP: string | undefined = typeof process !== "undefined" ? process.env?.BOAR_PROMPT_DUMP || undefined : undefined;
+type OracleEntry = { pack: string; article_id: number; chunk_index: number; mode: "add" | "only"; question: string };
+let oracleByQuestion: Map<string, OracleEntry> | undefined;
+async function oracleFor(query: string): Promise<OracleEntry | undefined> {
+  if (!oracleByQuestion) {
+    const fs = await import("node:fs");
+    const m = JSON.parse(fs.readFileSync(ORACLE_FILE!, "utf8")) as Record<string, OracleEntry>;
+    oracleByQuestion = new Map(Object.values(m).map((e) => [e.question, e]));
+  }
+  return oracleByQuestion.get(query);
+}
+async function dumpPrompt(query: string, prompt: unknown): Promise<void> {
+  const fs = await import("node:fs");
+  fs.appendFileSync(PROMPT_DUMP!, JSON.stringify({ query, prompt }) + "\n");
+}
 
