+  };
+});
+
+import { voteRoute, capPerPack, chunkPackId, isKitPack, basePackId, llmRouteFilter, quotaOn } from "./packRoute";
+import { retrieve } from "./retrieve";
+
+const ids = (cs: { chunkId: string }[]) => cs.map((c) => c.chunkId);
+const packsOf = (cs: { chunkId: string }[]) => cs.map((c) => chunkPackId(c.chunkId));
+
+describe("voteRoute", () => {
+  it("lead, keyword share and title votes; the pack with >= 2 votes wins", () => {
+    const r = voteRoute([
+      { packId: "local-a", lead: 0.8, fts: [10, 9, 8], title: false },
+      { packId: "local-b", lead: 0.7, fts: [5], title: true },
