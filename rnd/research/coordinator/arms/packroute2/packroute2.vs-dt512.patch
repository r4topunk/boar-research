+    // a: lead + title = 2, b: fts + title = 2 -> tie -> none
+    const t = voteRoute([
+      { packId: "a", lead: 0.8, fts: [1], title: true },
+      { packId: "b", lead: 0.7, fts: [5, 4], title: true },
