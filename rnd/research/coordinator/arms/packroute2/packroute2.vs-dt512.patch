+    expect(basePackId("local-qa-health-se")).toBe("qa-health-se");
+  });
+});
+
+describe("retrieve with packRoute", () => {
+  it("off: every pack searched, the strong pack takes the slots", async () => {
+    calls.searched.length = 0;
+    const off = await retrieve("question", 6);
+    expect(calls.searched.at(-1)).toEqual(["local-boar-wikivoyage-en", "local-a", "local-b"]);
+    expect(packsOf(off).filter((p) => p === "local-a").length).toBeGreaterThan(2);
