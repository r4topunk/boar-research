+    expect(r.codes).toEqual(["packroute:a", "packroute-votes:a-2", "packroute-votes:b-1"]);
+    expect(r.scores[0]).toEqual({ packId: "local-a", lead: 0.8, fts: 3, title: false });
+  });
+  it("split votes or a tie route to none", () => {
