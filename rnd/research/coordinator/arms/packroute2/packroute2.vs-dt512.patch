+ * - "router": before the pack search, every installed non-kit pack is scored for the question and gets up to three
+ *   votes: (i) the highest lead cosine of its best candidate article, (ii) the largest share of the pooled top
+ *   ROUTE_FTS_POOL keyword candidates over all non-kit packs, (iii) an article the question names (titlesInQuestion,
+ *   share >= the pack's namedMinShare). The pack with the most votes is searched when it has at least
+ *   ROUTE_MIN_VOTES and no other pack has as many; otherwise none is. The kit packs are always searched.
+ * - "quota": every pack is searched as without the setting, but each non-kit pack holds at most PACK_QUOTA of the
+ *   retrieved slots; the slots it would have taken go to the next candidates.
+ *
+ * - "llm" (PACKROUTE-2): the route is decided outside retrieval (a 4B classifier call over the installed packs'
+ *   descriptions; step 0: a routes file) and passed as `packRouteChoice` (a pack id or "none"): the kit packs + the chosen
+ *   pack are searched; "none" = the kit packs only. No choice (the call failed) = every pack, as without the setting.
+ * - "llmq" (PACKROUTE-2): as "llm", but "none" = every pack with the "quota" cap.
+ *
+ * Pure: no database or native imports (tests and src/rag/packs.ts use it).
+ */
+export type PackRouteMode = "off" | "router" | "quota" | "llm" | "llmq";
+
+/** PACKROUTE-2: the packs to search for an externally decided route ("llm"/"llmq"); undefined = every pack. */
+export function llmRouteFilter(mode: PackRouteMode | undefined, choice: string | null | undefined): ((packId: string) => boolean) | undefined {
+  if ((mode !== "llm" && mode !== "llmq") || !choice) return undefined;
+  if (choice === "none") return mode === "llm" ? (id) => isKitPack(id) : undefined;
+  return (id) => isKitPack(id) || basePackId(id) === basePackId(choice);
+}
+
+/** The "quota" cap applies: mode "quota", or "llmq" routed to none. */
+export const quotaOn = (mode: PackRouteMode | undefined, choice: string | null | undefined) =>
+  mode === "quota" || (mode === "llmq" && choice === "none");
+
+/** Packs shipped with the claim build: always searched, never routed or capped. */
+export const KIT_PACK_IDS = new Set(["boar-crypto", "boar-wikivoyage-en"]);
+export const ROUTE_FTS_POOL = 20;
+export const ROUTE_MIN_VOTES = 2;
+export const PACK_QUOTA = 2;
+
+/** A pack id without the "local-" prefix of a pack file found in corpus/ outside the catalog. */
+export const basePackId = (id: string) => id.replace(/^local-/, "");
+export const isKitPack = (id: string) => KIT_PACK_IDS.has(basePackId(id));
+
+/** The pack id of a retrieved chunk ("pack:<id>:<chunk>"), or null for the bundled corpus. */
+export function chunkPackId(chunkId: string): string | null {
+  const m = /^pack:([^:]+):/.exec(chunkId);
+  return m ? m[1] : null;
+}
+
+export interface PackRouteInput {
+  packId: string;
+  /** Best lead cosine over the pack's candidate articles (null: no candidate with a lead vector). */
+  lead: number | null;
+  /** The pack's keyword candidates' scores (bm25Candidates order). */
+  fts: number[];
+  /** The question names one of the pack's articles. */
+  title: boolean;
+}
+
+export interface PackRoute {
+  selected: string | null;
+  votes: Record<string, number>;
+  /** Per pack: lead cosine, candidates in the pooled top ROUTE_FTS_POOL, title match. */
+  scores: Array<{ packId: string; lead: number | null; fts: number; title: boolean }>;
+  codes: string[];
+}
+
+/** The single argmax of `value` over `xs`, or null when there is none or it is tied. */
+function uniqueMax<T>(xs: T[], value: (x: T) => number | null): T | null {
+  let best: T | null = null, bestV = -Infinity, tied = false;
+  for (const x of xs) {
+    const v = value(x);
+    if (v === null || !Number.isFinite(v)) continue;
+    if (v > bestV) (best = x), (bestV = v), (tied = false);
+    else if (v === bestV) tied = true;
+  }
+  return tied ? null : best;
+}
+
+/** The router's vote (deterministic; ties never win a vote or the route). */
+export function voteRoute(inputs: PackRouteInput[], pool = ROUTE_FTS_POOL, minVotes = ROUTE_MIN_VOTES): PackRoute {
+  const votes: Record<string, number> = Object.fromEntries(inputs.map((p) => [p.packId, 0]));
+  const lead = uniqueMax(inputs, (p) => p.lead);
+  if (lead) votes[lead.packId]++;
+  // Pooled keyword candidates: score order, ties by pack order then rank.
+  const pooled = inputs
+    .flatMap((p, pi) => p.fts.map((s, r) => ({ packId: p.packId, s, pi, r })))
+    .sort((a, b) => b.s - a.s || a.pi - b.pi || a.r - b.r)
+    .slice(0, pool);
+  const share = new Map<string, number>();
+  for (const c of pooled) share.set(c.packId, (share.get(c.packId) ?? 0) + 1);
+  const fts = uniqueMax(inputs, (p) => share.get(p.packId) ?? null);
+  if (fts) votes[fts.packId]++;
+  for (const p of inputs) if (p.title) votes[p.packId]++;
+  const top = uniqueMax(inputs, (p) => votes[p.packId]);
+  const selected = top && votes[top.packId] >= minVotes ? top.packId : null;
+  const scores = inputs.map((p) => ({ packId: p.packId, lead: p.lead === null ? null : +p.lead.toFixed(4), fts: share.get(p.packId) ?? 0, title: p.title }));
+  const codes = [
+    `packroute:${selected ? basePackId(selected) : "none"}`,
+    ...inputs.filter((p) => votes[p.packId] > 0).map((p) => `packroute-votes:${basePackId(p.packId)}-${votes[p.packId]}`),
+  ];
+  return { selected, votes, scores, codes };
+}
+
+/**
+ * Quota: keeps `list`'s order, dropping a non-kit pack's chunk once that pack already holds `cap` of the kept ones.
+ * The bundled corpus and the kit packs are never capped.
+ */
+export function capPerPack<T extends { chunkId: string }>(list: T[], cap = PACK_QUOTA, held: Map<string, number> = new Map()): T[] {
+  return list.filter((c) => {
+    const p = chunkPackId(c.chunkId);
+    if (!p || isKitPack(p)) return true;
+    const n = held.get(p) ?? 0;
+    if (n >= cap) return false;
+    held.set(p, n + 1);
+    return true;
+  });
+}
