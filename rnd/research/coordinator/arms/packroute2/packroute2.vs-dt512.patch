+    expect(n("local-a")).toBe(2);
+    expect(n("local-b")).toBe(2);
+    expect(n("local-boar-wikivoyage-en")).toBe(2);
+    expect(q).toHaveLength(6);
+  });
+  it("router: the kit plus the routed pack only, with its reason codes", async () => {
+    calls.searched.length = 0;
+    const r = await retrieve("question", 6, { packRoute: "router" });
+    expect(calls.searched.at(-1)).toEqual(["local-boar-wikivoyage-en", "local-b"]);
