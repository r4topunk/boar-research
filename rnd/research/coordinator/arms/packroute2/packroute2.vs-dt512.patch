+vi.mock("./packs", async (importOriginal) => {
+  const actual: any = await importOriginal();
+  const all = [
+    { packId: "local-boar-wikivoyage-en", hits: [hit(1, "Kit 1", 3), hit(2, "Kit 2", 2)] },
+    { packId: "local-a", hits: [1, 2, 3, 4, 5, 6].map((i) => hit(10 + i, `A ${i}`, 20 - i)) },
+    { packId: "local-b", hits: [1, 2, 3].map((i) => hit(20 + i, `B ${i}`, 9 - i)) },
+  ];
+  return {
+    packHitToChunk: actual.packHitToChunk,
+    searchPacks: async () => ({ lexical: [], semantic: [] }),
+    searchWikiPacks: async (_q: string, _o: any, only?: (id: string) => boolean) => {
+      const r = all.filter((p) => !only || only(p.packId));
+      calls.searched.push(r.map((p) => p.packId));
+      return r;
+    },
+    // b: lead + title (2 votes), a: keyword share (1 vote) -> b
+    routeWikiPacks: async () => (await import("./packRoute")).voteRoute([
+      { packId: "local-a", lead: 0.6, fts: [20, 19, 18], title: false },
+      { packId: "local-b", lead: 0.7, fts: [9], title: true },
