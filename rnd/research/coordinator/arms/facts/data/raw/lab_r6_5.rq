  OPTIONAL { ?item rdfs:label ?label FILTER(LANG(?label)="en") } OPTIONAL { ?item schema:description ?desc FILTER(LANG(?desc)="en") }
  OPTIONAL { ?item skos:altLabel ?alias FILTER(LANG(?alias)="en") } } GROUP BY ?item ?label ?desc