diff -ruN wt/pr1/src/routing/followup.test.ts kiln-local/be-cut7-followup/src/routing/followup.test.ts
--- wt/pr1/src/routing/followup.test.ts	1969-12-31 21:00:00
+++ kiln-local/be-cut7-followup/src/routing/followup.test.ts	2026-10-16 10:15:47
@@ -0,0 +1,22 @@
+import { describe, expect, it } from "vitest";
+import { followupExpansion } from "./followup";
+
+const h = (u: string, a = "An answer.", sources?: string[]) => ({ turns: [{ role: "user" as const, text: u }, { role: "assistant" as const, text: a, ...(sources ? { sources } : {}) }] });
+
+describe("followupExpansion", () => {
+  it("expands a short follow-up with the previous user turn's content words", () => {
+    expect(followupExpansion("How much does it cost?", h("How does the Japan Rail Pass work?"))).toEqual({ terms: ["Japan", "Rail", "Pass"], titles: [] });
+  });
+  it("keeps the previous answer's source titles", () => {
+    expect(followupExpansion("And in winter?", h("What is the weather like in Iceland in summer?", "Mild.", ["Iceland", "Iceland"]))?.titles).toEqual(["Iceland"]);
+  });
+  it("is null without history, for a long self-contained turn, or with nothing new to add", () => {
+    expect(followupExpansion("How much does it cost?", undefined)).toBeNull();
+    expect(followupExpansion("Which countries in South America have the largest coffee production by volume today?", h("Tell me about coffee."))).toBeNull();
+    expect(followupExpansion("Japan rail pass price?", h("Japan Rail Pass?"))).toBeNull();
+  });
+  it("fires on a long turn that refers back and caps the terms at 12", () => {
+    const prev = "alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima mike november";
+    expect(followupExpansion("Could you tell me in more detail how long that usually takes for most people?", h(prev))?.terms).toHaveLength(12);
+  });
+});
diff -ruN wt/pr1/src/routing/followup.ts kiln-local/be-cut7-followup/src/routing/followup.ts
--- wt/pr1/src/routing/followup.ts	1969-12-31 21:00:00
+++ kiln-local/be-cut7-followup/src/routing/followup.ts	2026-10-16 10:14:54
@@ -0,0 +1,64 @@
+/**
+ * FOLLOWUP (deps.followupContext): a follow-up turn ("How much does it cost?", "What about Lisbon?") is searched with
+ * the previous user turn's content words appended, so retrieval sees the subject the history carries. PHONEFAIL
+ * (2026-10-16): with history the answer stayed on topic but the turn-2 sources equalled the no-history run on 4/4
+ * pairs, because retrieval read only the bare follow-up.
+ *
+ * Fires only when the conversation has an earlier user turn and the current turn is short (<= 8 words) or refers back
+ * (a pronoun or an ellipsis opener). Terms = the previous user turn's words, minus stopwords and minus words the
+ * current turn already has, at most 12, in order. Titles = the sources the previous answer showed, when the history
+ * turn carries them (ConversationTurn.sources), used to rank those pages first among the retrieved chunks.
+ */
+import type { ConversationHistory } from "../rag/pure";
+
+export const FOLLOWUP_MAX_WORDS = 8;
+export const FOLLOWUP_MAX_TERMS = 12;
+export const FOLLOWUP_MAX_TITLES = 6;
+
+const REFERS = /\b(it|its|it's|itself|that|this|these|those|they|them|their|theirs|there|he|she|him|her|his|hers|one|ones|same|other)\b/i;
+const OPENER = /^\s*(and|but|so|also|then|what about|how about|and what about|what if)\b/i;
+const STOP = new Set(
+  ("a about above after again against all also am an and any are aren't as at be because been before being below best better between both but by " +
+    "can can't cannot could couldn't compare comparison describe detail details did didn't difference differences do does doesn't doing don't down during " +
+    "each explain few for from further get gets getting give go going got had hadn't has hasn't have haven't having he he's her here here's hers herself " +
+    "him himself his how how's i i'd i'll i'm i've if in into is isn't it it's its itself just know let let's like make me mean means more most much " +
+    "must my myself need no nor not now of off on once only or other ought our ours ourselves out over own please quick quickly really right same " +
+    "say says see she should shouldn't show so some something such summarize summary sure tell than that that's the their theirs them themselves then " +
+    "there there's these they they'd they'll they're they've thing things think this those through to too under until up us use used using very " +
+    "versus vs want wanted was wasn't way we we'd we'll we're we've were weren't what what's when when's where where's which while who who's whom whose " +
+    "why why's will with won't work works would wouldn't yes yet you you'd you'll you're you've your yours yourself yourselves happen happened happens " +
+    "cause caused causes actually anything everything still one ones lot lots many maybe okay ok thanks thank hi hello hey").split(" ")
+);
+const WORD = /[\p{L}\p{N}][\p{L}\p{N}'’-]*/gu;
+const words = (s: string) => (s.match(WORD) ?? []).map((w) => w.replace(/’/g, "'").replace(/['-]+$/, ""));
+
+export interface FollowupExpansion {
+  terms: string[];
+  titles: string[];
+}
+
+/** Null when the turn is not a follow-up, has no earlier user turn, or the earlier turn adds no new content word. */
+export function followupExpansion(query: string, history: ConversationHistory | undefined): FollowupExpansion | null {
+  const turns = history?.turns ?? [];
+  let u = -1;
+  for (let i = turns.length - 1; i >= 0; i--) if (turns[i].role === "user" && turns[i].text.trim()) { u = i; break; }
+  if (u < 0) return null;
+  const cur = words(query);
+  if (!(cur.length <= FOLLOWUP_MAX_WORDS || REFERS.test(query) || OPENER.test(query))) return null;
+  const have = new Set(cur.map((w) => w.toLowerCase()));
+  const terms: string[] = [];
+  for (const w of words(turns[u].text)) {
+    const l = w.toLowerCase();
+    if (have.has(l) || STOP.has(l) || (l.length < 3 && !/\d/.test(l))) continue;
+    have.add(l);
+    terms.push(w);
+    if (terms.length >= FOLLOWUP_MAX_TERMS) break;
+  }
+  if (!terms.length) return null;
+  let titles: string[] = [];
+  for (let i = turns.length - 1; i > u; i--) {
+    const t = turns[i];
+    if (t.role === "assistant" && t.sources?.length) { titles = [...new Set(t.sources.filter(Boolean))].slice(0, FOLLOWUP_MAX_TITLES); break; }
+  }
+  return { terms, titles };
+}
