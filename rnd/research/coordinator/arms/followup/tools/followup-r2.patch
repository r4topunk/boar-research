+/** FOLLOWUP r2 (deps.followupAnchor): anchored articles per follow-up and chunks appended. */
+export const ANCHOR_MAX_ARTICLES = 2;
+export const ANCHOR_N = 2;
+const LABEL_SOURCE = new Map<string, PackHit["source"]>(
+  (Object.entries(SOURCE_LABEL) as Array<[PackHit["source"], string]>).filter(([s]) => s !== "enwiki").map(([s, l]) => [l, s])
+);
+/** A source title as packHitToChunk renders it -> the article title and source it names ("Wikivoyage: Austria" -> enwikivoyage). */
+export function shownTitleKey(shown: string): { title: string; source: PackHit["source"] } {
+  const m = /^([^:]{2,40}):\s+(.+)$/.exec(shown);
+  const src = m ? LABEL_SOURCE.get(m[1]) : undefined;
+  return src ? { title: m![2], source: src } : { title: shown, source: "enwiki" };
+}
+
+/**
+ * FOLLOWUP r2 (deps.followupAnchor, default off): the previous answer's top source articles (the first ANCHOR_MAX_ARTICLES
+ * distinct shown titles, resolved strictly by title and rendered source in every installed format-2 pack), all their chunks
+ * scored against the bare follow-up `query` with the pack's passage score; returns how many chunks were fetched and the
+ * best `n` with a score above 0 whose chunkId is not in `exclude`, as retrieved pack passages.
+ */
+export async function packAnchorChunks(
+  query: string,
+  titles: string[],
+  exclude: Set<string>,
+  n = ANCHOR_N
+): Promise<{ fetched: number; chunks: RetrievedChunk[] }> {
+  const keys = [...new Set(titles.filter(Boolean))].slice(0, ANCHOR_MAX_ARTICLES).map(shownTitleKey);
+  const cands: Array<{ c: RetrievedChunk; s: number; t: number; o: number }> = [];
+  let fetched = 0;
+  if (!keys.length) return { fetched, chunks: [] };
+  for (const pack of await knowledgePacks()) {
+    try {
+      if (!(await openPack(pack))) continue;
+      const wp = wikiPacks.get(pack.id);
+      if (!wp) continue;
+      let stems: Stem[] | null = null;
+      for (const [t, k] of keys.entries()) {
+        const ids = await wp.articlesTitled(k.title, k.source);
+        if (!ids.length) continue;
+        stems ??= await wp.stems(query);
+        const scored = await wp.scoredChunks(ids[0], stems);
+        fetched += scored.length;
+        scored.forEach((x, o) => {
+          const c = packHitToChunk(pack.id, x.hit);
+          if (x.score > 0 && !exclude.has(c.chunkId)) cands.push({ c, s: x.score, t, o });
+        });
+      }
+    } catch (e: any) {
+      console.warn(`[packs] anchor failed in ${pack.id}:`, e?.message ?? e);
+    }
+  }
+  cands.sort((a, b) => b.s - a.s || a.t - b.t || a.o - b.o);
+  return { fetched, chunks: cands.slice(0, n).map((x) => x.c) };
 }
 
