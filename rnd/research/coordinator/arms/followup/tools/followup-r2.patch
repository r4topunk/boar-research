+/** FOLLOWUP r2 (deps.followupAnchor): titles of the previous answer's top sources to anchor on. */
+export const ANCHOR_MAX_TITLES = 2;
+
+/**
+ * FOLLOWUP r2: when the current turn is a follow-up (an earlier user turn, and <= FOLLOWUP_MAX_WORDS words, a referring
+ * pronoun or an ellipsis opener: the same test as followupExpansion) and the assistant turn after that user turn carries
+ * `sources`, the first ANCHOR_MAX_TITLES distinct titles in their shown order; null otherwise.
+ */
+export function followupAnchorTitles(query: string, history: ConversationHistory | undefined): string[] | null {
+  const turns = history?.turns ?? [];
+  let u = -1;
+  for (let i = turns.length - 1; i >= 0; i--) if (turns[i].role === "user" && turns[i].text.trim()) { u = i; break; }
+  if (u < 0) return null;
+  if (!(words(query).length <= FOLLOWUP_MAX_WORDS || REFERS.test(query) || OPENER.test(query))) return null;
+  for (let i = turns.length - 1; i > u; i--) {
+    const t = turns[i];
+    if (t.role === "assistant" && t.sources?.length) {
+      const titles = [...new Set(t.sources.filter(Boolean))].slice(0, ANCHOR_MAX_TITLES);
+      return titles.length ? titles : null;
+    }
+  }
+  return null;
+}
