+describe("device eval questions with a per-question gate (gate-interleave.patch)", () => {
+  it("accepts gate on/off and rejects anything else", () => {
+    const q = (g: unknown) => JSON.stringify({ requestId: "r", pipeline: "answer", questions: [{ id: "cs-001-on", query: "boa noite", gate: g }] });
+    expect(parseEvalRequest(q("on")).questions![0].gate).toBe("on");
+    expect(parseEvalRequest(q("off")).questions![0].gate).toBe("off");
+    expect(parseEvalRequest(q(undefined)).questions![0].gate).toBeUndefined();
+    expect(() => parseEvalRequest(q("maybe"))).toThrow(/questions/);
