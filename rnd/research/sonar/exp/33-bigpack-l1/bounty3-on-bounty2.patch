+describe("title-tier shard without the body full-text index", () => {
+  it("still answers named articles (rare names included) and never keyword hits", async () => {
+    const { DatabaseSync } = await import("node:sqlite");
+    const { copyFileSync } = await import("node:fs");
+    const dir = mkdtempSync(join(tmpdir(), "boar-slim-"));
+    const src = join(dir, "full.sqlite"), out = join(dir, "slim.sqlite");
+    execFileSync(process.execPath, ["scripts/build-wiki-pack.mjs", "--out", src, "--shards", "src/rag/testing/fixtures/mini-wiki.jsonl", "--no-embed", "--chunk-chars", "300"], { stdio: "pipe" });
+    copyFileSync(src, out);
+    const db = new DatabaseSync(out);
+    db.exec("DROP TABLE IF EXISTS fts"); db.exec("VACUUM"); db.close();
+    const slim = await WikiPack.open(nodeSqliteDatabase(out), decompress);
+    slim.tuning = { ...slim.tuning, namedOnly: true, namedMinShare: 0.25 };
+    const bh = await slim.search("Tell me about black holes and how they form", { k: 4 });
+    expect(new Set(bh.map((h) => h.title))).toEqual(new Set(["Black hole"]));
+    const kkb = await slim.search("What is Kuala Kubu Bharu known for?", { k: 4 });
+    expect(new Set(kkb.map((h) => h.title))).toEqual(new Set(["Kuala Kubu Bharu"]));
+    expect(await slim.search("what happens when a massive star collapses under gravity", { k: 4 })).toEqual([]);
+  }, 60000);
+});
