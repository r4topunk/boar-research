+
+describe("title-lookup tier (namedOnly)", () => {
+  it("answers only with articles the question names, never keyword neighbours", async () => {
+    const saved = pack.tuning;
+    pack.tuning = { ...saved, namedOnly: true, namedMinShare: 0.25 };
+    try {
+      const named = await pack.search("Tell me about black holes and how they form", { k: 4 });
+      expect(named.length).toBeGreaterThan(0);
+      expect(new Set(named.map((h) => h.title))).toEqual(new Set(["Black hole"]));
+      expect(named.every((h) => h.via === "title")).toBe(true);
+      // No article named: nothing (a full pack would return keyword hits on "collapses", "star", "gravity").
+      expect(await pack.search("what happens when a massive star collapses under gravity", { k: 4 })).toEqual([]);
+    } finally {
+      pack.tuning = saved;
+    }
+  });
+});
