--- be-0cfd4a77-bounty1/src/rag/clean.ts	1969-12-31 21:00:00
+++ be-0cfd4a77-rv2/src/rag/clean.ts	2026-10-03 18:09:34
@@ -0,0 +1,26 @@
+// rv2 ("CLEAN min", Sonar exp-34): the constants and the window cutter of the question-ranked context. Pure (no I/O),
+// shared by retrieve.ts (candidates, embeddings) and answer.ts (the context budget).
+export const CLEAN_MAX_ARTICLES = 8;
+export const CLEAN_BM25_ARTICLES = 4;
+export const CLEAN_NAMED_SHARE = 0.25;
+/** Below this cosine a window is clearly off topic (0, 0.5 and 0.6 gave the same gold hits on v0.1). */
+export const CLEAN_FLOOR = 0.5;
+/** The context budget in words (≈ 320 tokens): 240 held every gold hit that 340 did. */
+export const CLEAN_WORDS = 240;
+
+/** ~45-60-word windows of a passage on sentence boundaries. A pure function of the text, so a pack build can store
+ *  each window's vector (Forge: ≈ 0 ms on the phone instead of ~30 ms per window). */
+export function windowsOf(text: string): string[] {
+  const words = (s: string) => s.split(/\s+/).filter(Boolean).length;
+  const out: string[] = [];
+  let cur: string[] = [];
+  for (const s of text.replace(/\s+/g, " ").trim().split(/(?<=[.!?])\s+/)) {
+    cur.push(s);
+    if (words(cur.join(" ")) >= 45) {
+      out.push(cur.join(" "));
+      cur = [];
+    }
+  }
+  if (words(cur.join(" ")) >= 12) out.push(cur.join(" "));
+  return out;
+}
