+import { describe, expect, it } from "vitest";
+import { windowsOf } from "./clean";
+
+describe("rv2 windowsOf", () => {
+  const s = (n: number, w = "word") => `${Array.from({ length: n }, () => w).join(" ")}.`;
+  it("cuts on sentence boundaries once a window reaches 45 words", () => {
+    const text = [s(20), s(30), s(10), s(40)].join(" ");
+    const out = windowsOf(text);
+    expect(out).toEqual([[s(20), s(30)].join(" "), [s(10), s(40)].join(" ")]);
+  });
+  it("keeps a short tail of at least 12 words and drops a shorter one", () => {
+    expect(windowsOf([s(50), s(12)].join(" "))).toEqual([s(50), s(12)]);
+    expect(windowsOf([s(50), s(5)].join(" "))).toEqual([s(50)]);
+  });
+  it("is a pure function of the text (whitespace-normalized), so pack builds can store window vectors", () => {
+    const t = `${s(30)}\n\n  ${s(30)}`;
+    expect(windowsOf(t)).toEqual(windowsOf(t.replace(/\s+/g, " ")));
+  });
+});
