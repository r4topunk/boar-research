+
+const RV2 = Symbol("rv2");
+/** rv2 ("CLEAN min", Sonar exp-34): English Wikipedia packs give article candidates, every other source its retrieved
+ *  passages; all are cut into short windows (src/rag/clean.ts) and ranked by the question's embedding. */
+const ENWIKI_PACK = /(?:^|-)(?:boar-wiki-en-|wiki-vital)/;
+
+async function cleanWindows(query: string, queryVec: Float32Array, wiki: WikiPackResult[], retrieved: RetrievedChunk[]): Promise<RetrievedChunk[]> {
+  const enwiki = wiki.filter((w) => ENWIKI_PACK.test(w.packId));
+  const enwikiIds = new Set(enwiki.map((w) => `pack:${w.packId}:`));
+  const cands: RetrievedChunk[] = retrieved.filter((c) => ![...enwikiIds].some((p) => c.chunkId.startsWith(p)));
+  // Articles: the ones the question names (share >= 0.25), then the BM25 top articles, at most 8 across packs.
+  const picked: Array<{ w: WikiPackResult; id: number }> = [];
+  for (const w of enwiki) {
+    const named = (await w.pack.titlesInQuestion(query, w.stems)).filter((t) => t.share >= CLEAN_NAMED_SHARE).map((t) => t.id);
+    for (const id of named) if (!picked.some((p) => p.w === w && p.id === id)) picked.push({ w, id });
+  }
+  for (const w of enwiki) {
+    const bm = [...new Set((await w.pack.bm25Candidates(w.stems)).map((c) => c.articleId))].slice(0, CLEAN_BM25_ARTICLES);
+    for (const id of bm) if (!picked.some((p) => p.w === w && p.id === id)) picked.push({ w, id });
+  }
+  for (const { w, id } of picked.slice(0, CLEAN_MAX_ARTICLES)) {
+    // The article's lead chunk and its best chunk for the question's stems: both whole pack chunks.
+    for (const h of await w.pack.articlePassages(id, w.stems, 1)) {
+      const c = packHitToChunk(w.packId, h);
+      if (!isDisambiguation(c)) cands.push(c);
+    }
+  }
+  const seen = new Set<string>();
+  const wins: RetrievedChunk[] = [];
+  for (const c of cands)
+    windowsOf(c.body).forEach((body, i) => {
+      if (seen.has(body)) return;
+      seen.add(body);
+      wins.push({ ...c, chunkId: `${c.chunkId}#w${i}`, body });
+    });
+  const qn = Math.hypot(...queryVec) || 1;
+  for (const c of wins) {
+    const v = await embeddingEngine.embed(c.body);
+    let dot = 0;
+    for (let i = 0; i < v.length; i++) dot += v[i] * queryVec[i];
+    c.similarity = dot / (qn * (Math.hypot(...v) || 1));
+  }
+  return wins.filter((c) => (c.similarity ?? 0) >= CLEAN_FLOOR).sort((a, b) => (b.similarity ?? 0) - (a.similarity ?? 0));
 }
 
