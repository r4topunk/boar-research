+++ be-0cfd4a77-tf1/src/routing/travelFood.exp39.test.ts	2026-10-03 19:15:58
@@ -0,0 +1,42 @@
+import { describe, expect, it } from "vitest";
+import { travelDistanceAnswer } from "./travelDistance";
+import { detectGeoIntent, formatPlacesAnswer } from "./geo";
+
+describe("travel calculator phrasings (Sonar exp-39 probes)", () => {
+  it("driving distance → drive mode", () => {
+    const a = travelDistanceAnswer("What's the driving distance from Berlin to Munich?");
+    expect(a?.mode).toBe("drive");
+    expect(a?.text).toMatch(/Driving routes/);
+  });
+  it("flight distance → great circle, no road factor", () => {
+    const a = travelDistanceAnswer("flight distance from New York to London");
+    expect(a?.from).toBe("New York City");
+    expect(a?.text).toMatch(/as the crow flies/);
+    expect(a?.text).not.toMatch(/Roads and trails/);
+  });
+  it("'can I walk … in a week' gives a verdict against the days given", () => {
+    expect(travelDistanceAnswer("Can I walk from London to Edinburgh in a week?")?.text).toMatch(/^No, not at a normal pace: it takes about \d+ days/);
+    expect(travelDistanceAnswer("Can I walk from Amsterdam to Utrecht in three days?")?.text).toMatch(/^Yes, probably/);
+  });
+  it("far apart without a mode: no 'by land' route claim", () => {
+    expect(travelDistanceAnswer("distance from New York to London")?.text).not.toMatch(/by land/);
+  });
+});
+
+describe("places intent (Sonar exp-39 probes)", () => {
+  it("veggie → vegetarian, plant-based → vegan", () => {
+    expect(detectGeoIntent("veggie places near me")?.diet).toEqual(["vegetarian"]);
+    expect(detectGeoIntent("plant-based restaurants around here")?.diet).toEqual(["vegan"]);
+  });
+  it("a why-question about restaurants is not a list request", () => {
+    expect(detectGeoIntent("Why are there so many vegan restaurants in Berlin?")).toBeNull();
+  });
+  it("'Alfama, Lisbon' keeps the city as a fallback", () => {
+    expect(detectGeoIntent("Are there vegan restaurants in Alfama, Lisbon?")?.near).toEqual({ kind: "place", name: "Alfama", within: "Lisbon" });
+  });
+  it("'open now' is flagged and the answer says hours aren't known offline", () => {
+    const intent = detectGeoIntent("vegan restaurants open now near me")!;
+    expect(intent.openNow).toBe(true);
+    expect(formatPlacesAnswer({ intent, places: [], areaLabel: "near you", byDistance: true })).toMatch(/^I can't check opening hours offline/);
+  });
+});
