--- a/src/routing/expansion.ts	1969-12-31 21:00:00
+++ b/src/routing/expansion.ts	2026-10-01 03:28:31
@@ -0,0 +1,36 @@
+/**
+ * T2 (exp-07, local branch only): query expansion on a miss, after a competitor team (QueryExpansion.kt,
+ * ResearchOrchestrator.kt:72-113). When retrieval returns nothing or the relevance gate drops every source, one short
+ * model turn proposes search terms — synonyms, the vocabulary the answering document would use, and NAMES OF
+ * CANDIDATE ENTITIES ("tallest animal" -> species names) — terms absent from the index are discarded, and the search
+ * runs once more. Never on health, calculators, geo or the fixed routes (they return before retrieval).
+ */
+export const EXPANSION_MAX_TOKENS = 48;
+
+export const EXPANSION_SYSTEM =
+  "You help an offline encyclopedia search. Reply with ONE line only: 4 to 6 search terms separated by commas, " +
+  "for the user's question. Use synonyms, words the answering article would use, and the names of specific " +
+  "candidate entities (for 'tallest animal': giraffe; for 'largest country': Russia). No explanations, no numbering.";
+
+/** The terms from the model's line: first non-empty line, comma/semicolon separated, cleaned, deduplicated, at most 6. */
+export function parseExpansionTerms(text: string, query: string): string[] {
+  const line = (text ?? "").split("\n").map((l) => l.trim()).find((l) => l.length) ?? "";
+  const q = query.toLowerCase();
+  const out: string[] = [];
+  for (let t of line.replace(/^(search )?terms?\s*:\s*/i, "").split(/[,;]/)) {
+    t = t.replace(/^[\s"'`*\-\d.)]+|[\s"'`*.]+$/g, "").trim();
+    if (t.length < 2 || t.length > 40) continue;
+    const words = t.toLowerCase().split(/\s+/).filter((w) => w.length >= 3);
+    if (!words.length || words.every((w) => q.includes(w))) continue; // adds nothing to the question
+    if (!out.some((o) => o.toLowerCase() === t.toLowerCase())) out.push(t);
+    if (out.length === 6) break;
+  }
+  return out;
+}
+
+/** Whether a term occurs in a text (every word of 3+ letters, as a word prefix): the index's frequency is not 0. */
+export function termOccurs(term: string, text: string): boolean {
+  const hay = ` ${text.toLowerCase().replace(/[^a-z0-9À-ɏ]+/g, " ")} `;
+  const words = term.toLowerCase().replace(/[^a-z0-9À-ɏ]+/g, " ").split(" ").filter((w) => w.length >= 3);
+  return words.length > 0 && words.every((w) => hay.includes(` ${w}`));
+}
