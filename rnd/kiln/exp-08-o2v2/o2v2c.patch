+/**
+ * O2 v2 (exp-08, local branch): the two false refusals of the iPhone A/B (rnd/veil/o2-ab-labels).
+ * - "concept": a single-subject question is also covered by a multi-word concept title the question itself names
+ *   ("When did Ethereum switch … to proof of stake?" + "Proof-of-stake vs proof-of-work").
+ * - "one-side": a comparative with ONE side covered keeps (Brazil passages for "Indonesia or Brazil?").
+ * - "one-side-clean": the same, only when every passage is about the covered side; a passage about a third entity
+ *   (Fukuoka for "Japan vs Nigeria", Fin whale for "blue whale vs dinosaur") is the distractor O2 exists for.
+ * EXPO_PUBLIC_O2_V2 = "" (v1) | "a" (concept + one-side) | "c" (concept + one-side-clean).
+ */
+export function o2Variant(): "" | "a" | "c" {
+  const v = process.env.EXPO_PUBLIC_O2_V2 ?? "";
+  return v === "a" || v === "c" ? v : "";
+}
+
+const CONCEPT_STOP = new Set(["the", "a", "an", "of", "and", "or", "vs", "in", "on", "to", "for"]);
+/** A multi-word title segment the question names as written (normalized, plural-stemmed, contiguous). */
+function conceptTitleNamed(question: string, title: string): boolean {
+  const q = words(norm(question)).map(stem);
+  for (const seg of title.replace(PREFIX, "").split(/\s+(?:vs\.?|versus|and)\s+|[,;:()/]/i)) {
+    const t = words(norm(seg)).map(stem);
+    if (t.filter((w) => !CONCEPT_STOP.has(w)).length < 2) continue;
+    for (let i = 0; i + t.length <= q.length; i++) if (t.every((w, j) => q[i + j] === w)) return true;
+  }
+  return false;
+}
