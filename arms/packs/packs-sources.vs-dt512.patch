diff --git a/src/rag/wikiPack.attribution.test.ts b/src/rag/wikiPack.attribution.test.ts
new file mode 100644
index 00000000..6e0690ba
--- /dev/null
+++ b/src/rag/wikiPack.attribution.test.ts
@@ -0,0 +1,132 @@
+/// <reference types="node" />
+import { describe, it, expect, beforeAll, vi } from "vitest";
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { decompress } from "fzstd";
+
+vi.mock("expo-file-system/legacy", () => ({ documentDirectory: "file:///docs/" }));
+vi.mock("expo-sqlite", () => ({}));
+vi.mock("./embed", () => ({ embeddingEngine: {} }));
+
+import { nodeSqliteDatabase } from "./testing/nodeSqlite";
+import { SOURCES, WikiPack, type PackHit } from "./wikiPack";
+import { articleUrl, packHitToChunk } from "./packs";
+
+// New source families (T-K2) and per-row attribution, end to end: JSONL -> builder -> pack -> WikiPack -> citation.
+// Made-up, test-only documents and people.
+const filler = (topic: string) =>
+  Array.from({ length: 6 }, (_, i) => `${topic} filler sentence number ${i} about unrelated matters.`).join(" ");
+const SE_CREDIT = "Jane Example (https://outdoors.stackexchange.com/users/1/jane-example), https://outdoors.stackexchange.com/q/42";
+const rows = [
+  // First row has url/license only: article_meta starts with 3 columns and gains `attribution` later.
+  {
+    page_id: 11e9 + 1, title: "Freedonia", source: "factbook", url: "https://example.org/factbook/freedonia", license: "Public domain",
+    text: `# Freedonia\n\nFreedonia is a small landlocked country whose capital is Marxville. ${filler("Country")}`,
+  },
+  {
+    page_id: 9e9 + 42, title: "How do I purify stream water without boiling it?", source: "stackexchange",
+    url: "https://outdoors.stackexchange.com/q/42", license: "CC BY-SA 4.0", attribution: SE_CREDIT,
+    text: `# How do I purify stream water without boiling it?\n\nUse a ceramic filter, then chlorine dioxide tablets and wait thirty minutes. ${filler("Purify")}`,
+  },
+  {
+    page_id: 10e9 + 7, title: "Heat illness", source: "medlineplus", url: "https://medlineplus.gov/heatillness.html", license: "Public domain",
+    text: `# Heat illness\n\nHeat exhaustion causes heavy sweating; move to a cool place and sip water. ${filler("Heat")}`,
+  },
+  {
+    page_id: 12e9 + 5, title: "Glacier", source: "simplewiki",
+    text: `# Glacier\n\nA glacier is a large body of ice that moves slowly down a valley. ${filler("Ice")}`,
+  },
+];
+
+const build = (dir: string, name: string, docs: object[]) => {
+  const shard = join(dir, `${name}.jsonl`);
+  writeFileSync(shard, docs.map((r) => JSON.stringify(r)).join("\n") + "\n");
+  const out = join(dir, `${name}.sqlite`);
+  execFileSync(process.execPath, ["scripts/build-wiki-pack.mjs", "--out", out, "--shards", shard, "--no-embed"], { stdio: "pipe" });
+  return out;
+};
+const metaColumns = (path: string) =>
+  (new DatabaseSync(path, { readOnly: true }).prepare("PRAGMA table_info(article_meta)").all() as Array<{ name: string }>).map((c) => c.name);
+
+let withAttr: WikiPack, withoutAttr: WikiPack, pathWith: string, pathWithout: string;
+beforeAll(async () => {
+  const dir = mkdtempSync(join(tmpdir(), "boar-pack-attr-"));
+  pathWith = build(dir, "with", rows);
+  pathWithout = build(dir, "without", rows.map(({ attribution: _, ...r }: any) => r));
+  withAttr = await WikiPack.open(nodeSqliteDatabase(pathWith), decompress);
+  withoutAttr = await WikiPack.open(nodeSqliteDatabase(pathWithout), decompress);
+}, 60000);
+
+describe("new pack source codes", () => {
+  it("keeps the shipped ids and appends the new ones", () => {
+    expect(SOURCES.slice(0, 9)).toEqual(["enwiki", "enwikivoyage", "enwikibooks", "appropedia", "usgov", "eips", "ethspecs", "ethereumorg", "bips"]);
+    expect(SOURCES.slice(9)).toEqual(["stackexchange", "medlineplus", "factbook", "simplewiki"]);
+  });
+
+  it("builds title URLs for Simple English Wikipedia and keeps recorded URLs", () => {
+    expect(articleUrl("Glacier", "simplewiki")).toBe("https://simple.wikipedia.org/wiki/Glacier");
+    expect(articleUrl("Heat illness", "medlineplus", "https://medlineplus.gov/heatillness.html")).toBe("https://medlineplus.gov/heatillness.html");
+    expect(articleUrl("Freedonia", "factbook", "https://example.org/factbook/freedonia")).toBe("https://example.org/factbook/freedonia");
+    expect(articleUrl("Q", "stackexchange", "https://outdoors.stackexchange.com/q/42")).toBe("https://outdoors.stackexchange.com/q/42");
+  });
+
+  it("labels the new sources in citations", () => {
+    const base: PackHit = { articleId: 1, chunkId: 2, title: "T", section: "", text: "x", start: 0, end: 1, score: 1, via: "bm25", source: "enwiki", views: 0, lead: true, action: false };
+    const label = (source: PackHit["source"]) => packHitToChunk("p", { ...base, source, url: "https://e.org/t" }).source?.split(" — ")[0];
+    expect(label("stackexchange")).toBe("Stack Exchange");
+    expect(label("medlineplus")).toBe("MedlinePlus");
+    expect(label("factbook")).toBe("CIA World Factbook (archive)");
+    expect(label("simplewiki")).toBe("Simple English Wikipedia");
+  });
+
+  it("round-trips the source codes and counts entity-named sources (not Stack Exchange) as names", async () => {
+    const sources = await Promise.all([1, 2, 3, 4].map(async (id) => (await withAttr.article(id)).source));
+    expect(sources).toEqual(["factbook", "stackexchange", "medlineplus", "simplewiki"]);
+    expect([...(withAttr as any).topicSources].sort()).toEqual(["factbook", "medlineplus", "simplewiki"]);
+  });
+});
+
+describe("per-row attribution", () => {
+  const hit: PackHit = {
+    articleId: 1, chunkId: 2, title: "Burn", section: "Management", text: "Cool the burn.", start: 0, end: 14, score: 1,
+    via: "title", source: "appropedia", views: 0, lead: false, action: true, url: "https://www.appropedia.org/Burn", license: "CC BY-SA 4.0",
+  };
+
+  it("leaves the citation byte-identical without attribution", () => {
+    expect(packHitToChunk("prep", hit).source).toBe("Appropedia — https://www.appropedia.org/Burn (CC BY-SA 4.0)");
+    expect(packHitToChunk("prep", { ...hit, license: undefined, url: undefined, source: "enwiki" }).source).toBe("Wikipedia — https://en.wikipedia.org/wiki/Burn");
+  });
+
+  it("appends the credit after URL and license", () => {
+    expect(packHitToChunk("prep", { ...hit, attribution: "A. Author" }).source).toBe(
+      "Appropedia — https://www.appropedia.org/Burn (CC BY-SA 4.0) — A. Author"
+    );
+  });
+
+  it("adds the attribution column only when a row has one", () => {
+    expect(metaColumns(pathWith)).toEqual(["article_id", "url", "license", "attribution"]);
+    expect(metaColumns(pathWithout)).toEqual(["article_id", "url", "license"]);
+  });
+
+  it("carries the attribution from the pack to the hit and the citation", async () => {
+    const hits = await withAttr.search("How do I purify stream water without boiling it?");
+    const se = hits.find((h) => h.source === "stackexchange");
+    expect(se?.attribution).toBe(SE_CREDIT);
+    expect(packHitToChunk("p", se!).source).toBe(
+      `Stack Exchange — https://outdoors.stackexchange.com/q/42 (CC BY-SA 4.0) — ${SE_CREDIT}`
+    );
+    // Rows without a credit in the same pack carry none.
+    expect((await withAttr.article(1)).attribution).toBeUndefined();
+  });
+
+  it("reads a pack without the column (no attribution, same hits otherwise)", async () => {
+    const q = "How do I purify stream water without boiling it?";
+    const a = await withAttr.search(q);
+    const b = await withoutAttr.search(q);
+    expect(b.every((h) => h.attribution === undefined)).toBe(true);
+    expect(b).toEqual(a.map(({ attribution: _, ...h }) => h));
+  });
+});
