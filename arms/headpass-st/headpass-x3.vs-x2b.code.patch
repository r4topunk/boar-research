+import { describe, it, expect, vi, afterEach } from "vitest";
+
+vi.mock("./db", () => ({ getDb: async () => ({ getAllAsync: async () => [] }) }));
+vi.mock("./embed", () => ({ embeddingEngine: { embed: async () => new Float32Array([1, 0, 0, 0]) } }));
+vi.mock("./ptLexiconAsset", () => ({ ptLexicon: () => ({}) }));
+vi.mock("expo-file-system/legacy", () => ({ documentDirectory: "file:///docs/" }));
+vi.mock("expo-sqlite", () => ({}));
+
+const { hit, state } = vi.hoisted(() => ({
+  hit: (chunkId: number, title: string, score: number) => ({
+    articleId: chunkId, chunkId, title, section: "", text: `${title} text.`, start: 0, end: 10, score, via: "bm25", source: "simplewiki", views: 0, lead: false, action: false,
+  }),
+  state: { packId: "local-qa-travel-se", calls: [] as number[] },
+}));
+// One large pack with 30 keyword hits; k decides how many come back.
+vi.mock("./packs", async (importOriginal) => {
+  const actual: any = await importOriginal();
+  return {
+    packHitToChunk: actual.packHitToChunk,
+    searchPacks: async () => ({ lexical: [], semantic: [] }),
+    searchWikiPacks: async (_q: string, o: any) => {
+      state.calls.push(o.k);
+      return [{ packId: state.packId, pack: { hasChunkVecs: false }, hits: Array.from({ length: 30 }, (_, i) => hit(i + 1, `Lex ${i + 1}`, 100 - i)) }];
+    },
+  };
+});
+
+import { retrieve } from "./retrieve";
+import { rerankInfoOf, setRerankScorer } from "./rerank";
+
+const ids = (cs: { chunkId: string }[]) => cs.map((c) => c.chunkId);
+afterEach(() => { setRerankScorer(null); state.packId = "local-qa-travel-se"; state.calls = []; });
+
+describe("packRerank m2 (HEADPASS-X3)", () => {
+  it("no scorer: the setting-absent list, reason noscore", async () => {
+    const off = await retrieve("lex question", 6);
+    const m2 = await retrieve("lex question", 6, { packRerank: "m2" });
+    expect(JSON.stringify(m2)).toBe(JSON.stringify(off));
+    expect(rerankInfoOf(m2)).toEqual({ fired: false, reason: "noscore", pool: 20 });
+    expect(rerankInfoOf(off)).toBeUndefined();
+  });
+
+  it("fires: the fused top-20 reranked, the best k returned", async () => {
+    let n = 0;
+    // Reverse order: the 20th passage is the best.
+    setRerankScorer(async (_q, docs) => ((n = docs.length), docs.map((_, i) => i)));
+    const m2 = await retrieve("lex question", 6, { packRerank: "m2" });
+    expect(n).toBe(20);
+    expect(m2).toHaveLength(6);
+    expect(ids(m2)).toEqual([20, 19, 18, 17, 16, 15].map((i) => `pack:local-qa-travel-se:${i}`));
+    expect(rerankInfoOf(m2)).toEqual({ fired: true, pool: 20 });
+  });
+
+  it("kit-only pool: never scored, the setting-absent list (reason kit-only)", async () => {
+    state.packId = "local-boar-crypto";
+    let called = false;
+    setRerankScorer(async (_q, docs) => ((called = true), docs.map(() => 1)));
+    const off = await retrieve("lex question", 6);
+    const m2 = await retrieve("lex question", 6, { packRerank: "m2" });
+    expect(called).toBe(false);
+    expect(JSON.stringify(m2)).toBe(JSON.stringify(off));
+    expect(rerankInfoOf(m2)?.reason).toBe("kit-only");
+  });
+});
