+import { describe, it, expect, afterEach } from "vitest";
+import { rankByRerank, rerankText, setRerankScorer, unionByChunkId, hasUserPackChunk, RERANK_DOC_CHARS } from "./rerank";
+
+const c = (chunkId: string, title = "T", body = "b") => ({ chunkId, title, body });
+
+afterEach(() => setRerankScorer(null));
+
+describe("HEADPASS-X3 rerank helpers", () => {
+  it("no scorer, empty list, failing or short scorer: null (the caller takes the setting-absent path)", async () => {
+    expect(await rankByRerank("q", [c("a")])).toBeNull();
+    setRerankScorer(async () => [1]);
+    expect(await rankByRerank("q", [])).toBeNull();
+    setRerankScorer(async () => { throw new Error("down"); });
+    expect(await rankByRerank("q", [c("a")])).toBeNull();
+    setRerankScorer(async () => [1]);
+    expect(await rankByRerank("q", [c("a"), c("b")])).toBeNull();
+    setRerankScorer(async () => [null, null]);
+    expect(await rankByRerank("q", [c("a"), c("b")])).toBeNull();
+  });
+
+  it("orders by score desc, ties keep the given order, unscored chunks are left out", async () => {
+    setRerankScorer(async () => [0.1, 0.9, null, 0.9, 0.5]);
+    const r = await rankByRerank("q", [c("a"), c("b"), c("c"), c("d"), c("e")]);
+    expect(r!.map((x) => x.chunkId)).toEqual(["b", "d", "e", "a"]);
+  });
+
+  it("the scorer sees the query and each passage as title + newline + body, cut to RERANK_DOC_CHARS", async () => {
+    let seen: any = null;
+    setRerankScorer(async (q, docs) => ((seen = { q, docs }), docs.map(() => 1)));
+    await rankByRerank("what to do", [c("x", "Burns", "Treatment: cool water"), c("y", "Long", "z".repeat(5000))]);
+    expect(seen.q).toBe("what to do");
+    expect(seen.docs[0]).toEqual({ chunkId: "x", text: "Burns\nTreatment: cool water" });
+    expect(seen.docs[1].text.length).toBe(RERANK_DOC_CHARS);
+    expect(rerankText({ title: "A", body: "B" })).toBe("A\nB");
+  });
+
+  it("union keeps the first occurrence, in list order", () => {
+    expect(unionByChunkId([c("a"), c("b")], [c("b"), c("c")], [c("a"), c("d")]).map((x) => x.chunkId)).toEqual(["a", "b", "c", "d"]);
+  });
+
+  it("kit packs and the seed corpus never count as a user pack", () => {
+    expect(hasUserPackChunk([c("pack:local-boar-crypto:1"), c("pack:boar-wikivoyage-en:2"), c("seed-1")])).toBe(false);
+    expect(hasUserPackChunk([c("pack:local-boar-crypto:1"), c("pack:local-qa-travel-se:7")])).toBe(true);
+  });
+});
diff --git a/src/rag/rerank.ts b/src/rag/rerank.ts
new file mode 100644
index 0000000..9cfad32
--- /dev/null
+++ b/src/rag/rerank.ts
@@ -0,0 +1,87 @@
+import type { RetrievedChunk } from "./retrieve.types";
+
+/**
+ * HEADPASS-X3 (settings.packRerank, experimental, default off): a cross-encoder reranker (bge-reranker-v2-m3) scores
+ * passages against the engine's search query. The scorer is pluggable: the product path registers one that calls the
+ * reranker server; the step-0 replay registers one that returns precomputed scores. No scorer registered (or a failing
+ * one) -> every caller takes the setting-absent path.
+ */
+export type RerankScorer = (query: string, docs: { chunkId: string; text: string }[]) => Promise<(number | null)[] | null>;
+
+let scorer: RerankScorer | null = null;
+
+/** Registers (or, with null, removes) the reranker scorer. */
+export function setRerankScorer(fn: RerankScorer | null): void {
+  scorer = fn;
+}
+
+export function rerankScorer(): RerankScorer | null {
+  return scorer;
+}
+
+/** HEADPASS-X3: reranked chunks appended per answer (D). */
+export const RERANK_D = 2;
+/** HEADPASS-X3: BM25 chunks of the top user pack in the candidate union. */
+export const RERANK_BM25_POOL = 80;
+/** HEADPASS-X3 M2: fused list size reranked before the keep step. */
+export const RERANK_M2_POOL = 20;
+/** Characters of a passage sent to the reranker. */
+export const RERANK_DOC_CHARS = 2000;
+
+/** A passage as the engine renders it ("title\nsection: text"), cut to RERANK_DOC_CHARS. */
+export function rerankText(c: { title: string; body: string }): string {
+  return `${c.title}\n${c.body}`.slice(0, RERANK_DOC_CHARS);
+}
+
+/**
+ * `cands` ordered by the reranker's score (desc; ties and unscored chunks keep their given order, unscored ones last are
+ * dropped). Null when no scorer is registered, the scorer fails or returns no score at all.
+ */
+export async function rankByRerank<T extends { chunkId: string; title: string; body: string }>(query: string, cands: T[]): Promise<T[] | null> {
+  if (!scorer || !cands.length) return null;
+  let scores: (number | null)[] | null;
+  try {
+    scores = await scorer(query, cands.map((c) => ({ chunkId: c.chunkId, text: rerankText(c) })));
+  } catch {
+    return null;
+  }
+  if (!scores || scores.length !== cands.length) return null;
+  const scored = cands
+    .map((c, i) => ({ c, i, s: scores![i] }))
+    .filter((x): x is { c: T; i: number; s: number } => typeof x.s === "number" && Number.isFinite(x.s));
+  if (!scored.length) return null;
+  return scored.sort((a, b) => b.s - a.s || a.i - b.i).map((x) => x.c);
+}
+
+/** Union of candidate lists, first occurrence wins (order: lists in the given order). */
+export function unionByChunkId<T extends { chunkId: string }>(...lists: T[][]): T[] {
+  const seen = new Set<string>();
+  const out: T[] = [];
+  for (const l of lists) for (const c of l) if (!seen.has(c.chunkId)) (seen.add(c.chunkId), out.push(c));
+  return out;
+}
+
+/** M2 info attached beside the list retrieve() returns (the list itself stays the plain array). */
+export interface RerankInfo {
+  fired: boolean;
+  /** Why it did not fire: "kit-only" (no user-installed pack chunk in the pool), "noscore" (no scorer / failed). */
+  reason?: "kit-only" | "noscore";
+  pool: number;
+}
+const info = new WeakMap<RetrievedChunk[], RerankInfo>();
+export function attachRerankInfo(list: RetrievedChunk[], i: RerankInfo): RetrievedChunk[] {
+  info.set(list, i);
+  return list;
+}
+export function rerankInfoOf(list: RetrievedChunk[]): RerankInfo | undefined {
+  return info.get(list);
+}
+
+/** HEADPASS kit packs (shipped with the app): a list with no chunk from another pack never fires M2. */
+const KIT = new Set(["boar-crypto", "boar-wikivoyage-en"]);
+export function hasUserPackChunk(list: { chunkId: string }[]): boolean {
+  return list.some((c) => {
+    const m = /^pack:([^:]+):/.exec(c.chunkId);
+    return !!m && !KIT.has(m[1].replace(/^local-/, ""));
+  });
+}
