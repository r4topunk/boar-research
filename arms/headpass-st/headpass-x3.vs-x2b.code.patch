+/**
+ * HEADPASS-X3 (settings.packRerank "x3a"/"x3b", default off): the reranker's candidate union for the first passage of `raw`
+ * from a user-installed (non-kit) format-2 pack: that pack's BM25 top-`pool` chunks for `query` (no per-article cap), then
+ * `dense` (the ST2 dense candidates retrieve() attached), then every chunk of that passage's article (by start); first
+ * occurrence wins. When `raw` has no such passage, the installed user-pack(s) (non-kit format-2; with one installed, that
+ * pack) give their BM25 top-`pool` chunks and `dense`, with no top article. Null when no user pack is installed.
+ */
+export async function packRerankCandidates(
+  raw: RetrievedChunk[],
+  query: string,
+  dense: RetrievedChunk[] = [],
+  pool = 80
+): Promise<{ packId: string; chunks: RetrievedChunk[] } | null> {
+  for (const c of raw) {
+    const m = /^pack:([^:]+):(\d+)$/.exec(c.chunkId);
+    if (!m) continue;
+    const packId = m[1];
+    if (HEADPASS_KIT.has(packId.replace(/^local-/, ""))) continue;
+    const wp = wikiPacks.get(packId);
+    if (!wp) continue;
+    const stems = await wp.stems(query);
+    const bm = stems.length ? (await wp.bm25(stems, pool, wp.tuning.prior, pool)).map((h) => packHitToChunk(packId, h)) : [];
+    const art = (await wp.headChunksOf(Number(m[2]), 0, Number.MAX_SAFE_INTEGER - 1)).map((h) => packHitToChunk(packId, h));
+    const seen = new Set<string>();
+    const chunks = [...bm, ...dense, ...art].filter((x) => !seen.has(x.chunkId) && (seen.add(x.chunkId), true));
+    return { packId, chunks };
+  }
+  const users = [...wikiPacks.entries()].filter(([id]) => !HEADPASS_KIT.has(id.replace(/^local-/, "")));
+  if (!users.length) return null;
+  const all: RetrievedChunk[] = [];
+  for (const [packId, wp] of users) {
+    const stems = await wp.stems(query);
+    if (stems.length) all.push(...(await wp.bm25(stems, pool, wp.tuning.prior, pool)).map((h) => packHitToChunk(packId, h)));
+  }
+  const seen = new Set<string>();
+  return { packId: users[0][0], chunks: [...all, ...dense].filter((x) => !seen.has(x.chunkId) && (seen.add(x.chunkId), true)) };
+}
+
 type PackRow = { id: number; title: string; body: string; vec: Uint8Array; rank: number };
 
 /** Lexical and semantic candidates from every installed pack, scored like the built-in ones. */
