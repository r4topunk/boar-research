+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import type { RetrievedChunk } from "../rag/retrieve.types";
+import { assemblePrompt, assembleChatMessages } from "../rag/pure";
+import { attachDenseCandidates } from "../rag/denseCandidates";
+import { setRerankScorer } from "../rag/rerank";
+import type { AnswerSettings } from "../models/settings";
+import type { AnswerEvent } from "./events";
+
+// HEADPASS-X3: X1 neighbours (packHeadPass) and the candidate union (packRerankCandidates) come from packs (mocked).
+const { X1A, X1B, U, st } = vi.hoisted(() => {
+  const mk = (chunkId: string, title: string, body: string) => ({ chunkId, docId: chunkId, title, body, score: 1, matchType: "lexical" as const });
+  return {
+    X1A: mk("pack:u:101", "Canberra", "Canberra has a population of about 470,000 people. It hosts Parliament House and the High Court."),
+    X1B: mk("pack:u:102", "Canberra", "Lake Burley Griffin lies at the centre of Canberra and was filled in 1964."),
+    U: [
+      mk("pack:u:300", "Canberra", "Canberra's climate is oceanic with cold winters."),
+      mk("pack:u:301", "Canberra", "The Australian War Memorial is in Canberra."),
+      mk("pack:u:302", "Canberra", "Canberra was named in 1913."),
+    ],
+    st: { cands: null as null | ((raw: any[], q: string, dense: any[]) => any), candArgs: [] as any[] },
+  };
+});
+vi.mock("../rag/packs", () => ({
+  packHeadPass: async (raw: RetrievedChunk[]) => (raw.length ? { first: raw[0], chunks: [X1A, X1B] } : null),
+  packRerankCandidates: async (raw: RetrievedChunk[], q: string, dense: RetrievedChunk[], pool: number) => {
+    st.candArgs.push({ q, dense: dense.map((c) => c.chunkId), pool });
+    return st.cands ? st.cands(raw, q, dense) : { packId: "u", chunks: [...U, ...dense] };
+  },
+}));
+
+import { createAnswerer, type AnswerDeps, type InstalledLlm } from "./answer";
+
+const chunk = (chunkId: string, title: string, body: string, similarity?: number): RetrievedChunk => ({
+  chunkId, docId: chunkId, title, body, score: 1, matchType: "hybrid", ...(similarity !== undefined ? { similarity } : {}),
+});
+const CANBERRA = chunk("pack:u:100", "Canberra", "Canberra is the capital city of Australia. Founded following the federation of the colonies of Australia as the seat of government for the new nation, it is Australia's largest inland city.");
+const MOLD = chunk("c2", "Mold", "A mold or mould is one of the structures that certain fungi can form. Mold growth needs moisture.");
+const D1 = chunk("pack:u:200", "Australian Capital Territory", "The Australian Capital Territory was created in 1911 to hold the national capital.", 0.71);
+
+const GB = 1024 ** 3;
+const llm: InstalledLlm = { id: "q", label: "Q", filename: "models/q.gguf", sizeBytes: GB, roles: ["fast"], isDefault: true };
+
+let settings: AnswerSettings;
+let retrieveOpts: unknown[];
+let mkRaw: () => RetrievedChunk[];
+function deps(): AnswerDeps {
+  return {
+    facts: false,
+    now: (() => { let t = 0; return () => (t += 5); })(),
+    engine: {
+      async load() { return { fit: null, warning: null }; },
+      async generate(o) { o.onToken?.("Canberra [1]."); return "Canberra [1]."; },
+      async stop() {},
+      getModelInfo: () => ({ filename: llm.filename }),
+      hasEmbeddedChatTemplate: () => true,
+      async estimateFit() { return { verdict: "resident" } as any; },
+    },
+    retrieve: async (_q, _k, o) => (retrieveOpts.push(o), mkRaw()),
+    getSettings: async () => settings,
+    listInstalledLlms: async () => [llm],
+    getActiveModelId: async () => llm.id,
+    runMultipass: async () => { throw new Error("no multipass here"); },
+    assemblePrompt,
+    assembleChatMessages,
+  } as AnswerDeps;
+}
+async function run(query: string) {
+  const events: AnswerEvent[] = [];
+  const result = await createAnswerer(deps()).answer({ query }, (e) => events.push(e), { maxTokens: 256 }).done;
+  const src = events.find((e) => e.type === "sources") as any;
+  return { codes: result.receipt.reasonCodes as string[], sources: (src?.sources ?? []).map((s: RetrievedChunk) => s.chunkId) as string[], text: result.text, events };
+}
+const Q = "Tell me about the city of Canberra in Australia";
+/** Scores by chunkId (unlisted: 0). */
+const scoreBy = (m: Record<string, number>) => setRerankScorer(async (_q, docs) => docs.map((d) => m[d.chunkId] ?? 0));
