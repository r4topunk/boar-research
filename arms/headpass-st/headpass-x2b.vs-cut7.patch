+  it("stage 2 only scores the stage-1 articles and applies the cosine floor", async () => {
+    const top1 = await dense.denseChunks(q(), 1, 12, 0.5);
+    expect(top1.map((h) => h.chunkId)).toEqual([chunkOf("Gamma", 1)]);
+    expect(top1[0].via).toBe("semantic");
+    expect(top1[0].title).toBe("Gamma");
+    expect(top1[0].score).toBeCloseTo(0.75 / Math.hypot(0.6, 0.75, 0.2), 4);
+    // With the floor at 0, every Gamma chunk comes back (cos 0 for the others), still Gamma only.
+    const all = await dense.denseChunks(q(), 1, 12, 0);
+    expect(new Set(all.map((h) => h.title))).toEqual(new Set(["Gamma"]));
