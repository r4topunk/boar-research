+/** HEADPASS-ST: kit packs (shipped with the app) never get a head pass; only user-installed format-2 packs do. */
+const HEADPASS_KIT = new Set(["boar-crypto", "boar-wikivoyage-en"]);
+/** HEADPASS-ST (settings.packHeadPass "a2", default off): the first passage of `raw` from a user-installed (non-kit) format-2
+ *  pack, and its article's chunks at positions 1-2 (by start) in the shape of retrieved pack passages; null when none. */
+export async function packHeadPass(raw: RetrievedChunk[]): Promise<{ first: RetrievedChunk; chunks: RetrievedChunk[] } | null> {
+  for (const c of raw) {
+    const m = /^pack:([^:]+):(\d+)$/.exec(c.chunkId);
+    if (!m) continue;
+    const packId = m[1];
+    if (HEADPASS_KIT.has(packId.replace(/^local-/, ""))) continue;
+    const wp = wikiPacks.get(packId);
+    if (!wp) continue;
+    const hits = await wp.headChunksOf(Number(m[2]), 1, 2);
+    return { first: c, chunks: hits.map((h) => packHitToChunk(packId, h)) };
+  }
+  return null;
+}
