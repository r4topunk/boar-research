+vi.mock("expo-sqlite", () => ({}));
+
+const { hit, state } = vi.hoisted(() => ({
+  hit: (chunkId: number, title: string, score: number, via: string) => ({
+    articleId: chunkId, chunkId, title, section: "", text: `${title} text.`, start: 0, end: 10, score, via, source: "simplewiki", views: 0, lead: false, action: false,
+  }),
+  state: { sidecar: true },
+}));
+// One large pack: 8 keyword hits; with dense2 (and a sidecar) also a semantic list (chunk 3 is already a keyword hit).
+vi.mock("./packs", async (importOriginal) => {
+  const actual: any = await importOriginal();
+  return {
+    packHitToChunk: actual.packHitToChunk,
+    searchPacks: async () => ({ lexical: [], semantic: [] }),
+    searchWikiPacks: async (_q: string, o: any) => [
+      {
+        packId: "p",
+        pack: { hasChunkVecs: state.sidecar },
+        hits: [1, 2, 3, 4, 5, 6, 7, 8].map((i) => hit(i, `Lex ${i}`, 10 - i, "bm25")),
+        ...(o.dense2 && state.sidecar
+          ? { semantic: [hit(3, "Lex 3", 0.9, "semantic"), hit(20, "Dense A", 0.7, "semantic"), hit(21, "Dense B", 0.8, "semantic"), hit(22, "Dense C", 0.6, "semantic")] }
+          : {}),
+      },
+    ],
+  };
+});
+
+import { retrieve } from "./retrieve";
+import { denseCandidatesOf } from "./denseCandidates";
+
+const ids = (cs: { chunkId: string }[]) => cs.map((c) => c.chunkId);
+
+describe("packDense2 append (HEADPASS-X2)", () => {
+  it("the returned list is the off list; the ranked new dense hits are attached beside it", async () => {
+    state.sidecar = true;
+    const off = await retrieve("lex question", 6);
+    const app = await retrieve("lex question", 6, { packDense2: "append" });
+    expect(JSON.stringify(app)).toBe(JSON.stringify(off));
+    expect(denseCandidatesOf(off)).toBeUndefined();
+    const d = denseCandidatesOf(app)!;
+    expect(d.sidecar).toBe(true);
+    // chunk 3 is in the list; then similarity order, all of them (the answerer takes D).
+    expect(ids(d.candidates)).toEqual(["pack:p:21", "pack:p:20", "pack:p:22"]);
+    expect(d.candidates[0].similarity).toBe(0.8);
+  });
+
+  it("no sidecar in any pack: same list, no candidates, sidecar false", async () => {
+    state.sidecar = false;
+    const off = await retrieve("lex question", 6);
+    const app = await retrieve("lex question", 6, { packDense2: "append" });
+    expect(JSON.stringify(app)).toBe(JSON.stringify(off));
+    expect(denseCandidatesOf(app)).toEqual({ candidates: [], sidecar: false });
+    state.sidecar = true;
+  });
+
+  it("extra (ST2) still appends to the raw list and attaches nothing", async () => {
+    const extra = await retrieve("lex question", 6, { packDense2: "extra" });
+    expect(ids(extra.slice(6))).toEqual(["pack:p:21", "pack:p:20"]);
+    expect(denseCandidatesOf(extra)).toBeUndefined();
+  });
+});
